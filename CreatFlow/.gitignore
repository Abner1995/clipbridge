# ==================================================
# runtime/ — track scripts, ignore binaries
# ==================================================
!runtime/node/.gitkeep
# bridges/kuaishou/ — keep webpack chunks for signing
!runtime/bridges/kuaishou/
# ffmpeg/ — 只保留 README.md，exe 由 scripts/download_ffmpeg.ps1 获取（115MB 超 gitee 单文件限制）
runtime/ffmpeg/*.exe
# kokoro/ — 只保留 README.md，模型由 scripts/download_kokoro.ps1 获取（147MB 超 gitee 单文件限制）
runtime/kokoro/*
!runtime/kokoro/README.md
# llm/ — 只保留 README.md；引擎（llama-server.exe + dll）与模型 gguf 由 scripts/download_llama.ps1 获取
runtime/llm/*
!runtime/llm/README.md

