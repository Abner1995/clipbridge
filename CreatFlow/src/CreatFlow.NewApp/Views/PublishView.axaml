<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             xmlns:models="using:CreatFlow.NewApp.Models"
             xmlns:svc="using:CreatFlow.NewApp.Services"
             xmlns:conv="using:CreatFlow.NewApp.Converters"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="1216" d:DesignHeight="860"
             x:Class="CreatFlow.NewApp.Views.PublishView"
             x:DataType="vm:PublishViewModel">

    <!-- 发布页 —— 整页三视图（工作台 ⇄ 条目编辑器 ⇄ 发布预设），互斥根节点。
         视觉基线沿用样机（PublishMockView，已评审）：白卡浮于白底、深度由描边 + 双层投影给、
         状态零 emoji 走色点。自绘勾选盒/单选圈/折叠箭头（Semi 主题原色非品牌紫；且凡自定义内容的
         ToggleButton 都必须显式给 Template，否则 :checked 会被 Semi 画出勾选框顶掉内容）。 -->

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />

        <ControlTemplate x:Key="RowTemplate" TargetType="ToggleButton">
            <!-- BorderBrush/BorderThickness 走模板绑定：chip 在灰底分组块里靠 1px 描边才有形状
                 （纯 #F7F8FA 填充在 #F8F9FB 分组底上完全看不见，2026-11-10 用户截图实测） -->
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <ContentPresenter Name="RowContent"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="IconToggleTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter Name="IconContent"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="PlainButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter Name="PlainButtonContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <!-- 折叠段头（文字 + 箭头）：给「开发者选项」这类弱化折叠区用。
             ⚠️ 自定义内容的 ToggleButton 必须显式给 Template，否则 Semi 默认模板会在
             :checked（已展开）时画出一个蓝色勾选框把箭头/文字顶掉。 -->
        <ControlTemplate x:Key="SectionToggleTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" />
                    <Viewbox Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                             VerticalAlignment="Center">
                        <Path Classes="chev-icon"
                              Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                              Fill="{StaticResource TextMuted}" Stretch="Uniform" />
                    </Viewbox>
                </Grid>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ─── 按钮速记 ─── -->
        <Style Selector="Button.cta">
            <Setter Property="Theme" Value="{StaticResource CtaButtonTheme}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.sec">
            <Setter Property="Theme" Value="{StaticResource SecondaryButtonTheme}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Theme" Value="{StaticResource DangerButtonTheme}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.ghost:pressed">
            <Setter Property="Background" Value="#E5E6EB" />
        </Style>

        <!-- 正方形图标按钮（排序页的上下移）。禁用态必须压 Opacity：
             图标是模板里的 Path、Fill 写死，改 Foreground 不会让它变灰 -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
        </Style>
        <Style Selector="Button.icon-btn:pressed">
            <Setter Property="Background" Value="#E5E6EB" />
        </Style>
        <Style Selector="Button.icon-btn:disabled">
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="Button.chip-retry">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chip-retry:pointerover">
            <Setter Property="Background" Value="#ECE7FD" />
        </Style>
        <Style Selector="Button.chip-retry:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- ─── 文字 ─── -->
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.sec-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.issue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ─── 状态胶囊 ─── -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.pill-text">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ─── 卡片 ─── -->
        <Style Selector="Border.mock-card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EDEFF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #0D000000, 0 4 12 0 #08000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.mock-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BrandSoftBorder}" />
            <Setter Property="BoxShadow" Value="0 2 6 0 #14000000, 0 10 24 0 #10000000" />
        </Style>

        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,16" />
        </Style>

        <Style Selector="Border.thumb">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pf-badge">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.resolve-row">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- ─── 自绘勾选盒 ─── -->
        <Style Selector="ToggleButton.check-row">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <!-- Semi 的 ToggleButton 默认按内容宽度居中摆放（截图实测：勾选行缩在行中间），
                 钉成 Stretch 才会左对齐、整行可点、悬停底色铺满 -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- RowTemplate 现在绑 BorderThickness（chip 要用），勾选行钉 0 保持无边框 -->
            <Setter Property="BorderThickness" Value="0" />
            <!-- ⚠️ Foreground 必须显式钉住：Semi 的 ToggleButton 在 :checked 下把前景刷成白色
                 （为「填色胶囊」设计），而本模板是透明底的勾选盒 —— 不钉住的话
                 勾选行的**文字会变成白色**、在白卡上直接看不见（实测踩坑）。 -->
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.check-row:checked">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.check-row:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.check-row:pointerover">
            <Setter Property="Background" Value="#F7F8FA" />
        </Style>
        <Style Selector="Border.tick">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.check-row:not(:checked) Border.tick">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
        </Style>
        <Style Selector="ToggleButton.check-row:checked Border.tick">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
        </Style>
        <Style Selector="ToggleButton.check-row:not(:checked) Path.tick-check">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ─── 自绘单选圈 ─── -->
        <Style Selector="ToggleButton.radio-row">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 同 check-row：不钉 Stretch 会按内容宽度居中 -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 同 check-row：不钉住 Foreground，选中项的文字会被 Semi 刷成白色而看不见 -->
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.radio-row:checked">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.radio-row:pointerover">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Border.radio">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.radio-row:not(:checked) Border.radio">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
        </Style>
        <Style Selector="ToggleButton.radio-row:checked Border.radio">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
        </Style>
        <Style Selector="ToggleButton.radio-row:not(:checked) Border.radio-core">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ─── 全局目标芯片 ─── -->
        <Style Selector="ToggleButton.chip">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- 未选中用白底 + 1px 描边：这些 chip 现在多放在浅灰分组块（#F8F9FB）里，
             原来的 #F7F8FA 填充和底色几乎同色，等于只有文字没有形状（2026-11-10 截图实测） -->
        <Style Selector="ToggleButton.chip:not(:checked)">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E6EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.chip:checked">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandSoftBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked):pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
        </Style>
        <Style Selector="ToggleButton.chip:checked:pointerover">
            <Setter Property="Background" Value="#ECE7FD" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandSoftBorder}" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="ToggleButton.chip:checked TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) Path.chip-check">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) Border.chip-dot">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- ─── 分组组条（2026-10-14：点一格 = 只勾选该组账号；与 ComposeView 同款，改一处同步另一处） ─── -->
        <Style Selector="Button.group-chip">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.group-chip:pointerover">
            <Setter Property="Background" Value="#EFF1F4" />
        </Style>
        <Style Selector="Button.group-chip.active">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
        </Style>
        <Style Selector="Button.group-chip.active:pointerover">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
        </Style>
        <Style Selector="Button.group-chip:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- ─── 展开箭头（自绘模板，否则 :checked 会被 Semi 画出勾选框） ─── -->
        <Style Selector="ToggleButton.chev">
            <Setter Property="Template" Value="{StaticResource IconToggleTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.chev:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
        </Style>
        <Style Selector="ToggleButton.chev Path.chev-icon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>
        <Style Selector="ToggleButton.chev:checked Path.chev-icon">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="180" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── 编辑器右栏平台卡 ─── -->
        <Style Selector="Border.target-card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EDEFF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.field-row">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- ─── 右栏平台卡：字段排版三件套（2026-11-10 UI 优化） ───
             340px 窄栏里原来的「标签在上、输入在下」会排出几十行、且所有字段同一视觉重量；
             改为「左标签 72px + 右控件」两列（field-line），并用浅色分组块（opt-group）给
             长尾字段建立层级。六个平台卡共用这三个类 —— 改一处六块一起变，
             别给单个平台另写一套。
             ⚠️ Grid.ColumnDefinitions 是直接属性、不是 AvaloniaProperty，**样式里设不了**
             （AVLN3000），每个字段行的 `ColumnDefinitions="72,*" ColumnSpacing="8"` 必须写在元素上。 -->
        <Style Selector="Grid.field-line > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style Selector="Border.opt-group">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="BorderBrush" Value="#F0F1F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="TextBlock.group-cap">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- 分组之间的细分隔线（比整块灰底轻，用于同一张卡内的二级分隔） -->
        <Style Selector="Border.hairline">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#F2F3F5" />
        </Style>

        <!-- 开发者选项折叠头（原始 JSON 透传集中到这里，默认收起）：
             Foreground 必须显式钉住 —— Semi 的 ToggleButton 在 :checked 下会把前景刷成白色 -->
        <Style Selector="ToggleButton.dev-toggle">
            <Setter Property="Template" Value="{StaticResource SectionToggleTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 同 check-row：不钉 Stretch 会按内容宽度居中，箭头也贴不到行尾 -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ToggleButton.dev-toggle:pointerover">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="ToggleButton.dev-toggle:checked">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="ToggleButton.dev-toggle Path.chev-icon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>
        <Style Selector="ToggleButton.dev-toggle:checked Path.chev-icon">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="180" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Border.dev-panel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EDEFF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,9" />
        </Style>

        <!-- 被本条覆盖过账号预设的字段 —— 左侧品牌紫竖条 -->
        <Style Selector="Border.overridden">
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>

        <!-- 预检问题行 -->
        <Style Selector="Border.issue-error">
            <Setter Property="Background" Value="#FDECEA" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.issue-warn">
            <Setter Property="Background" Value="#FFF3E8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="36,26,36,18">

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 页头（工作台 / 编辑器 / 预设 三态各一套） ═══
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
              Margin="0,0,0,16" IsVisible="{Binding ShowWorkbench}">
            <Border Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20H19V18H5V20Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="发布视频" FontSize="20" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="导入文件夹即成为一个发布单元；params.txt 里写了的（标题/简介/话题/位置/合集/声明…）逐条生效，其余走账号预设"
                           FontSize="12" 
                           Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Border Classes="pill" Background="#FFF3E8" IsVisible="{Binding HasAccountAlerts}">
                    <TextBlock Classes="pill-text" Text="账号异常" Foreground="#B45F06" />
                </Border>
                <Button Classes="sec" Content="发布预设" Height="30" FontSize="12"
                        Command="{Binding ShowPresetsViewCommand}" />
                <Button Classes="sec" Content="账号排序" Height="30" FontSize="12"
                        Command="{Binding ShowOrderViewCommand}" />
                <Button Classes="sec" Content="清空" Height="30" FontSize="12"
                        Command="{Binding ClearDraftsCommand}"
                        IsEnabled="{Binding HasDrafts}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12"
              Margin="0,0,0,16" IsVisible="{Binding ShowEditor}">
            <Button Classes="ghost" Width="34" Height="34" Padding="0"
                    Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding BackToListCommand}" ToolTip.Tip="返回待发布列表">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                </Viewbox>
            </Button>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20H19V18H5V20Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="内容字段每条填一次；位置/话题一次输入多平台并行解析；平台差异留在右侧卡片里"
                           FontSize="12" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="sec" Content="发布预设" Height="30" FontSize="12"
                        Command="{Binding ShowPresetsViewCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12"
              Margin="0,0,0,16" IsVisible="{Binding ShowPresets}">
            <Button Classes="ghost" Width="34" Height="34" Padding="0"
                    Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding BackToListCommand}" ToolTip.Tip="返回工作台">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                </Viewbox>
            </Button>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="发布预设" FontSize="20" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="每个平台账号一套默认值，导入条目时自动套用 —— 字段不必每条都填"
                           FontSize="12" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12"
              Margin="0,0,0,16" IsVisible="{Binding ShowOrder}">
            <Button Classes="ghost" Width="34" Height="34" Padding="0"
                    Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding BackToListCommand}" ToolTip.Tip="返回工作台">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                </Viewbox>
            </Button>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="账号排序" FontSize="20" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="整组移动带上该平台的全部账号；行级上下移只在同平台内换位 —— 顺序即时生效，工作台 / 账号坞 / 平台页一起变"
                           FontSize="12" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <Button Grid.Column="3" Classes="sec" Content="恢复默认顺序" Height="30" FontSize="12"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding HasAccounts}"
                    Command="{Binding ResetAccountOrderCommand}" />
        </Grid>

        <!-- ═══ 账号窗口未打开提示（发布前必读：窗口没开=凭证是旧的，发布会报错）═══
             只在工作台/编辑器两屏显示；不代开窗口（平台有扫码/风控，必须用户自己点开） -->
        <Border Grid.Row="1" Background="{StaticResource BrandSoft}"
                BorderBrush="{StaticResource BrandSoftBorder}" BorderThickness="1"
                CornerRadius="12" Padding="16,12" Margin="0,0,0,14"
                IsVisible="{Binding ShowVerifyPrompt}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Width="18" Height="18" CornerRadius="9"
                        Background="{StaticResource BrandPrimary}" VerticalAlignment="Center">
                    <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding VerifyPromptText}" FontSize="12.5"
                           Foreground="{StaticResource BrandActive}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2" Classes="sec" Content="去平台账号" Height="30"
                        Padding="16,0"
                        ToolTip.Tip="到「平台账号」页点开这些账号的窗口（自动刷新凭证），打开后本提示消失"
                        Command="{Binding GoOpenAccountWindowsCommand}" />
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图一：工作台 ═══
        ════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowWorkbench}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,6,0">

                <!-- 账号异常横幅（最高优先级交互，设计文档 §2.4 ①） -->
                <ItemsControl ItemsSource="{Binding AccountAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountAlertViewModel">
                            <Border Background="#FFF3E8" BorderBrush="#FFE0B2" BorderThickness="1"
                                    CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="18" Height="18" CornerRadius="9"
                                            Background="#FA8C16" VerticalAlignment="Center">
                                        <TextBlock Text="!" FontSize="12" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                                               Foreground="#B45F06" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Classes="chip-retry" Content="去登录"
                                            Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).GoLoginCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 导入区 -->
                <Border Background="{StaticResource BrandSoft}"
                        BorderBrush="{StaticResource BrandSoftBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                            <Button Classes="cta" Content="导入文件夹" Height="38" Padding="20,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ImportFolderCommand}" />
                            <Button Grid.Column="1" Classes="sec" Content="添加视频" Height="38"
                                    Padding="20,0" VerticalAlignment="Center"
                                    Command="{Binding AddVideosCommand}" />
                            <Button Grid.Column="2" Classes="sec" Content="新建模板" Height="38"
                                    Padding="20,0" VerticalAlignment="Center"
                                    ToolTip.Tip="生成一个「发布单元模板」文件夹：复制改名、丢进视频就能导入"
                                    Command="{Binding CreateTemplateCommand}" />
                            <Button Grid.Column="3" Classes="ghost" Content="导入说明"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleImportHelpCommand}" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2"
                                        Margin="10,0,0,0">
                                <TextBlock TextWrapping="Wrap" Text="子文件夹 = 一条视频 · 散装视频每个一条" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandActive}" />
                                <TextBlock Text="params.txt 填标题 / 简介 / 话题 / 位置 / 合集 · cover.jpg 作封面（缺了自动抽首帧）· 一次最多 10 条"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="或把文件夹拖到这里"
                                       FontSize="11" Foreground="{StaticResource TextPlaceholder}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 待导入条：展开超过 10 条时的余量，不重新选文件就能接着导 -->
                        <Border IsVisible="{Binding HasPending}" Background="White"
                                BorderBrush="{StaticResource BrandSoftBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding PendingText}" FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="sec" Height="30" Padding="14,0"
                                        Content="{Binding ImportMoreLabel}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Command="{Binding ImportMoreCommand}" />
                                <Button Grid.Column="2" Classes="ghost" Content="放弃剩余"
                                        VerticalAlignment="Center"
                                        Command="{Binding ClearPendingCommand}" />
                            </Grid>
                        </Border>

                        <!-- 导入提示条：params.txt 哪一行没看懂 / 哪个目录没视频 / 跳过几条重复 -->
                        <Border IsVisible="{Binding HasImportNotice}" Background="#FFF3E8"
                                BorderBrush="#FFE0B2" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <TextBlock Text="{Binding ImportNotice}" FontSize="11.5"
                                       Foreground="#B45F06" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 目录约定说明（页内折叠；点「新建模板」后自动展开） -->
                <Border IsVisible="{Binding ShowImportHelp}" Background="White"
                        BorderBrush="#EDEFF3" BorderThickness="1"
                        CornerRadius="12" Padding="20,18">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="导入说明" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="sec" Height="30" Padding="14,0" Content="新建模板"
                                        Command="{Binding CreateTemplateCommand}" />
                                <Button Classes="sec" Height="30" Padding="14,0" Content="打开模板文件夹"
                                        IsEnabled="{Binding HasTemplateFolder}"
                                        Command="{Binding OpenTemplateFolderCommand}" />
                                <Button Classes="ghost" Content="收起"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleImportHelpCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="一个文件夹 = 一条待发布视频" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandActive}" />
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="14" RowSpacing="5">
                            <TextBlock Text="我的视频\" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Grid.Column="2" Text="文件夹名 = 默认标题（可被 params.txt 的「标题:」覆盖）"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="我的视频.mp4" FontSize="12"
                                       Margin="14,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="视频，必需。目录里有多个时只取第一个"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="params.txt" FontSize="12"
                                       Margin="14,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="参数，可选 —— 标题 / 简介 / 话题 / 位置 / 合集 / 可见性 / 声明 / 发布时间 / 允许下载 / 原创（小红书 / B站 / 头条 / 视频号）"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="cover.jpg" FontSize="12"
                                       Margin="14,0,0,0" />
                            <TextBlock TextWrapping="Wrap" Grid.Row="3" Grid.Column="2" Text="封面，可选。jpg / png / webp 都行；没有就自动抽视频首帧"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                        </Grid>

                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="一次最多导入 10 条：展开后超过 10 条时，多出来的留在「待导入」里，点「继续导入」接着导，不用重选。" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="格式：每行「字段名: 值」，# 开头是注释。字段名写错只是那一行不生效，不会让导入失败（导入时会在提示条里说明是第几行）。" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="话题写在「话题:」行里，不要写进「简介」：发布时软件会把话题带 # 追加到正文末尾（四个平台都是），简介里再写一个对不上话题的 #，抖音会整条拒收。" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="位置写的是关键词（如「苏州姑苏」），导入时软件去四个平台各搜一次，各拿各自的 POI；搜不到的平台标「不带位置」，不会瞎填。合集写的是名字（如「苏州房产」），导入时按名字查你在「合集」页同步下来的映射，铺到每个账号；名字对不上就保持账号预设不动，某个账号没同步过则那个账号不带合集。快手「同城可见·允许同框」/ 抖音「热点词」/ 可见性名单 / 声明的补充信息仍按账号记，在「发布预设」或条目编辑器里调。" />
                    </StackPanel>
                </Border>

                <!-- 全局目标 -->
                <Border Background="White" BorderBrush="#EDEFF3" BorderThickness="1"
                        CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="发布到" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0"
                                       Text="新导入的条目默认发到这些账号"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TargetCountText}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Text="还没有绑定任何平台账号 —— 到「平台账号」页去登录一个，再回来发布"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   IsVisible="{Binding !HasAccounts}" />

                        <!-- 分组组条（2026-10-14）：点一格 = 只勾选该格账号（替换式，芯片仍全部可见、
                             可再手动微调）；「全部」是第 0 格哨兵。没有分组时整条不出现。 -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding HasGroupChoices}">
                            <TextBlock Text="分组" FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding GroupChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountGroupChoiceViewModel">
                                        <Button Classes="group-chip" Margin="0,0,6,4"
                                                Classes.active="{Binding IsActive}"
                                                IsEnabled="{Binding !IsEmpty}"
                                                Content="{Binding Text}"
                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ApplyGroupCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding GlobalTargets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountChipViewModel">
                                    <ToggleButton Classes="chip" IsChecked="{Binding IsOn}"
                                                  IsEnabled="{Binding CanPublish}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="chip-dot" Width="8" Height="8"
                                                    CornerRadius="4"
                                                    Background="{Binding BrandHex}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PlatformName}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#F2F3F5" CornerRadius="4" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowUnsupported}">
                                                <TextBlock Text="未接入" FontSize="9.5"
                                                           Foreground="#86909C" />
                                            </Border>
                                            <Border Width="6" Height="6" CornerRadius="3"
                                                    Background="#FA8C16" VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowExpired}"
                                                    ToolTip.Tip="登录已过期，需重新登录" />
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     VerticalAlignment="Center">
                                                <Path Classes="chip-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="{StaticResource BrandPrimary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding DraftCountText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <!-- 全选（2026-10-22 用户需求）：全勾 ↔ 取消全勾，与每条勾选双向联动 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding HasDrafts}">
                        <ToggleButton Classes="check-row" Width="20" Height="20" Padding="0"
                                      IsChecked="{Binding AllDraftsSelected}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="全选 / 取消全选所有待发布条目">
                            <Border Classes="tick">
                                <Viewbox Width="11" Height="11" Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Classes="tick-check"
                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                          Fill="White" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                        </ToggleButton>
                        <TextBlock Text="全选" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 批量移除勾选的条目（与「提交」同一只勾：勾着的就是要处理的那批） -->
                    <Button Grid.Column="2" Classes="danger" Height="28" FontSize="12"
                            Content="{Binding RemoveSelectedText}"
                            IsVisible="{Binding HasSelectedDrafts}"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding RemoveSelectedDraftsCommand}" />
                    <TextBlock Grid.Column="4" Text="未勾选的条目不会提交"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock TextWrapping="Wrap" Text="还没有待发布条目 —— 点上面的「导入文件夹」，或直接把文件夹拖进来"
                           FontSize="12" Foreground="{StaticResource TextMuted}"
                           Margin="0,20,0,0" HorizontalAlignment="Center"
                           IsVisible="{Binding !HasDrafts}" />

                <ItemsControl ItemsSource="{Binding Drafts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PublishDraft">
                            <Border Classes="mock-card" Padding="16,14" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                    <ToggleButton Classes="check-row" Width="20" Height="20"
                                                  Padding="0" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center">
                                        <Border Classes="tick">
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="tick-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="White" Stretch="Uniform" />
                                            </Viewbox>
                                        </Border>
                                    </ToggleButton>

                                    <!-- 缩略图：探测出来就显示首帧，否则品牌浅色块 -->
                                    <Border Grid.Column="1" Classes="thumb"
                                            Background="{StaticResource BrandSoft}"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Meta.ThumbPath, Converter={StaticResource PathToBitmap}}"
                                                   Stretch="UniformToFill" />
                                            <Viewbox Width="16" Height="16" Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding !HasThumb}">
                                                <Path Data="M8,5L19,12L8,19Z" Fill="#FFFFFF"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="2" Spacing="8"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" FontSize="15"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}" Classes="hint"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PublishTarget">
                                                    <Border Background="#F7F8FA" CornerRadius="7"
                                                            Padding="6,3" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding PlatformDisplayName}" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding AccountLabel}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 内联预检：问题直接标在卡片上，不等到提交 -->
                                        <ItemsControl ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PreflightIssue">
                                                    <Border Background="{Binding BgHex}" CornerRadius="7"
                                                            Padding="8,4" Margin="0,0,0,4">
                                                        <TextBlock Classes="issue"
                                                                   Foreground="{Binding TextHex}">
                                                            <Run Text="{Binding Prefix}" FontWeight="Bold" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Message}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Button Classes="ghost" Content="编辑"
                                                HorizontalAlignment="Right"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).EditDraftCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="ghost" Content="移除"
                                                HorizontalAlignment="Right"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).RemoveDraftCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图二：条目编辑器 ═══
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,340" ColumnSpacing="20"
              IsVisible="{Binding ShowEditor}">

            <!-- ─── 左栏：全局区 ─── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,6,0">

                    <!-- 内容（每条一次） -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="sec-title" Text="内容（每条一次）" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Classes="lbl" Text="标题" VerticalAlignment="Center"
                                           Width="52" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedDraft.Title}"
                                         Watermark="视频标题" />
                                <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                           Text="{Binding TitleCounterText}"
                                           MinWidth="52" TextAlignment="Right" />
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="lbl" Text="简介" />
                                <!-- 多行框必须显式 Top：默认 Center 会把第一行顶到框中间，
                                     上方留一大片空白（合集页的简介同样处理） -->
                                <TextBox Text="{Binding SelectedDraft.Description}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" Padding="12,10"
                                         MinHeight="90" MaxHeight="180"
                                         Watermark="视频简介（话题写在下面的「话题」里，发布时自动追加到正文末尾）" />
                                <TextBlock Classes="hint" Text="{Binding DescriptionCounterText}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="lbl" Text="封面" />
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                    <Border Width="96" Height="64" CornerRadius="8"
                                            Background="#F2F3F5" ClipToBounds="True">
                                        <Image Source="{Binding CoverPathForPreview, Converter={StaticResource PathToBitmap}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Classes="sec" Content="选择封面" Height="28"
                                                FontSize="12"
                                                Command="{Binding PickCoverCommand}" />
                                        <Button Classes="ghost" Content="用视频首帧" Height="26"
                                                Command="{Binding ClearCoverCommand}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                   Text="不选的话，会自动抽取视频首帧上传当封面（各平台统一，避开 0 秒黑场）；选了图会先上传并以图为准" />
                                        <!-- 封面图实际像素 —— 抖音裁剪尺寸留空时按它自动下发 -->
                                        <TextBlock Classes="hint"
                                                   Text="{Binding CoverSizeText}"
                                                   IsVisible="{Binding HasCoverSize}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 封面帧：内容级选择（六平台共用的自动抽帧时间点），空 = 0.5 秒 -->
                                <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="10">
                                    <TextBlock Classes="lbl" Text="封面帧" VerticalAlignment="Center"
                                               Width="52" />
                                    <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                             Text="{Binding CoverFrameText}"
                                             Watermark="秒，空 = 0.5" />
                                    <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="第几秒截封面 —— 没选封面图时统一按它自动抽帧；留空 = 0.5 秒（避开黑场），0 = 第 0 秒；选了封面图以图为准" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="lbl" Text="发布时间" />
                                <!-- 日期/时间选择器**单独一行**：这两个控件比同排的按钮宽，
                                     塞进 Auto 列会顶到相邻列上（Avalonia 默认不裁剪）。
                                     占满一行既躲开这个坑，也让「几点发」看得更清楚。 -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ToggleButton Classes="radio-row" Padding="4,4"
                                                  IsChecked="{Binding IsImmediate}"
                                                  Command="{Binding SelectScheduleModeCommand}"
                                                  CommandParameter="{x:False}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="radio">
                                                <Border Classes="radio-core" Width="8" Height="8"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="立即" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Classes="radio-row" Padding="4,4"
                                                  IsChecked="{Binding IsScheduled}"
                                                  Command="{Binding SelectScheduleModeCommand}"
                                                  CommandParameter="{x:True}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="radio">
                                                <Border Classes="radio-core" Width="8" Height="8"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="定时" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10"
                                            IsVisible="{Binding IsScheduled}">
                                    <DatePicker Theme="{StaticResource AppDatePickerTheme}"
                                                SelectedDate="{Binding ScheduledDate}" />
                                    <TimePicker Theme="{StaticResource AppTimePickerTheme}"
                                                SelectedTime="{Binding ScheduledTime}" />
                                    <TextBlock Classes="hint" VerticalAlignment="Center"
                                               Text="{Binding ScheduleHint}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 可见性（含小红书白名单） -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sec-title" Text="可见性" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Classes="hint" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="六态：仅小红书支持互关/只给/不给，仅粉丝仅头条；其余平台不支持的会退回「公开」" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding VisibilityOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VisibilityOptionViewModel">
                                        <ToggleButton Classes="radio-row" Padding="6,4"
                                                      Margin="0,0,14,6"
                                                      IsChecked="{Binding IsSelected}"
                                                      Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).SelectVisibilityCommand}"
                                                      CommandParameter="{Binding Kind}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="radio">
                                                    <Border Classes="radio-core" Width="8" Height="8"
                                                            CornerRadius="4" Background="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" Text="{Binding VisibilityNote}"
                                       TextWrapping="Wrap" />

                            <!-- 白名单：紧贴可见性，只在「只给谁看 / 不给谁看」时出现 -->
                            <StackPanel Spacing="8" IsVisible="{Binding ShowPrivacyWhitelist}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding PrivacySearchText}"
                                             Watermark="搜索小红书用户（昵称）…" />
                                    <Button Grid.Column="1" Classes="sec" Content="搜索" Height="32"
                                            FontSize="12"
                                            Command="{Binding SearchPrivacyUsersCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PrivacyResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PrivacyUserRow">
                                            <Border Classes="resolve-row" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Classes="tick" Width="14" Height="14"
                                                            Background="White"
                                                            BorderBrush="#C9CDD4">
                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding IsSelected}">
                                                            <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                  Fill="{StaticResource BrandPrimary}"
                                                                  Stretch="Uniform" />
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nickname}"
                                                               FontSize="12" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Classes="ghost" Content="选"
                                                            Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).TogglePrivacyUserCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="lbl" Text="已选白名单（点 × 移除）" />
                                    <ItemsControl ItemsSource="{Binding PrivacyChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PrivacyUserRow">
                                                <Border Background="#F7F8FA" CornerRadius="7"
                                                        Padding="8,4" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Nickname}" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Button Classes="ghost" Content="×" Width="18"
                                                                Height="18" Padding="0" FontSize="13"
                                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).RemovePrivacyUserCommand}"
                                                                CommandParameter="{Binding UserId}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <ToggleButton Classes="check-row" Padding="4,4"
                                          IsChecked="{Binding SelectedDraft.AllowDownload}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="tick">
                                        <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Classes="tick-check"
                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                  Fill="White" Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="允许他人下载" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- 原创：2026-11-06 从小红书平台卡上提到全局区（内容属性，不是账号属性） -->
                            <StackPanel Spacing="4">
                                <ToggleButton Classes="check-row" Padding="4,4"
                                              IsChecked="{Binding IsOriginal}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="tick">
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="tick-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="White" Stretch="Uniform" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="原创声明" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="仅小红书 / B站 / 头条 / 视频号有投稿字段（视频号落 postFlag bit0）；开启后不能同时选「内容为转载」（预检会拦）" />
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="小红书：视频需 ≥10 秒才能用原创声明与视频标注" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 话题：联邦解析 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="sec-title" Text="话题" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="一次输入 · 各平台并行解析；未命中的平台保留纯文本，不删" />
                                <Button Grid.Column="2" Classes="ghost" Content="重新解析"
                                        IsEnabled="{Binding HasTopics}"
                                        Command="{Binding ResolveTopicsCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectedDraft.Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{StaticResource BrandSoft}" CornerRadius="7"
                                                Padding="8,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" FontSize="12"
                                                           Foreground="{StaticResource BrandActive}"
                                                           VerticalAlignment="Center" />
                                                <Button Classes="ghost" Content="×" Width="18"
                                                        Height="18" Padding="0" FontSize="13"
                                                        Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).RemoveTopicCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding TopicInput}" Watermark="输入话题名，回车或点「添加」" />
                                <Button Grid.Column="1" Classes="sec" Content="添加" Height="32"
                                        FontSize="12" Command="{Binding AddTopicCommand}" />
                            </Grid>

                            <!-- 快手硬限 3 个话题标签（2026-10-22 实测，超了 submit 整条拒） -->
                            <Border Background="#FFF3E8" CornerRadius="7" Padding="8,4"
                                    IsVisible="{Binding ShowKuaishouTopicLimitHint}">
                                <TextBlock FontSize="11.5" Foreground="#B45F06" TextWrapping="Wrap"
                                           Text="{Binding KuaishouTopicLimitText}" />
                            </Border>

                            <StackPanel Spacing="6" IsVisible="{Binding ShowTopicResults}">
                                <TextBlock Classes="lbl" Text="各平台解析结果" />
                                <ItemsControl ItemsSource="{Binding TopicRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:TopicResolutionRow">
                                            <StackPanel Margin="0,0,0,4">
                                                <!-- 关键词组头：画在每组第一行上。
                                                     候选列表是嵌套 ItemsControl —— $parent[ItemsControl] 会解析到**内层**、
                                                     命令就绑不到 VM，所以这一区一律用 $parent[UserControl]。 -->
                                                <TextBlock Text="{Binding Keyword}" FontSize="12.5"
                                                           FontWeight="SemiBold" Margin="0,6,0,4"
                                                           IsVisible="{Binding IsGroupFirst}" />
                                                <Border Classes="resolve-row">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Classes="pf-badge"
                                                                Background="{Binding BrandHex}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <Border Width="6" Height="6" CornerRadius="3"
                                                                    Background="{Binding DotHex}"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PrimaryText}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NotFoundText}"
                                                                       Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsNotFound}" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Classes="hint"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{Binding StatusColorHex}"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding Found}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <!-- 小红书冷启动预热可达几十秒：告诉用户在跑，不是在卡住 -->
                                                            <TextBlock Text="检索中…" Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsBusy}" />
                                                            <Button Classes="chip-retry" Content="换"
                                                                    IsVisible="{Binding ShowSwap}"
                                                                    IsEnabled="{Binding !IsBusy}"
                                                                    ToolTip.Tip="展开候选；回填的结果还没拉过候选时，点一下现拉"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleCandidatesCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Classes="chip-retry" Content="重搜"
                                                                    IsVisible="{Binding ShowRetry}"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ResolveTopicsCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 候选（就地展开）：「用这个」立刻换掉该平台**所有账号**的值 -->
                                                <Border IsVisible="{Binding IsExpanded}" Margin="2,2,0,6"
                                                        Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Candidates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:ResolutionCandidate">
                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="10" Margin="0,3">
                                                                    <TextBlock Text="{Binding Primary}" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Secondary}"
                                                                               Classes="hint"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="当前"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource BrandActive}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsCurrent}" />
                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                            Content="用这个"
                                                                            IsVisible="{Binding !IsCurrent}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickTopicCandidateCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 翻页：只有支持分页的平台才出现（抖音/小红书话题、视频号位置都不支持） -->
                                                    <Button Classes="chip-retry" Content="加载更多"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            IsVisible="{Binding CanLoadMore}"
                                                            IsEnabled="{Binding !IsLoadingMore}"
                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreCandidatesCommand}"
                                                            CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 平台推荐（2026-11-09 恢复）：右侧平台卡话题块删除后，
                                 小红书 / B站 的「按标题推荐」接口失去了 UI 入口 —— 接回公共话题卡。
                                 每账号一行：获取推荐 → 候选（带平台 ID）→ 选中写进该账号的结构化
                                 话题（发布时下发 hash_tag / topic_id），芯片可移除。
                                 快手 / 头条的推荐要等视频上传完成后的上下文，行内给说明不误导。 -->
                            <StackPanel Spacing="8" Margin="0,4,0,0"
                                        IsVisible="{Binding HasPlatformRecommendRows}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="lbl" Text="平台推荐" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="按标题 / 简介向平台要推荐；选中后带平台话题 ID（发布时作为结构化话题下发）" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RecommendRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TargetRowViewModel">
                                            <Border Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                        <Border Classes="pf-badge" Background="{Binding BrandHex}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PlatformName}" FontSize="12.5"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding TopicApiHint}"
                                                                   Classes="hint" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasTopicApiHint}" />
                                                        <Button Grid.Column="3" Classes="chip-retry"
                                                                Content="获取推荐"
                                                                IsEnabled="{Binding !IsTopicBusy}"
                                                                IsVisible="{Binding !TopicRecommendNeedsUpload}"
                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RecommendTopicSuggestionsCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <!-- 已选结构化话题（带平台 ID）：标签 + 移除 -->
                                                    <ItemsControl ItemsSource="{Binding TopicChips}"
                                                                  IsVisible="{Binding HasTopicChips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TopicChipViewModel">
                                                                <Border Background="{StaticResource BrandSoft}"
                                                                        CornerRadius="7" Padding="8,3"
                                                                        Margin="0,0,6,4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="12"
                                                                                   Foreground="{StaticResource BrandActive}"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding ToolTipText}" />
                                                                        <Border Background="#FFF3E8" CornerRadius="4"
                                                                                Padding="4,0" VerticalAlignment="Center"
                                                                                IsVisible="{Binding IsActivity}">
                                                                            <TextBlock Text="有奖活动" FontSize="10"
                                                                                       Foreground="#B45F06" />
                                                                        </Border>
                                                                        <TextBlock Text="仅文本" FontSize="10"
                                                                                   Foreground="#86909C"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsPlainText}" />
                                                                        <Button Classes="ghost" Content="×"
                                                                                Width="18" Height="18"
                                                                                Padding="0" FontSize="13"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveTopicChipCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{Binding TopicStatusText}"
                                                               IsVisible="{Binding HasTopicStatus}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{Binding TopicStatusColorHex}" />
                                                    <TextBlock Text="拉取中…" Classes="hint"
                                                               IsVisible="{Binding IsTopicBusy}" />

                                                    <!-- 候选：选中即写进该账号的结构化话题 -->
                                                    <ItemsControl ItemsSource="{Binding TopicSuggestions}"
                                                                  IsVisible="{Binding HasTopicSuggestions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TopicPickViewModel">
                                                                <Border Background="White" BorderBrush="#EDEFF3"
                                                                        BorderThickness="1" CornerRadius="7"
                                                                        Padding="8,3" Margin="0,0,6,4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding ToolTipText}" />
                                                                        <TextBlock Text="{Binding MetricText}"
                                                                                   Classes="hint" FontSize="10.5"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding HasMetric}" />
                                                                        <TextBlock Text="已添加" FontSize="10.5"
                                                                                   Foreground="{StaticResource BrandActive}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsSelected}" />
                                                                        <Button Classes="chip-retry" Content="添加"
                                                                                IsVisible="{Binding !IsSelected}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickTopicSuggestionCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 官方活动（2.6.9）：抖音 / 快手 / 小红书 / B站 / 视频号 有活动接口（头条没有）——
                         每平台一行、合并到公共区（不再散落在右侧平台卡里）；
                         选择 / 清除对该平台所有账号一起生效；选中自动带活动关联话题。 -->
                    <Border Classes="section-card" IsVisible="{Binding HasActivityRows}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sec-title" Text="官方活动" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="关联官方活动可在活动页获得额外曝光；活动不影响发布，只是多一份曝光" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ActivityRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlatformActivityRowViewModel">
                                        <Border Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Classes="pf-badge" Background="{Binding BrandHex}">
                                                        <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                   FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlatformName}" FontSize="12.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Classes="hint" Text="{Binding AccountScopeText}"
                                                                   IsVisible="{Binding HasAccountScope}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                            Content="{Binding ActivityPanelButtonText}"
                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleActivityPanelCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>

                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                           Text="还没有选择活动 —— 点「选择活动」拉取平台官方活动；活动不影响发布，只是多一份曝光"
                                                           IsVisible="{Binding ShowActivityEmptyHint}" />

                                                <ItemsControl ItemsSource="{Binding ActivityChips}"
                                                              IsVisible="{Binding HasActivityChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityChipViewModel">
                                                            <Border Background="{StaticResource BrandSoft}"
                                                                    CornerRadius="7" Padding="8,3"
                                                                    Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource BrandActive}"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding ToolTipText}" />
                                                                    <Border Background="#FFF3E8"
                                                                            CornerRadius="4" Padding="4,0"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding HasReward}">
                                                                        <TextBlock Text="{Binding RewardText}"
                                                                                   FontSize="10"
                                                                                   Foreground="#B45F06" />
                                                                    </Border>
                                                                    <TextBlock Text="已结束" FontSize="10"
                                                                               Foreground="#CB2634"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsEnded}" />
                                                                    <TextBlock Text="{Binding DeadlineText}"
                                                                               Classes="hint" FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasDeadline}" />
                                                                    <TextBlock Text="{Binding TopicCountText}"
                                                                               Classes="hint" FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasTopics}" />
                                                                    <Button Classes="ghost" Content="×"
                                                                            Width="18" Height="18"
                                                                            Padding="0" FontSize="13"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearActivityCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 活动候选面板（就地展开） -->
                                                <StackPanel Spacing="6"
                                                            IsVisible="{Binding IsActivityPanelOpen}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Text="活动来自平台官方接口；选中后自动带上活动关联话题，对该平台所有账号生效" />
                                                        <Button Grid.Column="1" Classes="sec"
                                                                Content="获取活动列表"
                                                                Height="32" FontSize="12"
                                                                IsEnabled="{Binding !IsActivityBusy}"
                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).FetchActivitiesCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding ActivityStatusText}"
                                                               IsVisible="{Binding HasActivityStatus}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{Binding ActivityStatusColorHex}" />
                                                    <TextBlock Text="拉取中…" Classes="hint"
                                                               IsVisible="{Binding IsActivityBusy}" />

                                                    <ScrollViewer MaxHeight="260"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsVisible="{Binding HasActivityOptions}">
                                                        <ItemsControl ItemsSource="{Binding ActivityOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ActivityCardViewModel">
                                                                    <Border Background="White" BorderBrush="#EDEFF3"
                                                                            BorderThickness="1" CornerRadius="7"
                                                                            Padding="8,6" Margin="0,0,0,6"
                                                                            Opacity="{Binding CardOpacity}">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                                                              ColumnSpacing="10">
                                                                            <!-- 封面（远程加载；失败/未加载 → 首字占位） -->
                                                                            <Border Width="56" Height="56"
                                                                                    CornerRadius="6"
                                                                                    ClipToBounds="True"
                                                                                    Background="#EEF1F5"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <Image Source="{Binding Cover}"
                                                                                           Stretch="UniformToFill"
                                                                                           IsVisible="{Binding HasCover}" />
                                                                                    <TextBlock Text="{Binding Initial}"
                                                                                               FontSize="20"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="#A9B4C4"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding !HasCover}" />
                                                                                </Grid>
                                                                            </Border>

                                                                            <StackPanel Grid.Column="1" Spacing="3"
                                                                                        VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="6">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="12.5"
                                                                                               FontWeight="SemiBold"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"
                                                                                               ToolTip.Tip="{Binding ToolTipText}" />
                                                                                    <Border Background="#E8F3FF"
                                                                                            CornerRadius="4" Padding="4,0"
                                                                                            VerticalAlignment="Center"
                                                                                            IsVisible="{Binding HasCustomTag}">
                                                                                        <TextBlock Text="{Binding CustomTagText}"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#1D5FA8" />
                                                                                    </Border>
                                                                                    <Border Background="#FFF3E8"
                                                                                            CornerRadius="4" Padding="4,0"
                                                                                            VerticalAlignment="Center"
                                                                                            IsVisible="{Binding HasReward}">
                                                                                        <TextBlock Text="{Binding RewardText}"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#B45F06" />
                                                                                    </Border>
                                                                                    <Border Background="#FDECEE"
                                                                                            CornerRadius="4" Padding="4,0"
                                                                                            VerticalAlignment="Center"
                                                                                            IsVisible="{Binding IsEnded}">
                                                                                        <TextBlock Text="已结束"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#CB2634" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="10">
                                                                                    <TextBlock Text="{Binding DeadlineText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding HasDeadline}" />
                                                                                    <TextBlock Text="{Binding MetricText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding HasMetric}" />
                                                                                    <TextBlock Text="{Binding TopicCountText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding HasTopics}" />
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <Button Grid.Column="2"
                                                                                    Classes="chip-retry"
                                                                                    Content="选择"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding ShowSelectButton}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickActivityCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <TextBlock Grid.Column="2" Text="已选择"
                                                                                       FontSize="11"
                                                                                       Foreground="{StaticResource BrandActive}"
                                                                                       VerticalAlignment="Center"
                                                                                       IsVisible="{Binding IsSelected}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 位置：联邦解析 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="sec-title" Text="位置" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="一次输入 · 平台并行解析；不做实体对齐，逐平台显示实际命中的是哪个 POI" />
                                <Button Grid.Column="2" Classes="ghost" Content="清除位置"
                                        Command="{Binding ClearLocationCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding LocationQuery}"
                                         Watermark="搜索位置（如：外滩）" />
                                <Button Grid.Column="1" Classes="sec" Content="搜索" Height="32"
                                        FontSize="12" Command="{Binding ResolveLocationCommand}" />
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding ShowPoiResults}">
                                <ItemsControl ItemsSource="{Binding PoiRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:PoiResolutionRow">
                                            <StackPanel Margin="0,0,0,4">
                                                <Border Classes="resolve-row">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Classes="pf-badge"
                                                                Background="{Binding BrandHex}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <Border Width="6" Height="6" CornerRadius="3"
                                                                    Background="{Binding DotHex}"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PrimaryText}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NotFoundText}"
                                                                       Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsNotFound}" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{Binding StatusColorHex}"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding Found}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <!-- 小红书冷启动预热可达几十秒：告诉用户在跑，不是在卡住 -->
                                                            <TextBlock Text="检索中…" Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsBusy}" />
                                                            <Button Classes="chip-retry" Content="换"
                                                                    IsVisible="{Binding ShowSwap}"
                                                                    IsEnabled="{Binding !IsBusy}"
                                                                    ToolTip.Tip="展开候选；回填的结果还没拉过候选时，点一下现拉"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleCandidatesCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Classes="chip-retry" Content="重搜"
                                                                    IsVisible="{Binding ShowRetry}"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ResolveLocationCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 候选（就地展开）：「用这个」立刻换掉该平台**所有账号**的位置 -->
                                                <Border IsVisible="{Binding IsExpanded}" Margin="2,2,0,6"
                                                        Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Candidates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:ResolutionCandidate">
                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="10" Margin="0,3">
                                                                    <TextBlock Text="{Binding Primary}" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Secondary}"
                                                                               Classes="hint"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="当前"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource BrandActive}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsCurrent}" />
                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                            Content="用这个"
                                                                            IsVisible="{Binding !IsCurrent}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickPoiCandidateCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 翻页：只有支持分页的平台才出现（抖音/小红书话题、视频号位置都不支持） -->
                                                    <Button Classes="chip-retry" Content="加载更多"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            IsVisible="{Binding CanLoadMore}"
                                                            IsEnabled="{Binding !IsLoadingMore}"
                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreCandidatesCommand}"
                                                            CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 合集：选一个逻辑合集，各平台映射取自合集页已同步数据 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="sec-title" Text="合集" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="四家都支持合集；映射取自合集页已同步的数据，不再逐个平台选一次" />
                                <Button Grid.Column="2" Classes="ghost" Content="不挂合集"
                                        Command="{Binding PickCollectionCommand}" />
                            </Grid>

                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding CollectionOptions}"
                                      SelectedItem="{Binding SelectedCollectionOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CollectionOptionViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SyncText}"
                                                       Classes="hint" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 3.2：文章合集不用于视频发布（头条文章合集 mapping 是另一套 ID） -->
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="{Binding HiddenArticleCollectionText}"
                                       IsVisible="{Binding HasHiddenArticleCollections}" />

                            <ItemsControl ItemsSource="{Binding CollectionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CollectionMappingRow">
                                        <Border Classes="resolve-row" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="pf-badge" Background="{Binding BrandHex}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="9"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlatformName}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusColorHex}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 内容声明：6 个语义 · 按平台能力映射 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sec-title" Text="内容声明" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="单选 · 勾一次自动映射到各平台" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DeclarationOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeclarationOptionViewModel">
                                        <ToggleButton Classes="radio-row" Padding="6,4"
                                                      Margin="0,0,14,6"
                                                      IsChecked="{Binding IsSelected}"
                                                      Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).SelectDeclarationCommand}"
                                                      CommandParameter="{Binding Kind}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="radio">
                                                    <Border Classes="radio-core" Width="8" Height="8"
                                                            CornerRadius="4" Background="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" Text="{Binding DeclarationMatrixText}"
                                       TextWrapping="Wrap" />

                            <!-- 二级区：只有「转载」「自行拍摄」出现；其余只给一句说明 -->
                            <TextBlock Classes="hint" Text="{Binding DeclarationSecondaryHint}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowSecondaryHintOnly}" />

                            <StackPanel Spacing="10" IsVisible="{Binding ShowDeclarationSecondary}">

                                <!-- 抖音：来源（抖音作品 / 站外）+ 选站内作品 -->
                                <Border Classes="field-row" IsVisible="{Binding ShowDouyinRepostSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="抖音 · 转载来源" />
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                            <ToggleButton Classes="radio-row" Padding="4,4"
                                                          IsChecked="{Binding DouyinRepostFromInside}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="radio">
                                                        <Border Classes="radio-core" Width="8" Height="8"
                                                                CornerRadius="4" Background="White"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="抖音作品" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Classes="radio-row" Padding="4,4"
                                                          IsChecked="{Binding !DouyinRepostFromInside}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="radio">
                                                        <Border Classes="radio-core" Width="8" Height="8"
                                                                CornerRadius="4" Background="White"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="站外" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Button Grid.Column="2" Classes="sec" Content="选择我的作品…"
                                                    Height="28" FontSize="12"
                                                    HorizontalAlignment="Left"
                                                    IsVisible="{Binding ShowDouyinRepostItemPicker}"
                                                    Command="{Binding PickDouyinRepostItemCommand}" />
                                        </Grid>

                                        <!-- 已选作品 + 清除 -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                              IsVisible="{Binding ShowDouyinRepostItemPicker}">
                                            <TextBlock Text="{Binding DouyinRepostPickedText}" Classes="hint"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Classes="chip-retry" Content="清除已选"
                                                    IsVisible="{Binding HasDouyinRepostItem}"
                                                    Command="{Binding ClearDouyinRepostItemCommand}" />
                                        </Grid>

                                        <!-- 作品列表（原地展开）：选中即写 from_item_id；老版是独立弹窗，语义等价 -->
                                        <Border IsVisible="{Binding ShowDouyinRepostPicker}"
                                                Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                BorderThickness="1" CornerRadius="8" Padding="10,6">
                                            <StackPanel>
                                                <TextBlock Classes="hint" Text="正在读取作品列表…"
                                                           Margin="0,2"
                                                           IsVisible="{Binding IsLoadingRepostItems}" />
                                                <ItemsControl ItemsSource="{Binding DouyinRepostItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DouyinRepostItemRow">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                                  ColumnSpacing="10" Margin="0,3">
                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}"
                                                                           Classes="hint" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding CreatedText}"
                                                                           Classes="hint" VerticalAlignment="Center" />
                                                                <Button Grid.Column="3" Classes="chip-retry"
                                                                        Content="选择"
                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SelectDouyinRepostItemCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Classes="chip-retry" Content="加载更多"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        IsVisible="{Binding RepostItemsHasMore}"
                                                        IsEnabled="{Binding !IsLoadingRepostItems}"
                                                        Command="{Binding LoadMoreDouyinRepostCommand}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 快手：来源平台 + 地区（省市区文本）+ 时间（毫秒） -->
                                <Border Classes="field-row" IsVisible="{Binding ShowKuaishouRepostSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="快手 · 转载来源 / 地区 / 时间" />
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                            <ComboBox SelectedIndex="{Binding KuaishouRepostPlatformIndex}"
                                                      Width="120">
                                                <ComboBoxItem Content="快手" />
                                                <ComboBoxItem Content="其他平台" />
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Width="180"
                                                     Text="{Binding KuaishouRepostLocation}"
                                                     Watermark="省市区（文本）" />
                                            <DatePicker Grid.Column="2" HorizontalAlignment="Left"
                                                        Theme="{StaticResource AppDatePickerTheme}"
                                                        SelectedDate="{Binding RepostDate}" />
                                            <TextBlock TextWrapping="Wrap" Grid.Column="3" Classes="hint"
                                                       VerticalAlignment="Center"
                                                       Text="快手要的是省市区**文本**与毫秒时间戳" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 小红书：转载填来源；自行拍摄填拍摄地点 + 时间 -->
                                <Border Classes="field-row" IsVisible="{Binding ShowXhsSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="小红书" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                              IsVisible="{Binding IsRepost}">
                                            <TextBlock Text="来源" FontSize="12"
                                                       VerticalAlignment="Center" Width="52" />
                                            <TextBox Grid.Column="1" Text="{Binding RepostSourceText}"
                                                     Watermark="如：YouTube" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                              IsVisible="{Binding IsSelfShot}">
                                            <TextBox Text="{Binding XhsShootPoiQuery}"
                                                     Watermark="拍摄地点（独立于「位置」的第二个地点）" />
                                            <Button Grid.Column="1" Classes="sec" Content="搜索地点"
                                                    Height="32" FontSize="12"
                                                    Command="{Binding SearchXhsShootPoiCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10"
                                              IsVisible="{Binding IsSelfShot}">
                                            <TextBlock Text="拍摄时间" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <DatePicker Grid.Column="1" HorizontalAlignment="Left"
                                                        Theme="{StaticResource AppDatePickerTheme}"
                                                        SelectedDate="{Binding ShootDate}" />
                                            <TextBlock Grid.Column="2" Classes="hint"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding XhsShootPoiText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 视频号：转载来源（选填）；自行拍摄填时间 + 国/省/市 -->
                                <Border Classes="field-row" IsVisible="{Binding ShowWechatSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="视频号" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                              IsVisible="{Binding IsRepost}">
                                            <TextBlock Text="来源" FontSize="12"
                                                       VerticalAlignment="Center" Width="52" />
                                            <TextBox Grid.Column="1" Text="{Binding RepostSourceText}"
                                                     Watermark="选填" />
                                        </Grid>
                                        <StackPanel Spacing="8" IsVisible="{Binding IsSelfShot}">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="拍摄时间" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <DatePicker Grid.Column="1" HorizontalAlignment="Left"
                                                            Theme="{StaticResource AppDatePickerTheme}"
                                                            SelectedDate="{Binding ShootDate}" />
                                                <TextBlock TextWrapping="Wrap" Grid.Column="2" Classes="hint"
                                                           VerticalAlignment="Center"
                                                           Text="视频号协议要 shootInfo（时间戳字符串 + 国省市整数码）" />
                                            </Grid>

                                            <!-- 拍摄地点：平台接口地区树选择器（2026-11-10）——
                                                 原先三个手填整数码（没人记得住 1017 / 10160 / 100032）。
                                                 列表来自 finder_get_object_tag_list 的 tagType=5 regionInfos
                                                 （与页面「拍摄地点」选择器同一数据源）。 -->
                                            <Grid Classes="field-line" ColumnDefinitions="72,*"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="拍摄地点" />
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="6">
                                                    <TextBlock Text="{Binding WechatShootRegionPickedText}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                            Content="选择" Height="26" Padding="10,0"
                                                            Command="{Binding ToggleWechatShootRegionPanelCommand}" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                       Text="地区码由平台列表填 —— 选到哪一级就下发哪一级的整数码；直辖市没有下级城市时市码按 0" />

                                            <Border Classes="dev-panel"
                                                    IsVisible="{Binding IsWechatShootRegionPanelOpen}">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Text="列表来自该视频号账号的平台「视频标注」接口（国家 → 省 → 市）。" />
                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                Content="刷新" Height="28" Padding="10,0"
                                                                IsEnabled="{Binding !IsWechatShootRegionBusy}"
                                                                Command="{Binding LoadWechatShootRegionsCommand}" />
                                                    </Grid>

                                                    <ComboBox ItemsSource="{Binding WechatShootCountries}"
                                                              SelectedIndex="{Binding WechatShootCountryIndex}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:WechatShootRegionOption">
                                                                <TextBlock Text="{Binding Display}" FontSize="12" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <ComboBox ItemsSource="{Binding WechatShootProvinces}"
                                                              SelectedIndex="{Binding WechatShootProvinceIndex}"
                                                              IsVisible="{Binding HasWechatShootProvinces}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:WechatShootRegionOption">
                                                                <TextBlock Text="{Binding Display}" FontSize="12" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <ComboBox ItemsSource="{Binding WechatShootCities}"
                                                              SelectedIndex="{Binding WechatShootCityIndex}"
                                                              IsVisible="{Binding HasWechatShootCities}"
                                                              HorizontalAlignment="Stretch">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:WechatShootRegionOption">
                                                                <TextBlock Text="{Binding Display}" FontSize="12" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="{Binding WechatShootRegionStatusText}"
                                                               IsVisible="{Binding HasWechatShootRegionStatus}" />

                                                    <Button Classes="chip-retry" Content="清除拍摄地点"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="{Binding HasWechatShootRegionPicked}"
                                                            Command="{Binding ClearWechatShootRegionCommand}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="hint" Margin="0,0,0,10"
                               Text="这里的「话题」是跨平台纯文本：一次输入、各平台并行解析；上面「官方活动」每平台一行，选中后自动带上平台话题 ID 与活动关联话题。位置同理，提交时会分别问 N 个平台（联邦解析器）"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- ─── 右栏：平台卡 ─── -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="sec-title" Text="发布到" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hint" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding TargetOnCount, StringFormat='已选 {0} 个账号'}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="0,0,6,0">
                        <TextBlock Text="没有可发布的目标 —— 回工作台勾选账号"
                                   Classes="hint" IsVisible="{Binding NoTargetSelected}" />

                        <ItemsControl ItemsSource="{Binding TargetRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetRowViewModel">
                                    <Border Classes="target-card" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                <ToggleButton Classes="check-row" Width="18" Height="18"
                                                              Padding="0" IsChecked="{Binding IsOn}"
                                                              VerticalAlignment="Center"
                                                              Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).ToggleTargetCommand}"
                                                              CommandParameter="{Binding}">
                                                    <Border Classes="tick" Width="15" Height="15">
                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                            <Path Classes="tick-check"
                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                  Fill="White" Stretch="Uniform" />
                                                        </Viewbox>
                                                    </Border>
                                                </ToggleButton>

                                                <Border Grid.Column="1" Classes="pf-badge"
                                                        Background="{Binding BrandHex}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="9"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlatformName}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="{StaticResource BrandSoft}"
                                                            CornerRadius="5" Padding="4,1"
                                                            IsVisible="{Binding IsPrimary}">
                                                        <TextBlock Text="主" FontSize="9.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource BrandActive}" />
                                                    </Border>
                                                    <Border Width="6" Height="6" CornerRadius="3"
                                                            Background="#FA8C16"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsLoggedIn}"
                                                            ToolTip.Tip="登录已过期" />
                                                </StackPanel>

                                                <ToggleButton Grid.Column="3" Classes="chev"
                                                              Width="22" Height="22" Padding="0"
                                                              IsChecked="{Binding IsExpanded}">
                                                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                        <Path Classes="chev-icon"
                                                              Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                              Fill="{StaticResource TextSecondary}"
                                                              Stretch="Uniform" />
                                                    </Viewbox>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- 摘要行：可见性 · 合集 · 位置（覆盖过预设的左侧有品牌紫竖条） -->
                                            <Border BorderThickness="2,0,0,0"
                                                    BorderBrush="Transparent"
                                                    Padding="8,0,0,0">
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <TextBlock Classes="hint" Text="{Binding VisibilityNote}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasVisibilityNote}" />

                                            <!-- 展开：平台长尾字段（每张卡同一时刻只显示自己的平台块） -->
                                            <StackPanel Spacing="10" IsVisible="{Binding IsExpanded}">

                                                <!-- 抖音长尾（阶段 2.1）——
                                                     2026-11-10 重排：浅灰分组块 + 72px 行内标签。
                                                     2026-11-11：@用户 / 互动贴纸的「开发者选项」已删除
                                                     （真选择器取代；模型字段保留，兼容旧档与 params 透传）。 -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsDouyin}">

                                                    <!-- 文案与音乐 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="文案与音乐" />

                                                            <!-- 热点词：平台接口选择器（2026-11-10）——
                                                                 平台只认它自己的热词，自由文本没有意义；
                                                                 不选 = 不参与热点（hashtag_source 走默认推荐）。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="热点词" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding HotspotDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleHotspotPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：搜索 / 热门 / 候选（首次展开自动拉热门热点） -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsHotspotPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding HotspotQuery}"
                                                                                     Watermark="输入关键词搜索热点" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="搜索"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsHotspotBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchHotspotsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                    Content="热门"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsHotspotBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).FetchTrendingHotspotsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding HotspotStatusText}"
                                                                                   IsVisible="{Binding HasHotspotStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding HotspotCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:HotspotPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <TextBlock Text="{Binding Word}"
                                                                                                       FontSize="12"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding HeatText}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center"
                                                                                                       IsVisible="{Binding HasHeat}" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickHotspotCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <Button Classes="chip-retry" Content="清除已选热点"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasHotspot}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearHotspotCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- 背景音乐：平台接口选择器（2026-11-10）——
                                                                 音乐只认平台自己的曲库（music_id），手填 ID 既难记也验证不了；
                                                                 不选 = 不配乐（common.music_id 不下发）。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="背景音乐" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding MusicDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleMusicPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：分类页签 / 搜索 / 推荐 / 候选（首次展开自动拉推荐列表） -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsMusicPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <!-- 分类页签（平台 music/category 下发；切页签只重拉列表） -->
                                                                        <ItemsControl ItemsSource="{Binding MusicCategories}"
                                                                                      IsVisible="{Binding HasMusicCategories}"
                                                                                      IsEnabled="{Binding !IsMusicBusy}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:MusicCategoryPickViewModel">
                                                                                    <!-- 按钮式页签：选中态走 group-chip.active 的类绑定。
                                                                                         （不用 ToggleButton —— 点已选中页签会先本地反选，
                                                                                         命令再设回同值时不发通知，chip 会停在「未选中」的外观） -->
                                                                                    <Button Classes="group-chip"
                                                                                            Classes.active="{Binding IsSelected}"
                                                                                            Margin="0,0,6,4"
                                                                                            Content="{Binding Name}"
                                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickMusicCategoryCommand}"
                                                                                            CommandParameter="{Binding}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding MusicQuery}"
                                                                                     Watermark="输入歌名 / 歌手搜索" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="搜索"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsMusicBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchMusicCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                    Content="推荐"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsMusicBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).FetchRecommendedMusicCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding MusicStatusText}"
                                                                                   IsVisible="{Binding HasMusicStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding MusicCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:MusicPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <StackPanel Spacing="0"
                                                                                                        VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding Title}"
                                                                                                           FontSize="12"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Text="{Binding Author}"
                                                                                                           Classes="hint" FontSize="11"
                                                                                                           IsVisible="{Binding HasAuthor}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </StackPanel>
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding DurationText}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center"
                                                                                                       IsVisible="{Binding HasDuration}" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickMusicCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <!-- 翻页：游标来自上一页响应（has_more=0 / 游标原地打转时按钮消失） -->
                                                                        <Button Classes="chip-retry" Content="加载更多"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding MusicHasMore}"
                                                                                IsEnabled="{Binding !IsMusicBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreMusicCommand}"
                                                                                CommandParameter="{Binding}" />

                                                                        <Button Classes="chip-retry" Content="清除已选音乐"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasMusic}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearMusicCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 添加标签（2026-11-11 抓包）——
                                                         影视演艺 / 游戏手柄 / 标记万物 / 小程序，平台同一个 anchor 单选；
                                                         小程序 = 粘贴分享链接搜索（anchor/search，anchor_type=4），
                                                         发布体额外带 anchor_business_type + anchor_content。
                                                         选中前先过平台 anchor/check。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="添加标签" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="标签"
                                                                           ToolTip.Tip="与「位置」互斥（平台同一个添加标签入口）；两者都设时按标签发布" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding AnchorDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleAnchorPanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- 展开：类型 chip / 搜索 / 候选 -->
                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsAnchorPanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <ItemsControl ItemsSource="{Binding AnchorTypes}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:AnchorTypePickViewModel">
                                                                                <Button Classes="group-chip"
                                                                                        Classes.active="{Binding IsSelected}"
                                                                                        Margin="0,0,6,4"
                                                                                        Content="{Binding Name}"
                                                                                        IsEnabled="{Binding IsEnabled}"
                                                                                        ToolTip.Tip="{Binding Reason}"
                                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickAnchorTypeCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding AnchorQuery}"
                                                                                 Watermark="输入影视 / 游戏 / 商品名称；小程序粘贴分享链接（标记万物可留空看推荐）" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="搜索"
                                                                                Height="28" Padding="10,0"
                                                                                IsEnabled="{Binding !IsAnchorBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchAnchorsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding AnchorStatusText}"
                                                                               IsVisible="{Binding HasAnchorStatus}" />

                                                                    <ScrollViewer MaxHeight="180"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding AnchorCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:AnchorPickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="选"
                                                                                                Height="24" Padding="8,0"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickAnchorCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <Button Classes="chip-retry" Content="清除已选标签"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding HasAnchor}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearAnchorCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- @好友（2026-11-11 补抓 discover/search）——
                                                         发布体三件套：common.mentions（uid 数组）+
                                                         正文「@昵称」+ text_extra type=0（at_source=user_manual）；
                                                         正文补写与偏移量收在 DouyinMentionRules。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="@好友" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="@好友"
                                                                           ToolTip.Tip="common.mentions —— 发布时正文末尾自动补「@昵称」，与 #话题 共用 text_extra" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding DouyinMentionDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleDouyinMentionPanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsDouyinMentionPanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                          ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding DouyinMentionQuery}"
                                                                                 Watermark="输入昵称 / 抖音号搜索（留空原样发给平台）" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="搜索"
                                                                                Height="28" Padding="10,0"
                                                                                IsEnabled="{Binding !IsDouyinMentionBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchDouyinMentionsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding DouyinMentionStatusText}"
                                                                               IsVisible="{Binding HasDouyinMentionStatus}" />

                                                                    <ScrollViewer MaxHeight="180"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding DouyinMentionCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:DouyinMentionPickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Nickname}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="{Binding PickLabel}"
                                                                                                Height="24" Padding="8,0"
                                                                                                IsEnabled="{Binding !IsPicked}"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickDouyinMentionCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <!-- 已选：点一下移除（候选行的「已选」态按用户 ID 同步） -->
                                                                    <ItemsControl ItemsSource="{Binding DouyinMentions}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:DouyinMentionPickViewModel">
                                                                                <Button Classes="chip-retry"
                                                                                        Margin="0,0,6,4"
                                                                                        Height="24" Padding="8,0"
                                                                                        ToolTip.Tip="点击移除"
                                                                                        Content="{Binding Nickname, StringFormat='@{0} ×'}"
                                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveDouyinMentionCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <Button Classes="chip-retry" Content="清除已选 @好友"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding HasDouyinMentions}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearDouyinMentionsCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 章节 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="章节" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding ChaptersText}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     VerticalContentAlignment="Top" Padding="10,6"
                                                                     MinHeight="64" MaxHeight="140"
                                                                     Watermark="每行：mm:ss 标题，例如 0:00 开箱 / 1:30 实拍" />
                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="时间点 + 标题；按时间升序下发（长视频章节）" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 封面与合集 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="封面与合集" />

                                                            <!-- 封面双槽（B1 抓包 2026-11-11）：竖版 3:4 = 左栏主封面
                                                                 （poster + 裁剪宽高）；这里选横版 4:3 →
                                                                 cover.horizontal_custom_cover_image_uri。不选 = 旧 wire 形状。 -->
                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="横版封面"
                                                                           ToolTip.Tip="抖音封面双槽的横版 4:3（cover.horizontal_custom_cover_image_uri）。竖版 3:4 用左栏「封面」（poster）。不选 = 不单独下发。" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="Auto,*,Auto"
                                                                      ColumnSpacing="8">
                                                                    <Border Width="64" Height="48"
                                                                            CornerRadius="6"
                                                                            Background="#F2F3F5"
                                                                            ClipToBounds="True">
                                                                        <Image Source="{Binding DouyinLandscapeCoverPathForPreview, Converter={StaticResource PathToBitmap}}"
                                                                               Stretch="UniformToFill" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding DouyinLandscapeCoverDisplay}"
                                                                               FontSize="11.5"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <StackPanel Grid.Column="2"
                                                                                Orientation="Horizontal"
                                                                                Spacing="6"
                                                                                VerticalAlignment="Center">
                                                                        <Button Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickDouyinLandscapeCoverCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                        <Button Classes="chip-retry"
                                                                                Content="清除"
                                                                                Height="26" Padding="10,0"
                                                                                IsVisible="{Binding HasDouyinLandscapeCover}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearDouyinLandscapeCoverCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="竖版 3:4 用左栏「封面」（选了图就按封面裁剪宽高下发）；横版 4:3 可选，不选则由平台自行取图。" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="封面裁剪"
                                                                           ToolTip.Tip="竖版封面的裁剪尺寸（cover.custom_cover_image_width/height）；留空 = 按封面图实际像素下发，没有自定义封面时不下发" />
                                                                <StackPanel Grid.Column="1"
                                                                            Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Classes="hint" Text="宽"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBox Theme="{StaticResource AppInputTheme}"
                                                                             Width="76"
                                                                             Text="{Binding CoverCropWidthText}"
                                                                             Watermark="px" />
                                                                    <TextBlock Classes="hint" Text="高"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBox Theme="{StaticResource AppInputTheme}"
                                                                             Width="76"
                                                                             Text="{Binding CoverCropHeightText}"
                                                                             Watermark="px" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8"
                                                                  IsVisible="{Binding HasCollection}">
                                                                <TextBlock Text="合集排序" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding CollectionOrderText}"
                                                                         Watermark="0 = 按发布时间顺序" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 同步（单个选项，不套灰块） -->
                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding SyncToToutiao}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="同步到今日头条 / 西瓜" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                </StackPanel>

                                                <!-- 快手长尾（阶段 2.2）——
                                                     2026-11-10 重排：浅灰分组块 + 行内标签（创作辅助两列），
                                                     原始 JSON 收进默认收起的「开发者选项」。行为不变。 -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsKuaishou}">

                                                    <!-- 发布设置 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="发布设置" />

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding NotifyFollowers}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="发布后通知粉丝" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="封面文字" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding KuaishouCoverTitleText}"
                                                                         Watermark="显示在封面上的文字；留空 = 不加" />
                                                            </Grid>

                                                            <!-- 两个曝光开关原先在卡顶「更多设置」里，2026-11-10 并进本组
                                                                 （那块容器只服务快手，其他平台会留下一个空的「更多设置」标题） -->
                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding ShowInNearby}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="同城可见" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding AllowSameFrame}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="允许同框" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 章节（B3 抓包 2026-11-11）：submit.chapters = [{timeStart:秒, title}]。
                                                         页面入口只在视频 >60 秒时出现；标题 ≤12 字、最多 10 章、
                                                         相邻间隔 >5 秒（页面侧校验，预检给提示）。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="章节" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding ChaptersText}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     VerticalContentAlignment="Top" Padding="10,6"
                                                                     MinHeight="64" MaxHeight="140"
                                                                     Watermark="每行：mm:ss 标题，例如 0:00 开场 / 1:30 实拍" />
                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="视频需超过 60 秒；标题 ≤12 字、最多 10 章、相邻章节间隔需大于 5 秒" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 创作辅助：六个开关排两列，省掉六行纵向空间 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="创作辅助" />
                                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                                                  RowDefinitions="Auto,Auto,Auto" RowSpacing="2">

                                                                <ToggleButton Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding RiseQuality}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="画质增强" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Column="1" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding UseAiCaption}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="AI 字幕" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="1" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding UseAiCaptionCover}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="AI 字幕封面" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="1" Grid.Column="1"
                                                                              Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding UseAiCover}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="AI 封面" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="2" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding UseIdealTime}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="智能发布时间" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="2" Grid.Column="1"
                                                                              Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding DisallowRecreation}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="禁止二创" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 封面 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="封面" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="PK 封面"
                                                                           ToolTip.Tip="pkCoverKey / 帧(秒) / 类型 / 尺寸；类型与尺寸是平台原样字符串" />
                                                                <StackPanel Grid.Column="1" Spacing="6">
                                                                    <Grid ColumnDefinitions="*,66" ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding PkCoverKeyText}"
                                                                                 Watermark="pkCoverKey" />
                                                                        <TextBox Grid.Column="1"
                                                                                 Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding PkCoverTimeStampText}"
                                                                                 Watermark="帧(秒)" />
                                                                    </Grid>
                                                                    <Grid ColumnDefinitions="66,*" ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding PkCoverTypeText}"
                                                                                 Watermark="类型" />
                                                                        <TextBox Grid.Column="1"
                                                                                 Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding PkCoverSizeText}"
                                                                                 ToolTip.Tip="平台原样字符串，例如 1920x1080"
                                                                                 Watermark="尺寸" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="主页封面"
                                                                           ToolTip.Tip="profileCoverKey；留空 = 不改" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ProfileCoverKeyText}"
                                                                         Watermark="profileCoverKey" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 领域与关联 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="领域与关联" />

                                                            <!-- 关联热点（B3 抓包 2026-11-11）：候选来自 hotspot/list，
                                                                 落点 submit.hotspotId（数字）+ hotspotConnectType:1。
                                                                 不选 = 不参与热点（两个键都不下发）。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="关联热点"
                                                                               ToolTip.Tip="submit.hotspotId + hotspotConnectType:1；不选 = 不参与热点" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding KsHotspotDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleKsHotspotPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：搜索 / 热门 / 候选（首次展开自动拉推荐热榜） -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsKsHotspotPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding KsHotspotQuery}"
                                                                                     Watermark="输入关键词搜索热点" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="搜索"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsKsHotspotBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchKsHotspotsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                    Content="热门"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsKsHotspotBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).FetchTrendingKsHotspotsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding KsHotspotStatusText}"
                                                                                   IsVisible="{Binding HasKsHotspotStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding KsHotspotCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:KsHotspotPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <TextBlock Text="{Binding Content}"
                                                                                                       FontSize="12"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding HeatText}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center"
                                                                                                       IsVisible="{Binding HasHeat}" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickKsHotspotCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <!-- 翻页：游标来自上一页响应（没有更多时按钮消失） -->
                                                                        <Button Classes="chip-retry" Content="加载更多"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding KsHotspotHasMore}"
                                                                                IsEnabled="{Binding !IsKsHotspotBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreKsHotspotsCommand}"
                                                                                CommandParameter="{Binding}" />

                                                                        <Button Classes="chip-retry" Content="清除已选热点"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasKsHotspot}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearKsHotspotCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- 作者服务 · 关联小程序（2026-11-15 真页面抓包）：
                                                                 粘快手 APP 小程序页面链接 → relation/list 解析 →
                                                                 选中写 submit.associateTasks（整个 associateTaskId 对象）。
                                                                 不选 = 不带 associateTasks 键。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="关联小程序"
                                                                               ToolTip.Tip="submit.associateTasks；粘贴快手 APP 小程序页面链接解析" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding KsAssociateDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleKsAssociatePanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：粘链接 → 解析 → 候选（空结果同样清空旧候选） -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsKsAssociatePanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding KsAssociateLink}"
                                                                                     Watermark="粘贴小程序页面链接（快手 APP → 小程序 → 复制页面链接）" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="解析"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsKsAssociateBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchKsAssociateCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding KsAssociateStatusText}"
                                                                                   IsVisible="{Binding HasKsAssociateStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding KsAssociateCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:KsRelationPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <StackPanel Spacing="1"
                                                                                                        VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding Title}"
                                                                                                           FontSize="12"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Text="{Binding Desc}"
                                                                                                           Classes="hint"
                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                           IsVisible="{Binding HasDesc}" />
                                                                                                <TextBlock Text="{Binding ValidText}"
                                                                                                           Classes="hint"
                                                                                                           TextWrapping="Wrap"
                                                                                                           IsVisible="{Binding HasValidMessage}" />
                                                                                            </StackPanel>
                                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickKsAssociateCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <Button Classes="chip-retry" Content="清除已关联小程序"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasKsAssociate}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearKsAssociateCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- 共同创作（2026-11-15 页面 bundle 定案）：
                                                                 wire = coPublishUser[{userId,userName,userHead,coPublishRole}]；
                                                                 角色 -1 默认 / 0 作者 / 1 共创 / 2 出镜；选人搜索复用 at/search。
                                                                 账号无共创权限（hasCoPublishQuota=false）时官方页面不显示这块。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="共同创作"
                                                                               ToolTip.Tip="submit.coPublishUser；选人搜索走 at/search（与 @好友同接口）" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding KsCoPublishDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleKsCoPublishPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsKsCoPublishPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding KsCoPublishQuery}"
                                                                                     Watermark="输入昵称搜索共同创作人（可留空看平台默认列表）" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="搜索"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsKsCoPublishBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchKsCoPublishCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding KsCoPublishStatusText}"
                                                                                   IsVisible="{Binding HasKsCoPublishStatus}" />

                                                                        <ScrollViewer MaxHeight="150"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding KsCoPublishCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:KsMentionPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <TextBlock Text="{Binding UserName}"
                                                                                                       FontSize="12"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding Subtitle}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickKsCoPublishCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <!-- 已选共创：每行可单独改角色（wire coPublishRole） -->
                                                                        <ItemsControl ItemsSource="{Binding KsCoPublishUsers}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:KsCoPublishPickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                          ColumnSpacing="6" Margin="0,2">
                                                                                        <TextBlock Text="{Binding UserName}"
                                                                                                   FontSize="12"
                                                                                                   VerticalAlignment="Center"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <ComboBox Grid.Column="1"
                                                                                                  Width="82"
                                                                                                  SelectedIndex="{Binding RoleIndex, Mode=TwoWay}">
                                                                                            <ComboBoxItem Content="默认" />
                                                                                            <ComboBoxItem Content="作者" />
                                                                                            <ComboBoxItem Content="共创" />
                                                                                            <ComboBoxItem Content="出镜" />
                                                                                        </ComboBox>
                                                                                        <Button Grid.Column="2" Classes="chip-retry"
                                                                                                Content="移除"
                                                                                                Height="24" Padding="8,0"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveKsCoPublishCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="需要账号有共同创作权限（官方发布页没有该入口时，平台会忽略或拒发）" />

                                                                        <Button Classes="chip-retry" Content="清空共创"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasKsCoPublishUsers}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearKsCoPublishCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- @好友（2026-11-15 页面 submit 抓包修正）：落点不是独立字段，
                                                                 caption 里写纯文本 token @昵称(O<userId>)（编辑器 HTML 只用于 autosave）；
                                                                 发布前对每个用户先调 at/choose 登记。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="@好友"
                                                                               ToolTip.Tip="caption 里的纯文本 token @昵称(O&#x3C;userId>); 发布前自动调 at/choose 登记" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding KsMentionDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleKsMentionPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsKsMentionPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding KsMentionQuery}"
                                                                                     Watermark="输入昵称搜索快手用户（空词原样发）" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="搜索"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsKsMentionBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchKsMentionsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding KsMentionStatusText}"
                                                                                   IsVisible="{Binding HasKsMentionStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding KsMentionCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:KsMentionPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <StackPanel Spacing="0"
                                                                                                        VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding UserName}"
                                                                                                           FontSize="12"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Text="{Binding Subtitle}"
                                                                                                           Classes="hint" FontSize="11"
                                                                                                           IsVisible="{Binding HasSubtitle}"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                            </StackPanel>
                                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                                    Content="{Binding PickLabel}"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    IsEnabled="{Binding !IsPicked}"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickKsMentionCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <!-- 已选：点一下移除（候选行的「已选」态按 userId 同步） -->
                                                                        <ItemsControl ItemsSource="{Binding KsMentions}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:KsMentionPickViewModel">
                                                                                    <Button Classes="chip-retry"
                                                                                            Margin="0,0,6,4"
                                                                                            Height="24" Padding="8,0"
                                                                                            ToolTip.Tip="点击移除"
                                                                                            Content="{Binding UserName, StringFormat='@{0} ×'}"
                                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveKsMentionCommand}"
                                                                                            CommandParameter="{Binding}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                        <Button Classes="chip-retry" Content="清除已选 @好友"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasKsMentions}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearKsMentionsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- 专属领域 / 二级领域：平台接口选择器（2026-11-10）——
                                                                 POST upload/domain/list 拉两级领域；不选 = 不下发
                                                                 domain / secondDomain（抓包提交体两字段为空串）。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="专属领域"
                                                                               ToolTip.Tip="submit.domain；留空 = 不下发" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding KsDomainDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleKsDomainPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="二级领域"
                                                                               ToolTip.Tip="submit.secondDomain；留空 = 不下发" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding KsSecondDomainDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleKsDomainPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：专属领域列表 + 选中后的二级领域列表 -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsKsDomainPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBlock Classes="hint"
                                                                                       TextWrapping="Wrap"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="列表来自该账号的平台领域接口；先选专属领域，再按需选二级领域。" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="刷新"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsKsDomainBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RefreshKsDomainsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding KsDomainStatusText}"
                                                                                   IsVisible="{Binding HasKsDomainStatus}" />

                                                                        <ScrollViewer MaxHeight="160"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding KsDomainCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:KsDomainPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding SecondCountText}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickKsDomainCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <!-- 二级领域：只在选中专属领域后出现 -->
                                                                        <StackPanel Spacing="4"
                                                                                    IsVisible="{Binding HasKsSecondDomainCandidates}">
                                                                            <TextBlock Classes="lbl"
                                                                                       Text="{Binding KsSecondDomainCaption}" />
                                                                            <ScrollViewer MaxHeight="140"
                                                                                          VerticalScrollBarVisibility="Auto"
                                                                                          HorizontalScrollBarVisibility="Disabled">
                                                                                <ItemsControl ItemsSource="{Binding KsSecondDomainCandidates}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:KsSecondDomainPickViewModel">
                                                                                            <Grid ColumnDefinitions="*,Auto"
                                                                                                  ColumnSpacing="8" Margin="0,2">
                                                                                                <TextBlock Text="{Binding Name}"
                                                                                                           FontSize="12"
                                                                                                           VerticalAlignment="Center"
                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                <Button Grid.Column="1" Classes="chip-retry"
                                                                                                        Content="选"
                                                                                                        Height="24" Padding="8,0"
                                                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickKsSecondDomainCommand}"
                                                                                                        CommandParameter="{Binding}" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>

                                                                        <Button Classes="chip-retry"
                                                                                Content="清除已选领域"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasKsDomainOrSecond}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearKsDomainsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="关联短剧" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding KuaishouMovieIdText}"
                                                                         Watermark="movieId；留空 = 不关联" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="项目 ID" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding KuaishouProjectIdText}"
                                                                         Watermark="projectId" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 小红书长尾（阶段 2.3）——
                                                     2026-11-10 重排：浅灰分组块 + 行内标签，
                                                     原始 JSON 收进默认收起的「开发者选项」。
                                                     行为不变：字段、绑定、共用章节全部照旧。 -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsXhs}">

                                                    <!-- 文案与章节 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="文案与章节" />

                                                            <StackPanel Spacing="4">
                                                                <TextBox Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ChaptersText}"
                                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                                         VerticalContentAlignment="Top" Padding="10,6"
                                                                         MinHeight="64" MaxHeight="140"
                                                                         Watermark="每行：mm:ss 标题，例如 0:00 开场 / 1:30 实拍" />
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="视频需 ≥15 秒且至少 3 段；与抖音共用同一份章节" />
                                                            </StackPanel>

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding ChapterSyncText}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="章节文字同步" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="视频摘要" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding XhsSummaryText}"
                                                                         ToolTip.Tip="video_info.summary；留空 = 不传"
                                                                         Watermark="留空 = 不传" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 互动与合集 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="互动与合集" />

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding AllowComment}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="允许评论" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <!-- 速览合集：平台接口选择器（2026-11-10）——
                                                                 collection/pc/list?type=1 拉账号的短剧合集；
                                                                 不选 = 不绑定（noteSketchCollectionBind 不下发）。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="速览合集"
                                                                               ToolTip.Tip="noteSketchCollectionBind.id；留空 = 不绑定" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding SketchDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleSketchPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：刷新 / 候选（首次展开自动拉列表） -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsSketchPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBlock Classes="hint"
                                                                                       TextWrapping="Wrap"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="列表来自该账号的平台速览合集；「已满」的不能再加入。" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="刷新"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsSketchBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RefreshSketchCollectionsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding SketchStatusText}"
                                                                                   IsVisible="{Binding HasSketchStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding SketchCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:SketchPickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding EpisodesText}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center"
                                                                                                       IsVisible="{Binding HasEpisodes}" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    IsEnabled="{Binding !IsFull}"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickSketchCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>

                                                                        <!-- 翻页：游标来自上一页最后一条（空 = 到底了，按钮消失） -->
                                                                        <Button Classes="chip-retry" Content="加载更多"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding SketchHasMore}"
                                                                                IsEnabled="{Binding !IsSketchBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreSketchCollectionsCommand}"
                                                                                CommandParameter="{Binding}" />

                                                                        <Button Classes="chip-retry" Content="清除已选合集"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding HasSketch}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearSketchCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 选择群聊（2026-11-15）——
                                                         平台组件「选择群聊」：发布体 business_binds.groupBind =
                                                         {groupId,groupName,desc,avatar}（bundle 逐字）。
                                                         列表来自账号在 App 消息页创建的群聊（group_list），
                                                         打开面板才拉；没有群时显示空态，不拦发布。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="选择群聊" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="群聊"
                                                                           ToolTip.Tip="business_binds.groupBind；留空 = 不关联" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding XhsGroupDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleXhsGroupPanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsXhsGroupPanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                          ColumnSpacing="6">
                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="列表来自该账号在 App 消息页创建的群聊；平台标记「状态异常」的群不能选。" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="刷新"
                                                                                Height="28" Padding="10,0"
                                                                                IsEnabled="{Binding !IsXhsGroupBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RefreshXhsGroupsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding XhsGroupStatusText}"
                                                                               IsVisible="{Binding HasXhsGroupStatus}" />

                                                                    <ScrollViewer MaxHeight="180"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding XhsGroupCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:XhsGroupPickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="{Binding PickLabel}"
                                                                                                Height="24" Padding="8,0"
                                                                                                IsEnabled="{Binding IsLinkable}"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickXhsGroupCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <Button Classes="chip-retry" Content="清除已选群聊"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding HasXhsGroup}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearXhsGroupCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- PK 封面（2026-11-15）——
                                                         平台「设置封面 → PK 封面」：发布体
                                                         video_info.pk_cover_biz_relations =
                                                         [{bizId,bizType:"PK_COVER",extraInfo:"{audit_status,final_cover,width,height,type,url,index}"}]
                                                         （bundle 逐字）。附加图逐张上传，主封面自动用发布封面/首帧当 index=0。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="PK 封面" />

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding XhsPkCoverEnabled}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="启用 PK 封面" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="需要账号有 PK 封面权限（平台侧 features.isPkCover）；主封面自动用上方封面/首帧，下面是附加图。" />

                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{Binding XhsPkCoverDisplay}"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource TextSecondary}" />
                                                                <Button Grid.Column="1" Classes="chip-retry"
                                                                        Content="添加图片"
                                                                        Height="26" Padding="10,0"
                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickXhsPkCoverCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>

                                                            <ItemsControl ItemsSource="{Binding XhsPkCovers}"
                                                                          IsVisible="{Binding HasXhsPkCovers}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:XhsPkCoverItemViewModel">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="8" Margin="0,2">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="12"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip.Tip="{Binding Path}" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="移除"
                                                                                    Height="24" Padding="8,0"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveXhsPkCoverCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Button Classes="chip-retry" Content="清空附加图"
                                                                    HorizontalAlignment="Left"
                                                                    IsVisible="{Binding HasXhsPkCovers}"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearXhsPkCoversCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 视频标记（2026-11-15）——
                                                         平台「标记地点或标记朋友」：发布体 video_info.markers =
                                                         [{type:"video_marks_v2",start,end,detail:{id,style,type,event,container_size,unit_center,anchor_center,markY}}]
                                                         （bundle 逐字）。朋友走 search/label?type=user，地点复用 POI 搜索。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="视频标记" />

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="标记朋友 / 标记地点会显示在视频上（页面同款）；起止时间按秒填，默认 0–5 秒。" />

                                                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="6">
                                                                <ComboBox SelectedIndex="{Binding XhsMarkerTypeIndex}"
                                                                          HorizontalAlignment="Stretch">
                                                                    <ComboBoxItem Content="标记朋友" />
                                                                    <ComboBoxItem Content="标记地点" />
                                                                </ComboBox>
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding XhsMarkerQuery}"
                                                                         Watermark="搜昵称 / 地点关键词…" />
                                                                <Button Grid.Column="2" Classes="sec"
                                                                        Content="搜索"
                                                                        Height="30" Padding="10,0"
                                                                        IsEnabled="{Binding !IsXhsMarkerBusy}"
                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchXhsMarkersCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="{Binding XhsMarkerStatusText}"
                                                                       IsVisible="{Binding HasXhsMarkerStatus}" />

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsXhsMarkerPanelOpen}">
                                                                <ScrollViewer MaxHeight="180"
                                                                              VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Disabled">
                                                                    <ItemsControl ItemsSource="{Binding XhsMarkerCandidates}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:XhsMarkerPickViewModel">
                                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                      ColumnSpacing="8" Margin="0,2">
                                                                                    <StackPanel Spacing="0"
                                                                                                VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   FontSize="12"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                                   Classes="hint" FontSize="11"
                                                                                                   IsVisible="{Binding HasSubtitle}"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding TypeText}"
                                                                                               Classes="hint"
                                                                                               VerticalAlignment="Center" />
                                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                                            Content="标记"
                                                                                            Height="24" Padding="8,0"
                                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickXhsMarkerCommand}"
                                                                                            CommandParameter="{Binding}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </Border>

                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{Binding XhsMarkerDisplay}"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextSecondary}" />
                                                                <Button Grid.Column="1" Classes="chip-retry"
                                                                        Content="选择"
                                                                        Height="26" Padding="10,0"
                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleXhsMarkerPanelCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>

                                                            <ItemsControl ItemsSource="{Binding XhsMarkers}"
                                                                          IsVisible="{Binding HasXhsMarkers}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:XhsMarkerRowViewModel">
                                                                        <Grid ColumnDefinitions="*,70,70,Auto,Auto"
                                                                              ColumnSpacing="6" Margin="0,2">
                                                                            <StackPanel Spacing="0"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontSize="12"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding TypeText}"
                                                                                           Classes="hint" FontSize="11" />
                                                                            </StackPanel>
                                                                            <TextBox Grid.Column="1"
                                                                                     Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding StartText}"
                                                                                     Watermark="起始秒" />
                                                                            <TextBox Grid.Column="2"
                                                                                     Theme="{StaticResource AppInputTheme}"
                                                                                     Text="{Binding EndText}"
                                                                                     Watermark="结束秒" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding DurationText}"
                                                                                       Classes="hint"
                                                                                       VerticalAlignment="Center" />
                                                                            <Button Grid.Column="4" Classes="chip-retry"
                                                                                    Content="移除"
                                                                                    Height="24" Padding="8,0"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveXhsMarkerCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Button Classes="chip-retry" Content="清空标记"
                                                                    HorizontalAlignment="Left"
                                                                    IsVisible="{Binding HasXhsMarkers}"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearXhsMarkersCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 添加路线（2026-11-15）——
                                                         平台组件「添加路线」：路线是独立实体（save/travel 建好再关联）。
                                                         发布体两处：hash_tag 的 {id,name,type:"map_traver"} +
                                                         common.biz_relations 的 POI_MAP_TRAVEL（bundle travelSaved 逐字）。
                                                         路线至少 2 个地点；空 polygon 已被平台接受。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="添加路线" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="路线"
                                                                           ToolTip.Tip="发布体 hash_tag 的 map_traver + biz_relations 的 POI_MAP_TRAVEL；留空 = 不关联" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding XhsRouteDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="添加路线"
                                                                            Height="26" Padding="10,0"
                                                                            IsVisible="{Binding !HasXhsRoute}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleXhsRoutePanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                            Content="清除路线"
                                                                            Height="26" Padding="10,0"
                                                                            IsVisible="{Binding HasXhsRoute}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearXhsRouteCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsXhsRoutePanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="路线至少需要 2 个地点：搜地点 → 逐个添加 → 起名字 → 保存；保存成功后发布时才关联。" />

                                                                    <TextBox Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding XhsRouteName}"
                                                                             Watermark="路线名（必填）" />

                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding XhsRouteQuery}"
                                                                                 Watermark="搜地点关键词…" />
                                                                        <Button Grid.Column="1" Classes="sec"
                                                                                Content="搜索"
                                                                                Height="30" Padding="10,0"
                                                                                IsEnabled="{Binding !IsXhsRouteBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchXhsRoutePoisCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding XhsRouteStatusText}"
                                                                               IsVisible="{Binding HasXhsRouteStatus}" />

                                                                    <ScrollViewer MaxHeight="160"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding XhsRouteCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:XhsRoutePickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="添加"
                                                                                                Height="24" Padding="8,0"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).AddXhsRoutePoiCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <ItemsControl ItemsSource="{Binding XhsRoutePoints}"
                                                                                  IsVisible="{Binding HasXhsRoutePoints}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:XhsRoutePointViewModel">
                                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                      ColumnSpacing="6" Margin="0,2">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="12"
                                                                                               VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding CoordinateText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center" />
                                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                                            Content="移除"
                                                                                            Height="24" Padding="8,0"
                                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveXhsRoutePoiCommand}"
                                                                                            CommandParameter="{Binding}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <Button Classes="sec"
                                                                            Content="{Binding XhsRouteSaveLabel}"
                                                                            HorizontalAlignment="Left"
                                                                            IsEnabled="{Binding !IsXhsRouteBusy}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SaveXhsRouteCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 引用笔记（A5，2026-11-11）——
                                                         平台组件「引用笔记」：发布体 business_binds.optionRelationList
                                                         追加 REF_POST（bizId = 笔记 ID，extraInfo 是字符串化 JSON）。
                                                         列表来自账号已发布笔记（note/user/posted，tab=1），
                                                         打开面板才拉；同一时间只能引用一条。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="引用笔记" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="引用笔记"
                                                                           ToolTip.Tip="发布体 optionRelationList 追加 REF_POST（笔记 ID 来自平台笔记列表）" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding XhsNoteDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleXhsNotePanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsXhsNotePanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                          ColumnSpacing="6">
                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center"
                                                                                   Text="列表来自该账号的已发布笔记；同一时间只能引用一条。" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="刷新"
                                                                                Height="28" Padding="10,0"
                                                                                IsEnabled="{Binding !IsXhsNoteBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RefreshXhsNotesCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding XhsNoteStatusText}"
                                                                               IsVisible="{Binding HasXhsNoteStatus}" />

                                                                    <ScrollViewer MaxHeight="180"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding XhsNoteCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:XhsNotePickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="{Binding PickLabel}"
                                                                                                Height="24" Padding="8,0"
                                                                                                IsEnabled="{Binding !IsPicked}"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickXhsNoteCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <Button Classes="chip-retry" Content="清除已选引用笔记"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding HasXhsNote}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearXhsNoteCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 互动组件 · 投票（A4，2026-11-11）——
                                                         widget 是发布时由 create_interact 现建，
                                                         再把 widget_id 挂进 common.hash_tag；
                                                         这里只存问题与选项文字（零网络）。
                                                         2~5 个选项；没填完预检提示、发布时跳过投票。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="互动组件 · 投票" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="投票问题"
                                                                           ToolTip.Tip="发布时调用 create_interact 现建投票，问题/选项不能为空" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding XhsPollQuestionText}"
                                                                         Watermark="例如：你更喜欢哪种装修风格？" />
                                                            </Grid>

                                                            <StackPanel Spacing="4">
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="2~5 个选项；创建失败不拦发布（这条笔记只是没有投票）。" />

                                                                <ItemsControl ItemsSource="{Binding XhsPollOptions}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:XhsPollOptionViewModel">
                                                                            <Grid ColumnDefinitions="*,Auto"
                                                                                  ColumnSpacing="6" Margin="0,0,0,6">
                                                                                <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                         Text="{Binding Text}"
                                                                                         Watermark="选项文字" />
                                                                                <Button Grid.Column="1" Classes="chip-retry"
                                                                                        Content="删除"
                                                                                        Height="28" Padding="10,0"
                                                                                        Command="{Binding $parent[ItemsControl].((vm:TargetRowViewModel)DataContext).RemoveXhsPollOptionCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Button Classes="chip-retry" Content="添加选项"
                                                                            Height="28" Padding="10,0"
                                                                            IsEnabled="{Binding CanAddXhsPollOption}"
                                                                            Command="{Binding AddXhsPollOptionCommand}" />
                                                                    <Button Classes="chip-retry" Content="清除投票"
                                                                            Height="28" Padding="10,0"
                                                                            IsVisible="{Binding HasXhsPoll}"
                                                                            Command="{Binding ClearXhsPollCommand}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- @用户：平台接口选择器（2026-11-10）——
                                                         平台正文里的 @ 是结构化字段（common.ats）；
                                                         search/user_info 按昵称搜平台用户（真账号抓包实证：
                                                         请求 keyword/search_id/page，响应 user_info_dtos[].user_base_dto）。
                                                         选中只写 common.ats；正文里缺「@昵称」由 XhsCaption 统一补。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="@用户" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="@用户"
                                                                           ToolTip.Tip="common.ats —— 发布时正文里会自动补「@昵称」" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding XhsMentionDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleXhsMentionPanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsXhsMentionPanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                          ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding XhsMentionQuery}"
                                                                                 Watermark="输入昵称搜索用户（留空 = 平台推荐）" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="搜索"
                                                                                Height="28" Padding="10,0"
                                                                                IsEnabled="{Binding !IsXhsMentionBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchXhsMentionsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding XhsMentionStatusText}"
                                                                               IsVisible="{Binding HasXhsMentionStatus}" />

                                                                    <ScrollViewer MaxHeight="180"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding XhsMentionCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:XhsMentionPickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Nickname}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="{Binding PickLabel}"
                                                                                                Height="24" Padding="8,0"
                                                                                                IsEnabled="{Binding !IsPicked}"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickXhsMentionCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <!-- 已选：点一下移除（候选行的「已选」态按用户 ID 同步） -->
                                                                    <ItemsControl ItemsSource="{Binding XhsMentions}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:XhsMentionPickViewModel">
                                                                                <Button Classes="chip-retry"
                                                                                        Margin="0,0,6,4"
                                                                                        Height="24" Padding="8,0"
                                                                                        ToolTip.Tip="点击移除"
                                                                                        Content="{Binding Nickname, StringFormat='@{0} ×'}"
                                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveXhsMentionCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <Button Classes="chip-retry" Content="清除已选 @用户"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding HasXhsMentions}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearXhsMentionsCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

<TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="允许下载映射 noteCopyBind.copyable（用上方全局开关）；原创与内容声明见声明区" />
                                                </StackPanel>

                                                <!-- 视频号长尾（阶段 2.4）——
                                                     2026-11-10 重排：分组块 + 行内标签。行为不变。 -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsWechatVideo}">

                                                    <!-- 文案 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="文案" />

                                                            <StackPanel Spacing="4">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="短标题" />
                                                                    <TextBox Grid.Column="1"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding WechatShortTitleText}"
                                                                             ToolTip.Tip="留空时用标题截取前 20 字"
                                                                             Watermark="留空 = 用标题" />
                                                                </Grid>
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="不足 6 字不下发（页面实测 5 字报「标题至少6个字」）；此时这段文字会自动并入正文首行" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 链接卡片 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="链接卡片" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="扩展链接" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding WechatExternalLinkText}"
                                                                         Watermark="https://…；留空 = 不挂链接卡片" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="链接类型" />
                                                                <ComboBox Grid.Column="1"
                                                                          SelectedIndex="{Binding WechatExtReadingTypeIndex}"
                                                                          Width="150" HorizontalAlignment="Left">
                                                                    <ComboBoxItem Content="公众号文章" />
                                                                    <ComboBoxItem Content="红包封面" />
                                                                </ComboBox>
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="卡片标题" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding WechatExtReadingTitleText}"
                                                                         Watermark="选填（页面输入链接后自动解析）" />
                                                            </Grid>

                                                            <StackPanel Spacing="4">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="卡片样式" />
                                                                    <ComboBox Grid.Column="1"
                                                                              SelectedIndex="{Binding WechatCardShowStyleIndex}"
                                                                              Width="150" HorizontalAlignment="Left">
                                                                        <ComboBoxItem Content="默认" />
                                                                        <ComboBoxItem Content="平铺（1）" />
                                                                        <ComboBoxItem Content="居中（2）" />
                                                                    </ComboBox>
                                                                </Grid>
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="抓包横版视频恒为「居中」；竖版页面可能不下发" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- @好友（2026-11-11 B2：helper_search_finder_account）——
                                                         提交体 objectDesc.mentionedUser=[{nickname}]，
                                                         正文末尾补「@昵称 」（平台只认昵称，username 不进 wire）。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="@好友" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="@好友"
                                                                           ToolTip.Tip="mentionedUser —— 发布时正文末尾自动补「@昵称 」，与 #话题 一样带结尾空格" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding WechatMentionDisplay}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleWechatMentionPanelCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Border Classes="dev-panel"
                                                                    IsVisible="{Binding IsWechatMentionPanelOpen}">
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                          ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding WechatMentionQuery}"
                                                                                 Watermark="输入昵称搜索视频号（留空原样发给平台）" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="搜索"
                                                                                Height="28" Padding="10,0"
                                                                                IsEnabled="{Binding !IsWechatMentionBusy}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SearchWechatMentionsCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>

                                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                               Text="{Binding WechatMentionStatusText}"
                                                                               IsVisible="{Binding HasWechatMentionStatus}" />

                                                                    <ScrollViewer MaxHeight="180"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Disabled">
                                                                        <ItemsControl ItemsSource="{Binding WechatMentionCandidates}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:WechatMentionPickViewModel">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="8" Margin="0,2">
                                                                                        <StackPanel Spacing="0"
                                                                                                    VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding Nickname}"
                                                                                                       FontSize="12"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                       Classes="hint" FontSize="11"
                                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                                Content="{Binding PickLabel}"
                                                                                                Height="24" Padding="8,0"
                                                                                                IsEnabled="{Binding !IsPicked}"
                                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickWechatMentionCommand}"
                                                                                                CommandParameter="{Binding}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>

                                                                    <!-- 已选：点一下移除（候选行的「已选」态按昵称同步） -->
                                                                    <ItemsControl ItemsSource="{Binding WechatMentions}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:WechatMentionPickViewModel">
                                                                                <Button Classes="chip-retry"
                                                                                        Margin="0,0,6,4"
                                                                                        Height="24" Padding="8,0"
                                                                                        ToolTip.Tip="点击移除"
                                                                                        Content="{Binding Nickname, StringFormat='@{0} ×'}"
                                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveWechatMentionCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <Button Classes="chip-retry" Content="清除已选 @好友"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding HasWechatMentions}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearWechatMentionsCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <StackPanel Spacing="3">
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="· 未选位置时整个 location 字段不下发；内容标注跟随上方「内容声明」（tagKey 运行时按账号现取）" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="· 封面：选了封面图就先图片直传、没选就自动抽首帧；发布后要换封面需到创作中心「修改封面」手动操作（保存接口待抓包）" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="· 视频号没有标题字段；可见性只有公开 / 仅自己（发布后设置），当前恒公开" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- B站（阶段 4.6）——
                                                     2026-11-10 重排：分组块 + 行内标签；九个开关改用带底色的 chip
                                                     （原先用 check-row 却没画勾选框，选中/未选中在界面上完全一样）。
                                                     行为不变：分区只读展示（params.txt 可覆盖），原创/可见性走全局卡。 -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsBilibili}">

                                                    <!-- 标签与分区 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="标签与分区" />

                                                            <StackPanel Spacing="4">
                                                                <TextBlock Classes="lbl"
                                                                           Text="标签（1~10 个，逗号分隔）" />
                                                                <TextBox Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding BilibiliTagsText}"
                                                                         Watermark="家居, 室内设计, 家装" />
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="投稿至少要 1 个；标签 ≠ 话题 —— 话题要用带平台 ID 的结构化话题（全局话题卡「获取平台推荐」，或 params.txt 写「话题ID」）" />
                                                            </StackPanel>

                                                            <!-- 分区：平台列表选择器（2026-11-10）——
                                                                 投稿页「分区」下拉 = add_v3.human_type2（30 个领域，平台 list 接口）。
                                                                 旧版 tid 保持默认 / params 覆盖（typelist 只回父分区，映射未知）。 -->
                                                            <StackPanel Spacing="6">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="分区"
                                                                               ToolTip.Tip="add_v3.human_type2 ← 平台 human/type2/list" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                        <TextBlock Text="{Binding BilibiliPartitionDisplay}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="1" Classes="chip-retry"
                                                                                Content="选择"
                                                                                Height="26" Padding="10,0"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleBiliPartitionPanelCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- 展开：刷新 / 候选 -->
                                                                <Border Classes="dev-panel"
                                                                        IsVisible="{Binding IsBiliPartitionPanelOpen}">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBlock Classes="hint"
                                                                                       TextWrapping="Wrap"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="平台投稿页的「分区」列表（1001~1031）。" />
                                                                            <Button Grid.Column="1" Classes="chip-retry"
                                                                                    Content="刷新"
                                                                                    Height="28" Padding="10,0"
                                                                                    IsEnabled="{Binding !IsBiliPartitionBusy}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RefreshBiliPartitionsCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>

                                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                                   Text="{Binding BiliPartitionStatusText}"
                                                                                   IsVisible="{Binding HasBiliPartitionStatus}" />

                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                            <ItemsControl ItemsSource="{Binding BiliPartitionCandidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:BiliTypePickViewModel">
                                                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                              ColumnSpacing="8" Margin="0,2">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding Id}"
                                                                                                       Classes="hint"
                                                                                                       VerticalAlignment="Center" />
                                                                                            <Button Grid.Column="2" Classes="chip-retry"
                                                                                                    Content="选"
                                                                                                    Height="24" Padding="8,0"
                                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickBiliPartitionCommand}"
                                                                                                    CommandParameter="{Binding}" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                    </StackPanel>
                                                                </Border>

                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="{Binding BilibiliTidHint}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 投稿选项：九个开关排两列（与快手「创作辅助」同款）。
                                                         2026-11-10 第二版：原先的 chip 流式换行每行个数不齐、宽窄不一，
                                                         在 340px 栏里像一排碎标签；改成等宽两列勾选栅格。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="投稿选项" />
                                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                                  RowSpacing="2">

                                                                <ToggleButton Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding BilibiliWatermark}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="水印" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Column="1" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding BilibiliAllowComment}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="允许评论" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="1" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding BilibiliAllowDanmaku}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="允许弹幕" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="1" Grid.Column="1"
                                                                              Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding BilibiliUpSelectionReply}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="精选评论" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="2" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding BilibiliNoReprint}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="禁止转载" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="2" Grid.Column="1"
                                                                              Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding BilibiliActReserve}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="预约" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="3" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding BilibiliInteractive}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="互动视频" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="3" Grid.Column="1"
                                                                              Classes="check-row" Padding="2,3"
                                                                              IsChecked="{Binding BilibiliDolby}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="杜比音效" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>

                                                                <ToggleButton Grid.Row="4" Classes="check-row"
                                                                              Padding="2,3"
                                                                              IsChecked="{Binding BilibiliLosslessMusic}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <Border Classes="tick" Width="14" Height="14">
                                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Classes="tick-check"
                                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                      Fill="White" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                        </Border>
                                                                        <TextBlock Text="无损音乐" FontSize="12"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 字幕与互动卡片（B5，2026-11-15）——
                                                         字幕：本地 .srt，发布时两步上传
                                                         （upload/web/image → subtitle/draft/preSave），
                                                         发布体只落 videos[0].pre_subtitle。
                                                         卡片：互动引导 / 关联视频 / 投票弹幕三类，
                                                         发布前按 cid 建卡片，发布体落
                                                         videos[0].pre_command。
                                                         ⚠️ 卡片前置 = 视频 h264/mp4（其它格式投稿页按钮本来灰）。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="字幕与互动卡片" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="字幕文件"
                                                                           ToolTip.Tip="只支持 .srt；发布时上传并挂到稿件（pre_subtitle）" />
                                                                <Grid Grid.Column="1"
                                                                      ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding BilibiliSubtitleFileDisplay}"
                                                                               FontSize="11.5"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{StaticResource TextSecondary}" />
                                                                    <Button Grid.Column="1" Classes="chip-retry"
                                                                            Content="选择"
                                                                            Height="26" Padding="10,0"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickBilibiliSubtitleCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                            Content="清除"
                                                                            Height="26" Padding="10,0"
                                                                            IsVisible="{Binding HasBilibiliSubtitleFile}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearBilibiliSubtitleCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="字幕语言"
                                                                           ToolTip.Tip="preSave files[].lan；zh / en / ja…，留空 = zh" />
                                                                <TextBox Grid.Column="1" Width="90"
                                                                         HorizontalAlignment="Left"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding BilibiliSubtitleFileLanText}"
                                                                         Watermark="zh" />
                                                            </Grid>

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding BilibiliGuideCardEnabled}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="互动引导卡片（关注 / 三连）" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <StackPanel Spacing="8"
                                                                        IsVisible="{Binding ShowBilibiliGuideCardOptions}">
                                                                <ItemsControl ItemsSource="{Binding BilibiliGuideCardOptions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:BilibiliGuideCardOptionViewModel">
                                                                            <ToggleButton Classes="radio-row"
                                                                                          Padding="6,4"
                                                                                          Margin="0,0,8,4"
                                                                                          IsChecked="{Binding IsSelected}"
                                                                                          Command="{Binding $parent[ItemsControl].((vm:TargetRowViewModel)DataContext).SelectBilibiliGuideCardCommand}"
                                                                                          CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Border Classes="radio">
                                                                                        <Border Classes="radio-core"
                                                                                                Width="8" Height="8"
                                                                                                CornerRadius="4"
                                                                                                Background="White"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                                                               VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </ToggleButton>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="卡片时间"
                                                                               ToolTip.Tip="卡片出现的起始时间（下发 progress 毫秒）；写法 mm:ss 或秒数" />
                                                                    <TextBox Grid.Column="1" Width="90"
                                                                             HorizontalAlignment="Left"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliGuideCardStartText}"
                                                                             Watermark="00:00" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <!-- 卡片 v2：关联视频（type=2，wire §4.1）——
                                                                 create 体字段名是 oid（BVID 字符串）；
                                                                 目标稿件「仅自己」时平台回 79025。 -->
                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding BilibiliRelatedVideoEnabled}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="关联视频卡片（跳到另一个稿件）" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <StackPanel Spacing="8"
                                                                        IsVisible="{Binding ShowBilibiliRelatedVideoOptions}">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="目标 BVID"
                                                                               ToolTip.Tip="create 体字段名是 oid；目标稿件「仅自己」时平台会拒（79025）" />
                                                                    <TextBox Grid.Column="1"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliRelatedVideoBvidText}"
                                                                             Watermark="BV1xx…" />
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="描述" />
                                                                    <TextBox Grid.Column="1"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliRelatedVideoMsgText}"
                                                                             Watermark="选填；创建体 msg" />
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="卡片时间"
                                                                               ToolTip.Tip="卡片出现的起始时间（下发 progress 毫秒）；写法 mm:ss 或秒数" />
                                                                    <TextBox Grid.Column="1" Width="90"
                                                                             HorizontalAlignment="Left"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliRelatedVideoStartText}"
                                                                             Watermark="00:00" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <!-- 卡片 v2：投票弹幕（type=9，wire §4.2）——
                                                                 问题 ≤12 字、选项 2~4 个且 ≤6 字、不许含分号 / 重复。 -->
                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding BilibiliVoteEnabled}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="投票弹幕" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <StackPanel Spacing="8"
                                                                        IsVisible="{Binding ShowBilibiliVoteOptions}">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="问题"
                                                                               ToolTip.Tip="最多 12 个字" />
                                                                    <TextBox Grid.Column="1"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliVoteQuestionText}"
                                                                             Watermark="例如：你最喜欢哪种视频" />
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="选项 A/B"
                                                                               ToolTip.Tip="必填；每个最多 6 个字，不能含分号，不能重复" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,*" ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding BilibiliVoteOptionAText}"
                                                                                 Watermark="选项 A（必填）" />
                                                                        <TextBox Grid.Column="1"
                                                                                 Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding BilibiliVoteOptionBText}"
                                                                                 Watermark="选项 B（必填）" />
                                                                    </Grid>
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="选项 C/D"
                                                                               ToolTip.Tip="可选；必须从 A 开始连续填写（C 为空时不能只填 D）" />
                                                                    <Grid Grid.Column="1"
                                                                          ColumnDefinitions="*,*" ColumnSpacing="6">
                                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding BilibiliVoteOptionCText}"
                                                                                 Watermark="选项 C（可选）" />
                                                                        <TextBox Grid.Column="1"
                                                                                 Theme="{StaticResource AppInputTheme}"
                                                                                 Text="{Binding BilibiliVoteOptionDText}"
                                                                                 Watermark="选项 D（可选）" />
                                                                    </Grid>
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="卡片时间"
                                                                               ToolTip.Tip="卡片出现的起始时间（下发 progress 毫秒）；写法 mm:ss 或秒数" />
                                                                    <TextBox Grid.Column="1" Width="90"
                                                                             HorizontalAlignment="Left"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliVoteStartText}"
                                                                             Watermark="00:00" />
                                                                </Grid>

                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="持续时长"
                                                                               ToolTip.Tip="时间轴选区长度（秒），下发 create 体 duration（毫秒）" />
                                                                    <TextBox Grid.Column="1" Width="66"
                                                                             HorizontalAlignment="Left"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding BilibiliVoteDurationText}"
                                                                             Watermark="7" />
                                                                </Grid>
                                                            </StackPanel>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="卡片只在 H.264 MP4 视频上可用（其它格式投稿页按钮本身是灰的）；卡片建不出来不拦稿件。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 其他参数 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="其他参数" />

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="动态文案" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding BilibiliDynamicText}"
                                                                         Watermark="选填；发布后同步到动态" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="预约标题" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding BilibiliActReserveTitleText}"
                                                                         Watermark="选填（开启预约时填写）" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="AI 封面"
                                                                           ToolTip.Tip="投稿体 aid_cover 开关（1/0）" />
                                                                <TextBox Grid.Column="1" Width="66"
                                                                         HorizontalAlignment="Left"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding BilibiliAiCoverText}"
                                                                         Watermark="0" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="空间隐藏"
                                                                           ToolTip.Tip="抓包默认 2；留空按 2 发送" />
                                                                <TextBox Grid.Column="1" Width="66"
                                                                         HorizontalAlignment="Left"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding BilibiliSpaceHiddenText}"
                                                                         Watermark="2" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 定时发布窗口：距当前 5 分钟 ~ 15 天（日期时间在左侧公共区设置）" />
                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 封面：选了封面图就先上传；没选就自动抽首帧再裁 16:9 / 4:3 两张" />
                                                </StackPanel>

                                                <!-- 头条（阶段 5.6 / A1 / A2）——
                                                     2026-11-10 重排：分组块 + 行内标签；2026-11-11 起删除
                                                     商品 / 懂车帝 / 长尾属性 / 埋点 4 项原始 JSON（用户决定），
                                                     模型字段与 params 透传保留。赞赏开关补上勾选框（原来
                                                     check-row 没画 tick，选中态在界面上看不出来）。
                                                     原创/合集/可见性走全局卡；作品声明与视频生成图文在卡内。 -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsToutiao}">

                                                    <!-- 文案与链接 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="文案与链接" />

                                                            <StackPanel Spacing="4">
                                                                <TextBlock Classes="lbl" Text="标签（逗号分隔）" />
                                                                <TextBox Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoTagsText}"
                                                                         Watermark="家居, 装修" />
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="下发为 Label 数组（平台会静默忽略，正文 #话题 才是落点）；与 B站标签同源（按账号存）" />
                                                            </StackPanel>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="扩展链接" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoExternalLinkText}"
                                                                         Watermark="选填（ExternalLink）" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="封面标题" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoCoverTitleText}"
                                                                         Watermark="选填（CoverTitles，单个）" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 作品声明（A1，2026-11-10 抓包）：页面 7 个复选实际是单选组。
                                                         「跟随全局」吃左栏「内容声明」；平台专有只在这里选
                                                         （投资观点 / 健康医疗全局枚举里没有）。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="作品声明" />

                                                            <ItemsControl ItemsSource="{Binding ToutiaoDeclarationOptions}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ToutiaoDeclarationOptionViewModel">
                                                                        <ToggleButton Classes="radio-row" Padding="6,4"
                                                                                      Margin="0,0,12,6"
                                                                                      IsChecked="{Binding IsSelected}"
                                                                                      Command="{Binding $parent[ItemsControl].((vm:TargetRowViewModel)DataContext).SelectToutiaoDeclarationCommand}"
                                                                                      CommandParameter="{Binding}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <Border Classes="radio">
                                                                                    <Border Classes="radio-core"
                                                                                            Width="8" Height="8"
                                                                                            CornerRadius="4"
                                                                                            Background="White"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                                                           VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </ToggleButton>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="{Binding ToutiaoDeclarationFollowHint}" />

                                                            <StackPanel Spacing="8"
                                                                        IsVisible="{Binding ShowToutiaoComplianceCreativeInfo}">
                                                                <Grid Classes="field-line"
                                                                      ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                    <TextBlock Text="拍摄城市" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Column="1"
                                                                             Theme="{StaticResource AppInputTheme}"
                                                                             Text="{Binding ToutiaoComplianceCityText}"
                                                                             Watermark="自行拍摄必填，如：苏州" />
                                                                </Grid>
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <TextBlock Text="拍摄时间" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                    <DatePicker Theme="{StaticResource AppDatePickerTheme}"
                                                                                HorizontalAlignment="Left"
                                                                                SelectedDate="{Binding ToutiaoComplianceDate}" />
                                                                    <TimePicker Theme="{StaticResource AppTimePickerTheme}"
                                                                                SelectedTime="{Binding ToutiaoComplianceClock}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="单选 · 「跟随全局」按左栏内容声明映射；头条没有「营销推广」声明。「引用站内」暂未开放（平台 Position 结构未抓全）。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 创作设置 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="创作设置" />

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding ToutiaoPraise}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="开启赞赏" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <!-- 赞赏能不能用由账号权限决定：HasPraisePermission=false 时
                                                                 平台不显示开关、提交的 Praise=true 被静默忽略。
                                                                 按需查一次 GetPublishAuth，把结论摆出来。 -->
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Classes="chip-retry" Content="检查账号权限"
                                                                        IsEnabled="{Binding !IsToutiaoAuthBusy}"
                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).CheckToutiaoAuthCommand}"
                                                                        CommandParameter="{Binding}" />
                                                                <TextBlock Classes="hint" VerticalAlignment="Center"
                                                                           Text="赞赏 / 原创 / 视频生成图文是否可用" />
                                                            </StackPanel>
                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="{Binding ToutiaoAuthStatusText}"
                                                                       IsVisible="{Binding HasToutiaoAuthStatus}" />

                                                            <!-- 视频生成图文（A2，2026-11-10 抓包）：
                                                                 0 = 不下发；1 = 与视频同时发布；2 = 仅保存草稿 -->
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Classes="lbl" Text="视频生成图文" />
                                                                <ItemsControl ItemsSource="{Binding ToutiaoTransArticleOptions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ToutiaoTransArticleOptionViewModel">
                                                                            <ToggleButton Classes="radio-row" Padding="6,4"
                                                                                          Margin="0,0,12,6"
                                                                                          IsEnabled="{Binding IsEnabled}"
                                                                                          IsChecked="{Binding IsSelected}"
                                                                                          Command="{Binding $parent[ItemsControl].((vm:TargetRowViewModel)DataContext).SelectToutiaoTransArticleCommand}"
                                                                                          CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <Border Classes="radio">
                                                                                        <Border Classes="radio-core"
                                                                                                Width="8" Height="8"
                                                                                                CornerRadius="4"
                                                                                                Background="White"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                                                               VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </ToggleButton>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                           Text="与视频同时发布＝额外生成一篇图文；仅保存草稿需视频本身也存草稿，当前发布流程不支持「存草稿」，该选项暂置灰（平台会静默忽略）。页面的偏好记忆接口不下发。" />
                                                            </StackPanel>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="模板名" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoTemplateText}"
                                                                         Watermark="通常留空（封面编辑器元数据）" />
                                                            </Grid>

                                                            <Grid Classes="field-line"
                                                                  ColumnDefinitions="72,*" ColumnSpacing="8">
                                                                <TextBlock Text="滤镜名" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoFilterText}"
                                                                         Watermark="通常留空（封面编辑器元数据）" />
                                                            </Grid>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="模板名 / 滤镜名是平台「编辑封面」里选的文字模板与滤镜（TemplateName / FilterName）—— 本工具上传现成封面，通常留空；填了也只作为封面元数据下发，不会套用到画面上。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 互动贴纸（A3，2026-11-10 抓包）：v1 只做「关注引导」。
                                                         发布前调 /ixigua/api/int/sticker/create 现建贴纸，
                                                         ID 并入 AttrsValueMap.InteractStickers + etData.stickerETData。 -->
                                                    <Border Classes="opt-group">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Classes="group-cap" Text="互动贴纸" />

                                                            <ToggleButton Classes="check-row" Padding="2,3"
                                                                          IsChecked="{Binding ToutiaoFollowSticker}">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Classes="tick" Width="14" Height="14">
                                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                            <Path Classes="tick-check"
                                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                                  Fill="White" Stretch="Uniform" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <TextBlock Text="关注引导" FontSize="12"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <Grid ColumnDefinitions="60,80,84,80" ColumnSpacing="8"
                                                                  IsVisible="{Binding ToutiaoFollowSticker}">
                                                                <TextBlock Text="开始秒" FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoStickerStartText}"
                                                                         Watermark="默认 0" />
                                                                <TextBlock Grid.Column="2" Text="持续秒" FontSize="12"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="3"
                                                                         Theme="{StaticResource AppInputTheme}"
                                                                         Text="{Binding ToutiaoStickerDurationText}"
                                                                         Watermark="默认 5" />
                                                            </Grid>

                                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                       Text="视频上引导观众关注你。页面限制：只支持横版视频且时长 ≥10 秒（不满足时预检会提示）；贴纸创建失败不会影响发布。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 横版 / 竖版按视频宽高自动判定；竖版没有简介、定时与视频合集，合集只在横版生效" />
                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 封面必填：没选就自动抽首帧；作品声明按 ComplianceInfo 下发（单选）" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Stretch">
                    <Button Classes="ghost" Content="全部选中" HorizontalAlignment="Left" />
                    <Button Classes="ghost" Content="全部取消" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图三：发布预设 ═══
        ════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowPresets}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,0,6,0">
                <!-- 空态：预设是按账号存的，没账号就一行都没有 —— 得说清楚为什么是白页 -->
                <Border Background="#F7F8FA" CornerRadius="12" Padding="20,16"
                        IsVisible="{Binding !PresetRows.Count}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="还没有可配置的账号" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="发布预设是「每个平台账号一套默认值」。先去「平台账号」页登录至少一个账号，回来这里就能配置；配好之后，导入的条目会自动套用，不必每条都填位置 / 合集 / 话题 / 声明 / 可见性。" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding PresetRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetRowViewModel">
                            <Border Classes="mock-card" Padding="16,14" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="pf-badge" Width="20" Height="20"
                                            Background="{Binding BrandHex}">
                                        <TextBlock Text="{Binding Initial}" FontSize="10"
                                                   FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding PlatformName}" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SummaryText}" Classes="hint"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="sec" Content="编辑"
                                            Height="30" FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).EditPresetCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="字段总数没变，但编辑负担从「50 × 20」变成「配置一次 + 3 × 20」—— 同一账号总是挂同一个合集、同一个位置、同一组话题。" />
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图四：账号排序 ═══
        ════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowOrder}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="0" Margin="0,0,6,0">
                <!-- 空态：顺序是按账号排的，没账号就没得排 -->
                <Border Background="#F7F8FA" CornerRadius="12" Padding="20,16"
                        IsVisible="{Binding !HasAccounts}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="还没有可排序的账号" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="先去「平台账号」页登录至少一个账号，回来这里就能排；排好之后，工作台的「发布到」、账号坞标签条、平台账号页都会按这个顺序显示。" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding OrderRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountOrderRowViewModel">
                            <StackPanel>
                                <!-- 组头：只画在**每组首行**上方（扁平列表 + 首行带组头，
                                     不用嵌套 ItemsControl —— 嵌套会让 $parent[ItemsControl]
                                     命中内层，下面所有命令绑定都会错位） -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                      Margin="0,12,0,8" IsVisible="{Binding IsGroupFirst}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4"
                                                Background="{Binding BrandHex}" />
                                        <TextBlock Text="{Binding PlatformName}" FontSize="13.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="icon-btn" IsEnabled="{Binding !IsFirstGroup}"
                                                ToolTip.Tip="整组上移（带上该平台的全部账号）"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveGroupUpCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,18.41L12,13.83L16.59,18.41L18,17L12,11L6,17L7.41,18.41M7.41,12.41L12,7.83L16.59,12.41L18,11L12,5L6,11L7.41,12.41Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                        <Button Classes="icon-btn" IsEnabled="{Binding !IsLastGroup}"
                                                ToolTip.Tip="整组下移（带上该平台的全部账号）"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveGroupDownCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,5.59L12,10.17L16.59,5.59L18,7L12,13L6,7L7.41,5.59M7.41,11.59L12,16.17L16.59,11.59L18,13L12,19L6,13L7.41,11.59Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Classes="mock-card" Padding="12,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                          ColumnSpacing="10">
                                        <Border Classes="pf-badge" Width="18" Height="18"
                                                Background="{Binding BrandHex}">
                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                       FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Classes="pill"
                                                    Background="{StaticResource BrandSoft}"
                                                    IsVisible="{Binding ShowPrimary}">
                                                <TextBlock Classes="pill-text" Text="主号"
                                                           Foreground="{StaticResource BrandActive}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="icon-btn"
                                                IsEnabled="{Binding !IsGroupFirst}"
                                                ToolTip.Tip="同平台内上移"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveAccountUpCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                        <Button Grid.Column="4" Classes="icon-btn"
                                                IsEnabled="{Binding !IsLastInGroup}"
                                                ToolTip.Tip="同平台内下移"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveAccountDownCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" Margin="0,4,0,10" TextWrapping="Wrap"
                           IsVisible="{Binding HasAccounts}"
                           Text="顺序只是显示偏好，改它不会动到任何已配置的内容（合集 / 位置 / 话题 / 可见性都按账号记，与次序无关）。新登录的账号会自动落进所属平台那一组，不会把分组打散。" />
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 常驻底栏（提交后不跳页；编辑器态显示保存） ═══
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" BorderBrush="{StaticResource LineBorder}" BorderThickness="0,1,0,0"
                Padding="0,12,0,0" Margin="0,14,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{Binding FooterText}" FontSize="12.5" FontWeight="SemiBold"
                               IsVisible="{Binding ShowWorkbench}" />
                    <TextBlock Text="{Binding StatusText}" Classes="hint"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding SubmitProgress}" Maximum="100" Height="4"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding SubmitMessage}" FontSize="12"
                               Foreground="{StaticResource BrandActive}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="sec" Content="恢复账号默认" Height="34" FontSize="12"
                            IsVisible="{Binding ShowEditor}"
                            Command="{Binding ResetToAccountDefaultsCommand}" />
                    <Button Classes="sec" Content="保存" Height="34" FontSize="12"
                            IsVisible="{Binding ShowEditor}"
                            Command="{Binding SaveEditorCommand}" />
                    <Button Classes="cta" Content="提交到队列" Height="38" Padding="24,0"
                            IsVisible="{Binding ShowWorkbench}"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding SubmitCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
