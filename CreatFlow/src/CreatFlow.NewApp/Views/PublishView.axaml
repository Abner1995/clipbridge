<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             xmlns:models="using:CreatFlow.NewApp.Models"
             xmlns:svc="using:CreatFlow.NewApp.Services"
             xmlns:conv="using:CreatFlow.NewApp.Converters"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="1216" d:DesignHeight="860"
             x:Class="CreatFlow.NewApp.Views.PublishView"
             x:DataType="vm:PublishViewModel">

    <!-- 发布页 —— 整页三视图（工作台 ⇄ 条目编辑器 ⇄ 发布预设），互斥根节点。
         视觉基线沿用样机（PublishMockView，已评审）：白卡浮于白底、深度由描边 + 双层投影给、
         状态零 emoji 走色点。自绘勾选盒/单选圈/折叠箭头（Semi 主题原色非品牌紫；且凡自定义内容的
         ToggleButton 都必须显式给 Template，否则 :checked 会被 Semi 画出勾选框顶掉内容）。 -->

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />

        <ControlTemplate x:Key="RowTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                <ContentPresenter Name="RowContent"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="IconToggleTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter Name="IconContent"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="PlainButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter Name="PlainButtonContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ─── 按钮速记 ─── -->
        <Style Selector="Button.cta">
            <Setter Property="Theme" Value="{StaticResource CtaButtonTheme}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.sec">
            <Setter Property="Theme" Value="{StaticResource SecondaryButtonTheme}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Theme" Value="{StaticResource DangerButtonTheme}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.ghost:pressed">
            <Setter Property="Background" Value="#E5E6EB" />
        </Style>

        <!-- 正方形图标按钮（排序页的上下移）。禁用态必须压 Opacity：
             图标是模板里的 Path、Fill 写死，改 Foreground 不会让它变灰 -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
        </Style>
        <Style Selector="Button.icon-btn:pressed">
            <Setter Property="Background" Value="#E5E6EB" />
        </Style>
        <Style Selector="Button.icon-btn:disabled">
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="Button.chip-retry">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.chip-retry:pointerover">
            <Setter Property="Background" Value="#ECE7FD" />
        </Style>
        <Style Selector="Button.chip-retry:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- ─── 文字 ─── -->
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.sec-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.issue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ─── 状态胶囊 ─── -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.pill-text">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- ─── 卡片 ─── -->
        <Style Selector="Border.mock-card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EDEFF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #0D000000, 0 4 12 0 #08000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.mock-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BrandSoftBorder}" />
            <Setter Property="BoxShadow" Value="0 2 6 0 #14000000, 0 10 24 0 #10000000" />
        </Style>

        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,16" />
        </Style>

        <Style Selector="Border.thumb">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pf-badge">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.resolve-row">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- ─── 自绘勾选盒 ─── -->
        <Style Selector="ToggleButton.check-row">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <!-- ⚠️ Foreground 必须显式钉住：Semi 的 ToggleButton 在 :checked 下把前景刷成白色
                 （为「填色胶囊」设计），而本模板是透明底的勾选盒 —— 不钉住的话
                 勾选行的**文字会变成白色**、在白卡上直接看不见（实测踩坑）。 -->
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.check-row:checked">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.check-row:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.check-row:pointerover">
            <Setter Property="Background" Value="#F7F8FA" />
        </Style>
        <Style Selector="Border.tick">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.check-row:not(:checked) Border.tick">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
        </Style>
        <Style Selector="ToggleButton.check-row:checked Border.tick">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
        </Style>
        <Style Selector="ToggleButton.check-row:not(:checked) Path.tick-check">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ─── 自绘单选圈 ─── -->
        <Style Selector="ToggleButton.radio-row">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 同 check-row：不钉住 Foreground，选中项的文字会被 Semi 刷成白色而看不见 -->
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.radio-row:checked">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.radio-row:pointerover">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Border.radio">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.radio-row:not(:checked) Border.radio">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
        </Style>
        <Style Selector="ToggleButton.radio-row:checked Border.radio">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
        </Style>
        <Style Selector="ToggleButton.radio-row:not(:checked) Border.radio-core">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ─── 全局目标芯片 ─── -->
        <Style Selector="ToggleButton.chip">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked)">
            <Setter Property="Background" Value="#F7F8FA" />
        </Style>
        <Style Selector="ToggleButton.chip:checked">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
        </Style>
        <Style Selector="ToggleButton.chip:pointerover">
            <Setter Property="Background" Value="#EFF1F4" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="ToggleButton.chip:checked TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) Path.chip-check">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) Border.chip-dot">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- ─── 分组组条（2026-10-14：点一格 = 只勾选该组账号；与 ComposeView 同款，改一处同步另一处） ─── -->
        <Style Selector="Button.group-chip">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.group-chip:pointerover">
            <Setter Property="Background" Value="#EFF1F4" />
        </Style>
        <Style Selector="Button.group-chip.active">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
        </Style>
        <Style Selector="Button.group-chip.active:pointerover">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
        </Style>
        <Style Selector="Button.group-chip:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- ─── 展开箭头（自绘模板，否则 :checked 会被 Semi 画出勾选框） ─── -->
        <Style Selector="ToggleButton.chev">
            <Setter Property="Template" Value="{StaticResource IconToggleTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.chev:pointerover">
            <Setter Property="Background" Value="#F2F3F5" />
        </Style>
        <Style Selector="ToggleButton.chev Path.chev-icon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        </Style>
        <Style Selector="ToggleButton.chev:checked Path.chev-icon">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="180" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── 编辑器右栏平台卡 ─── -->
        <Style Selector="Border.target-card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EDEFF3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.field-row">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- 被本条覆盖过账号预设的字段 —— 左侧品牌紫竖条 -->
        <Style Selector="Border.overridden">
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>

        <!-- 预检问题行 -->
        <Style Selector="Border.issue-error">
            <Setter Property="Background" Value="#FDECEA" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.issue-warn">
            <Setter Property="Background" Value="#FFF3E8" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="36,26,36,18">

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 页头（工作台 / 编辑器 / 预设 三态各一套） ═══
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
              Margin="0,0,0,16" IsVisible="{Binding ShowWorkbench}">
            <Border Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20H19V18H5V20Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="发布视频" FontSize="20" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="导入文件夹即成为一个发布单元；params.txt 里写了的（标题/简介/话题/位置/合集/声明…）逐条生效，其余走账号预设"
                           FontSize="12" 
                           Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Border Classes="pill" Background="#FFF3E8" IsVisible="{Binding HasAccountAlerts}">
                    <TextBlock Classes="pill-text" Text="账号异常" Foreground="#B45F06" />
                </Border>
                <Button Classes="sec" Content="发布预设" Height="30" FontSize="12"
                        Command="{Binding ShowPresetsViewCommand}" />
                <Button Classes="sec" Content="账号排序" Height="30" FontSize="12"
                        Command="{Binding ShowOrderViewCommand}" />
                <Button Classes="sec" Content="清空" Height="30" FontSize="12"
                        Command="{Binding ClearDraftsCommand}"
                        IsEnabled="{Binding HasDrafts}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12"
              Margin="0,0,0,16" IsVisible="{Binding ShowEditor}">
            <Button Classes="ghost" Width="34" Height="34" Padding="0"
                    Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding BackToListCommand}" ToolTip.Tip="返回待发布列表">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                </Viewbox>
            </Button>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20H19V18H5V20Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="内容字段每条填一次；位置/话题一次输入多平台并行解析；平台差异留在右侧卡片里"
                           FontSize="12" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="sec" Content="发布预设" Height="30" FontSize="12"
                        Command="{Binding ShowPresetsViewCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12"
              Margin="0,0,0,16" IsVisible="{Binding ShowPresets}">
            <Button Classes="ghost" Width="34" Height="34" Padding="0"
                    Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding BackToListCommand}" ToolTip.Tip="返回工作台">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                </Viewbox>
            </Button>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="发布预设" FontSize="20" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="每个平台账号一套默认值，导入条目时自动套用 —— 字段不必每条都填"
                           FontSize="12" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12"
              Margin="0,0,0,16" IsVisible="{Binding ShowOrder}">
            <Button Classes="ghost" Width="34" Height="34" Padding="0"
                    Background="Transparent" VerticalAlignment="Center"
                    Command="{Binding BackToListCommand}" ToolTip.Tip="返回工作台">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                </Viewbox>
            </Button>
            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21"
                    Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <Viewbox Width="20" Height="20" Stretch="Uniform"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z"
                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="账号排序" FontSize="20" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Text="整组移动带上该平台的全部账号；行级上下移只在同平台内换位 —— 顺序即时生效，工作台 / 账号坞 / 平台页一起变"
                           FontSize="12" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <Button Grid.Column="3" Classes="sec" Content="恢复默认顺序" Height="30" FontSize="12"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding HasAccounts}"
                    Command="{Binding ResetAccountOrderCommand}" />
        </Grid>

        <!-- ═══ 账号窗口未打开提示（发布前必读：窗口没开=凭证是旧的，发布会报错）═══
             只在工作台/编辑器两屏显示；不代开窗口（平台有扫码/风控，必须用户自己点开） -->
        <Border Grid.Row="1" Background="{StaticResource BrandSoft}"
                BorderBrush="{StaticResource BrandSoftBorder}" BorderThickness="1"
                CornerRadius="12" Padding="16,12" Margin="0,0,0,14"
                IsVisible="{Binding ShowVerifyPrompt}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Width="18" Height="18" CornerRadius="9"
                        Background="{StaticResource BrandPrimary}" VerticalAlignment="Center">
                    <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding VerifyPromptText}" FontSize="12.5"
                           Foreground="{StaticResource BrandActive}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2" Classes="sec" Content="去平台账号" Height="30"
                        Padding="16,0"
                        ToolTip.Tip="到「平台账号」页点开这些账号的窗口（自动刷新凭证），打开后本提示消失"
                        Command="{Binding GoOpenAccountWindowsCommand}" />
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图一：工作台 ═══
        ════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowWorkbench}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,6,0">

                <!-- 账号异常横幅（最高优先级交互，设计文档 §2.4 ①） -->
                <ItemsControl ItemsSource="{Binding AccountAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountAlertViewModel">
                            <Border Background="#FFF3E8" BorderBrush="#FFE0B2" BorderThickness="1"
                                    CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="18" Height="18" CornerRadius="9"
                                            Background="#FA8C16" VerticalAlignment="Center">
                                        <TextBlock Text="!" FontSize="12" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5"
                                               Foreground="#B45F06" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="2" Classes="chip-retry" Content="去登录"
                                            Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).GoLoginCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 导入区 -->
                <Border Background="{StaticResource BrandSoft}"
                        BorderBrush="{StaticResource BrandSoftBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="20,18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                            <Button Classes="cta" Content="导入文件夹" Height="38" Padding="20,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ImportFolderCommand}" />
                            <Button Grid.Column="1" Classes="sec" Content="添加视频" Height="38"
                                    Padding="20,0" VerticalAlignment="Center"
                                    Command="{Binding AddVideosCommand}" />
                            <Button Grid.Column="2" Classes="sec" Content="新建模板" Height="38"
                                    Padding="20,0" VerticalAlignment="Center"
                                    ToolTip.Tip="生成一个「发布单元模板」文件夹：复制改名、丢进视频就能导入"
                                    Command="{Binding CreateTemplateCommand}" />
                            <Button Grid.Column="3" Classes="ghost" Content="导入说明"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleImportHelpCommand}" />
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2"
                                        Margin="10,0,0,0">
                                <TextBlock TextWrapping="Wrap" Text="子文件夹 = 一条视频 · 散装视频每个一条" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrandActive}" />
                                <TextBlock Text="params.txt 填标题 / 简介 / 话题 / 位置 / 合集 · cover.jpg 作封面（缺了自动抽首帧）· 一次最多 10 条"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="或把文件夹拖到这里"
                                       FontSize="11" Foreground="{StaticResource TextPlaceholder}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 待导入条：展开超过 10 条时的余量，不重新选文件就能接着导 -->
                        <Border IsVisible="{Binding HasPending}" Background="White"
                                BorderBrush="{StaticResource BrandSoftBorder}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding PendingText}" FontSize="12.5"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="sec" Height="30" Padding="14,0"
                                        Content="{Binding ImportMoreLabel}"
                                        IsEnabled="{Binding !IsBusy}"
                                        Command="{Binding ImportMoreCommand}" />
                                <Button Grid.Column="2" Classes="ghost" Content="放弃剩余"
                                        VerticalAlignment="Center"
                                        Command="{Binding ClearPendingCommand}" />
                            </Grid>
                        </Border>

                        <!-- 导入提示条：params.txt 哪一行没看懂 / 哪个目录没视频 / 跳过几条重复 -->
                        <Border IsVisible="{Binding HasImportNotice}" Background="#FFF3E8"
                                BorderBrush="#FFE0B2" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <TextBlock Text="{Binding ImportNotice}" FontSize="11.5"
                                       Foreground="#B45F06" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 目录约定说明（页内折叠；点「新建模板」后自动展开） -->
                <Border IsVisible="{Binding ShowImportHelp}" Background="White"
                        BorderBrush="#EDEFF3" BorderThickness="1"
                        CornerRadius="12" Padding="20,18">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="导入说明" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="sec" Height="30" Padding="14,0" Content="新建模板"
                                        Command="{Binding CreateTemplateCommand}" />
                                <Button Classes="sec" Height="30" Padding="14,0" Content="打开模板文件夹"
                                        IsEnabled="{Binding HasTemplateFolder}"
                                        Command="{Binding OpenTemplateFolderCommand}" />
                                <Button Classes="ghost" Content="收起"
                                        VerticalAlignment="Center"
                                        Command="{Binding ToggleImportHelpCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="一个文件夹 = 一条待发布视频" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandActive}" />
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="14" RowSpacing="5">
                            <TextBlock Text="我的视频\" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Grid.Column="2" Text="文件夹名 = 默认标题（可被 params.txt 的「标题:」覆盖）"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="我的视频.mp4" FontSize="12"
                                       Margin="14,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="视频，必需。目录里有多个时只取第一个"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="params.txt" FontSize="12"
                                       Margin="14,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="参数，可选 —— 标题 / 简介 / 话题 / 位置 / 合集 / 可见性 / 声明 / 发布时间 / 允许下载 / 原创（小红书 / B站 / 头条）"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="cover.jpg" FontSize="12"
                                       Margin="14,0,0,0" />
                            <TextBlock TextWrapping="Wrap" Grid.Row="3" Grid.Column="2" Text="封面，可选。jpg / png / webp 都行；没有就自动抽视频首帧"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                        </Grid>

                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="一次最多导入 10 条：展开后超过 10 条时，多出来的留在「待导入」里，点「继续导入」接着导，不用重选。" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="格式：每行「字段名: 值」，# 开头是注释。字段名写错只是那一行不生效，不会让导入失败（导入时会在提示条里说明是第几行）。" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="话题写在「话题:」行里，不要写进「简介」：发布时软件会把话题带 # 追加到正文末尾（四个平台都是），简介里再写一个对不上话题的 #，抖音会整条拒收。" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="位置写的是关键词（如「苏州姑苏」），导入时软件去四个平台各搜一次，各拿各自的 POI；搜不到的平台标「不带位置」，不会瞎填。合集写的是名字（如「苏州房产」），导入时按名字查你在「合集」页同步下来的映射，铺到每个账号；名字对不上就保持账号预设不动，某个账号没同步过则那个账号不带合集。快手「同城可见·允许同框」/ 抖音「热点词」/ 可见性名单 / 声明的补充信息仍按账号记，在「发布预设」或条目编辑器里调。" />
                    </StackPanel>
                </Border>

                <!-- 全局目标 -->
                <Border Background="White" BorderBrush="#EDEFF3" BorderThickness="1"
                        CornerRadius="12" Padding="16,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="发布到" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0"
                                       Text="新导入的条目默认发到这些账号"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TargetCountText}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Text="还没有绑定任何平台账号 —— 到「平台账号」页去登录一个，再回来发布"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   IsVisible="{Binding !HasAccounts}" />

                        <!-- 分组组条（2026-10-14）：点一格 = 只勾选该格账号（替换式，芯片仍全部可见、
                             可再手动微调）；「全部」是第 0 格哨兵。没有分组时整条不出现。 -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding HasGroupChoices}">
                            <TextBlock Text="分组" FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding GroupChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountGroupChoiceViewModel">
                                        <Button Classes="group-chip" Margin="0,0,6,4"
                                                Classes.active="{Binding IsActive}"
                                                IsEnabled="{Binding !IsEmpty}"
                                                Content="{Binding Text}"
                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ApplyGroupCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding GlobalTargets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountChipViewModel">
                                    <ToggleButton Classes="chip" IsChecked="{Binding IsOn}"
                                                  IsEnabled="{Binding CanPublish}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="chip-dot" Width="8" Height="8"
                                                    CornerRadius="4"
                                                    Background="{Binding BrandHex}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PlatformName}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#F2F3F5" CornerRadius="4" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowUnsupported}">
                                                <TextBlock Text="未接入" FontSize="9.5"
                                                           Foreground="#86909C" />
                                            </Border>
                                            <Border Width="6" Height="6" CornerRadius="3"
                                                    Background="#FA8C16" VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowExpired}"
                                                    ToolTip.Tip="登录已过期，需重新登录" />
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     VerticalAlignment="Center">
                                                <Path Classes="chip-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="{StaticResource BrandPrimary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding DraftCountText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <!-- 全选（2026-10-22 用户需求）：全勾 ↔ 取消全勾，与每条勾选双向联动 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding HasDrafts}">
                        <ToggleButton Classes="check-row" Width="20" Height="20" Padding="0"
                                      IsChecked="{Binding AllDraftsSelected}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="全选 / 取消全选所有待发布条目">
                            <Border Classes="tick">
                                <Viewbox Width="11" Height="11" Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path Classes="tick-check"
                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                          Fill="White" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                        </ToggleButton>
                        <TextBlock Text="全选" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 批量移除勾选的条目（与「提交」同一只勾：勾着的就是要处理的那批） -->
                    <Button Grid.Column="2" Classes="danger" Height="28" FontSize="12"
                            Content="{Binding RemoveSelectedText}"
                            IsVisible="{Binding HasSelectedDrafts}"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding RemoveSelectedDraftsCommand}" />
                    <TextBlock Grid.Column="4" Text="未勾选的条目不会提交"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock TextWrapping="Wrap" Text="还没有待发布条目 —— 点上面的「导入文件夹」，或直接把文件夹拖进来"
                           FontSize="12" Foreground="{StaticResource TextMuted}"
                           Margin="0,20,0,0" HorizontalAlignment="Center"
                           IsVisible="{Binding !HasDrafts}" />

                <ItemsControl ItemsSource="{Binding Drafts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PublishDraft">
                            <Border Classes="mock-card" Padding="16,14" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                    <ToggleButton Classes="check-row" Width="20" Height="20"
                                                  Padding="0" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center">
                                        <Border Classes="tick">
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="tick-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="White" Stretch="Uniform" />
                                            </Viewbox>
                                        </Border>
                                    </ToggleButton>

                                    <!-- 缩略图：探测出来就显示首帧，否则品牌浅色块 -->
                                    <Border Grid.Column="1" Classes="thumb"
                                            Background="{StaticResource BrandSoft}"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Meta.ThumbPath, Converter={StaticResource PathToBitmap}}"
                                                   Stretch="UniformToFill" />
                                            <Viewbox Width="16" Height="16" Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding !HasThumb}">
                                                <Path Data="M8,5L19,12L8,19Z" Fill="#FFFFFF"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="2" Spacing="8"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" FontSize="15"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}" Classes="hint"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Targets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PublishTarget">
                                                    <Border Background="#F7F8FA" CornerRadius="7"
                                                            Padding="6,3" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding PlatformDisplayName}" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding AccountLabel}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 内联预检：问题直接标在卡片上，不等到提交 -->
                                        <ItemsControl ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PreflightIssue">
                                                    <Border Background="{Binding BgHex}" CornerRadius="7"
                                                            Padding="8,4" Margin="0,0,0,4">
                                                        <TextBlock Classes="issue"
                                                                   Foreground="{Binding TextHex}">
                                                            <Run Text="{Binding Prefix}" FontWeight="Bold" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Message}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Button Classes="ghost" Content="编辑"
                                                HorizontalAlignment="Right"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).EditDraftCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="ghost" Content="移除"
                                                HorizontalAlignment="Right"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).RemoveDraftCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图二：条目编辑器 ═══
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,340" ColumnSpacing="20"
              IsVisible="{Binding ShowEditor}">

            <!-- ─── 左栏：全局区 ─── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,6,0">

                    <!-- 内容（每条一次） -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="sec-title" Text="内容（每条一次）" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <TextBlock Classes="lbl" Text="标题" VerticalAlignment="Center"
                                           Width="52" />
                                <TextBox Grid.Column="1" Text="{Binding SelectedDraft.Title}"
                                         Watermark="视频标题" />
                                <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                           Text="{Binding TitleCounterText}"
                                           MinWidth="52" TextAlignment="Right" />
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="lbl" Text="简介" />
                                <!-- 多行框必须显式 Top：默认 Center 会把第一行顶到框中间，
                                     上方留一大片空白（合集页的简介同样处理） -->
                                <TextBox Text="{Binding SelectedDraft.Description}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" Padding="12,10"
                                         MinHeight="90" MaxHeight="180"
                                         Watermark="视频简介（话题写在下面的「话题」里，发布时自动追加到正文末尾）" />
                                <TextBlock Classes="hint" Text="{Binding DescriptionCounterText}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="lbl" Text="封面" />
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                    <Border Width="96" Height="64" CornerRadius="8"
                                            Background="#F2F3F5" ClipToBounds="True">
                                        <Image Source="{Binding CoverPathForPreview, Converter={StaticResource PathToBitmap}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Classes="sec" Content="选择封面" Height="28"
                                                FontSize="12"
                                                Command="{Binding PickCoverCommand}" />
                                        <Button Classes="ghost" Content="用视频首帧" Height="26"
                                                Command="{Binding ClearCoverCommand}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                   Text="不选的话，会自动抽取视频首帧上传当封面（各平台统一，避开 0 秒黑场）；选了图会先上传并以图为准" />
                                        <!-- 封面图实际像素 —— 抖音裁剪尺寸留空时按它自动下发 -->
                                        <TextBlock Classes="hint"
                                                   Text="{Binding CoverSizeText}"
                                                   IsVisible="{Binding HasCoverSize}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 封面帧：内容级选择（六平台共用的自动抽帧时间点），空 = 0.5 秒 -->
                                <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="10">
                                    <TextBlock Classes="lbl" Text="封面帧" VerticalAlignment="Center"
                                               Width="52" />
                                    <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                             Text="{Binding CoverFrameText}"
                                             Watermark="秒，空 = 0.5" />
                                    <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="第几秒截封面 —— 没选封面图时统一按它自动抽帧；留空 = 0.5 秒（避开黑场），0 = 第 0 秒；选了封面图以图为准" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="lbl" Text="发布时间" />
                                <!-- 日期/时间选择器**单独一行**：这两个控件比同排的按钮宽，
                                     塞进 Auto 列会顶到相邻列上（Avalonia 默认不裁剪）。
                                     占满一行既躲开这个坑，也让「几点发」看得更清楚。 -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ToggleButton Classes="radio-row" Padding="4,4"
                                                  IsChecked="{Binding IsImmediate}"
                                                  Command="{Binding SelectScheduleModeCommand}"
                                                  CommandParameter="{x:False}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="radio">
                                                <Border Classes="radio-core" Width="8" Height="8"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="立即" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Classes="radio-row" Padding="4,4"
                                                  IsChecked="{Binding IsScheduled}"
                                                  Command="{Binding SelectScheduleModeCommand}"
                                                  CommandParameter="{x:True}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="radio">
                                                <Border Classes="radio-core" Width="8" Height="8"
                                                        CornerRadius="4"
                                                        Background="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="定时" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10"
                                            IsVisible="{Binding IsScheduled}">
                                    <DatePicker Theme="{StaticResource AppDatePickerTheme}"
                                                SelectedDate="{Binding ScheduledDate}" />
                                    <TimePicker Theme="{StaticResource AppTimePickerTheme}"
                                                SelectedTime="{Binding ScheduledTime}" />
                                    <TextBlock Classes="hint" VerticalAlignment="Center"
                                               Text="{Binding ScheduleHint}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 可见性（含小红书白名单） -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sec-title" Text="可见性" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Classes="hint" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="六态：仅小红书支持互关/只给/不给，仅粉丝仅头条；其余平台不支持的会退回「公开」" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding VisibilityOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VisibilityOptionViewModel">
                                        <ToggleButton Classes="radio-row" Padding="6,4"
                                                      Margin="0,0,14,6"
                                                      IsChecked="{Binding IsSelected}"
                                                      Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).SelectVisibilityCommand}"
                                                      CommandParameter="{Binding Kind}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="radio">
                                                    <Border Classes="radio-core" Width="8" Height="8"
                                                            CornerRadius="4" Background="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" Text="{Binding VisibilityNote}"
                                       TextWrapping="Wrap" />

                            <!-- 白名单：紧贴可见性，只在「只给谁看 / 不给谁看」时出现 -->
                            <StackPanel Spacing="8" IsVisible="{Binding ShowPrivacyWhitelist}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding PrivacySearchText}"
                                             Watermark="搜索小红书用户（昵称）…" />
                                    <Button Grid.Column="1" Classes="sec" Content="搜索" Height="32"
                                            FontSize="12"
                                            Command="{Binding SearchPrivacyUsersCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PrivacyResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PrivacyUserRow">
                                            <Border Classes="resolve-row" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Classes="tick" Width="14" Height="14"
                                                            Background="White"
                                                            BorderBrush="#C9CDD4">
                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 IsVisible="{Binding IsSelected}">
                                                            <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                  Fill="{StaticResource BrandPrimary}"
                                                                  Stretch="Uniform" />
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Nickname}"
                                                               FontSize="12" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Classes="ghost" Content="选"
                                                            Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).TogglePrivacyUserCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="lbl" Text="已选白名单（点 × 移除）" />
                                    <ItemsControl ItemsSource="{Binding PrivacyChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PrivacyUserRow">
                                                <Border Background="#F7F8FA" CornerRadius="7"
                                                        Padding="8,4" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Nickname}" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Button Classes="ghost" Content="×" Width="18"
                                                                Height="18" Padding="0" FontSize="13"
                                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).RemovePrivacyUserCommand}"
                                                                CommandParameter="{Binding UserId}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <ToggleButton Classes="check-row" Padding="4,4"
                                          IsChecked="{Binding SelectedDraft.AllowDownload}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="tick">
                                        <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Classes="tick-check"
                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                  Fill="White" Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="允许他人下载" FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- 原创：2026-11-06 从小红书平台卡上提到全局区（内容属性，不是账号属性） -->
                            <StackPanel Spacing="4">
                                <ToggleButton Classes="check-row" Padding="4,4"
                                              IsChecked="{Binding IsOriginal}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="tick">
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Path Classes="tick-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="White" Stretch="Uniform" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="原创声明" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="仅小红书 / B站 / 头条有投稿字段；开启后不能同时选「内容为转载」（预检会拦）" />
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="小红书：视频需 ≥10 秒才能用原创声明与视频标注" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 话题：联邦解析 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="sec-title" Text="话题" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="一次输入 · 各平台并行解析；未命中的平台保留纯文本，不删" />
                                <Button Grid.Column="2" Classes="ghost" Content="重新解析"
                                        IsEnabled="{Binding HasTopics}"
                                        Command="{Binding ResolveTopicsCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectedDraft.Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{StaticResource BrandSoft}" CornerRadius="7"
                                                Padding="8,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" FontSize="12"
                                                           Foreground="{StaticResource BrandActive}"
                                                           VerticalAlignment="Center" />
                                                <Button Classes="ghost" Content="×" Width="18"
                                                        Height="18" Padding="0" FontSize="13"
                                                        Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).RemoveTopicCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding TopicInput}" Watermark="输入话题名，回车或点「添加」" />
                                <Button Grid.Column="1" Classes="sec" Content="添加" Height="32"
                                        FontSize="12" Command="{Binding AddTopicCommand}" />
                            </Grid>

                            <!-- 快手硬限 3 个话题标签（2026-10-22 实测，超了 submit 整条拒） -->
                            <Border Background="#FFF3E8" CornerRadius="7" Padding="8,4"
                                    IsVisible="{Binding ShowKuaishouTopicLimitHint}">
                                <TextBlock FontSize="11.5" Foreground="#B45F06" TextWrapping="Wrap"
                                           Text="{Binding KuaishouTopicLimitText}" />
                            </Border>

                            <StackPanel Spacing="6" IsVisible="{Binding ShowTopicResults}">
                                <TextBlock Classes="lbl" Text="各平台解析结果" />
                                <ItemsControl ItemsSource="{Binding TopicRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:TopicResolutionRow">
                                            <StackPanel Margin="0,0,0,4">
                                                <!-- 关键词组头：画在每组第一行上。
                                                     候选列表是嵌套 ItemsControl —— $parent[ItemsControl] 会解析到**内层**、
                                                     命令就绑不到 VM，所以这一区一律用 $parent[UserControl]。 -->
                                                <TextBlock Text="{Binding Keyword}" FontSize="12.5"
                                                           FontWeight="SemiBold" Margin="0,6,0,4"
                                                           IsVisible="{Binding IsGroupFirst}" />
                                                <Border Classes="resolve-row">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Classes="pf-badge"
                                                                Background="{Binding BrandHex}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <Border Width="6" Height="6" CornerRadius="3"
                                                                    Background="{Binding DotHex}"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PrimaryText}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NotFoundText}"
                                                                       Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsNotFound}" />
                                                            <TextBlock Text="{Binding SecondaryText}"
                                                                       Classes="hint"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{Binding StatusColorHex}"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding Found}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <!-- 小红书冷启动预热可达几十秒：告诉用户在跑，不是在卡住 -->
                                                            <TextBlock Text="检索中…" Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsBusy}" />
                                                            <Button Classes="chip-retry" Content="换"
                                                                    IsVisible="{Binding ShowSwap}"
                                                                    IsEnabled="{Binding !IsBusy}"
                                                                    ToolTip.Tip="展开候选；回填的结果还没拉过候选时，点一下现拉"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleCandidatesCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Classes="chip-retry" Content="重搜"
                                                                    IsVisible="{Binding ShowRetry}"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ResolveTopicsCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 候选（就地展开）：「用这个」立刻换掉该平台**所有账号**的值 -->
                                                <Border IsVisible="{Binding IsExpanded}" Margin="2,2,0,6"
                                                        Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Candidates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:ResolutionCandidate">
                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="10" Margin="0,3">
                                                                    <TextBlock Text="{Binding Primary}" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Secondary}"
                                                                               Classes="hint"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="当前"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource BrandActive}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsCurrent}" />
                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                            Content="用这个"
                                                                            IsVisible="{Binding !IsCurrent}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickTopicCandidateCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 翻页：只有支持分页的平台才出现（抖音/小红书话题、视频号位置都不支持） -->
                                                    <Button Classes="chip-retry" Content="加载更多"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            IsVisible="{Binding CanLoadMore}"
                                                            IsEnabled="{Binding !IsLoadingMore}"
                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreCandidatesCommand}"
                                                            CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 平台推荐（2026-11-09 恢复）：右侧平台卡话题块删除后，
                                 小红书 / B站 的「按标题推荐」接口失去了 UI 入口 —— 接回公共话题卡。
                                 每账号一行：获取推荐 → 候选（带平台 ID）→ 选中写进该账号的结构化
                                 话题（发布时下发 hash_tag / topic_id），芯片可移除。
                                 快手 / 头条的推荐要等视频上传完成后的上下文，行内给说明不误导。 -->
                            <StackPanel Spacing="8" Margin="0,4,0,0"
                                        IsVisible="{Binding HasPlatformRecommendRows}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="lbl" Text="平台推荐" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="按标题 / 简介向平台要推荐；选中后带平台话题 ID（发布时作为结构化话题下发）" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RecommendRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TargetRowViewModel">
                                            <Border Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                        <Border Classes="pf-badge" Background="{Binding BrandHex}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PlatformName}" FontSize="12.5"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding TopicApiHint}"
                                                                   Classes="hint" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding HasTopicApiHint}" />
                                                        <Button Grid.Column="3" Classes="chip-retry"
                                                                Content="获取推荐"
                                                                IsEnabled="{Binding !IsTopicBusy}"
                                                                IsVisible="{Binding !TopicRecommendNeedsUpload}"
                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RecommendTopicSuggestionsCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <!-- 已选结构化话题（带平台 ID）：标签 + 移除 -->
                                                    <ItemsControl ItemsSource="{Binding TopicChips}"
                                                                  IsVisible="{Binding HasTopicChips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TopicChipViewModel">
                                                                <Border Background="{StaticResource BrandSoft}"
                                                                        CornerRadius="7" Padding="8,3"
                                                                        Margin="0,0,6,4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="12"
                                                                                   Foreground="{StaticResource BrandActive}"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding ToolTipText}" />
                                                                        <Border Background="#FFF3E8" CornerRadius="4"
                                                                                Padding="4,0" VerticalAlignment="Center"
                                                                                IsVisible="{Binding IsActivity}">
                                                                            <TextBlock Text="有奖活动" FontSize="10"
                                                                                       Foreground="#B45F06" />
                                                                        </Border>
                                                                        <TextBlock Text="仅文本" FontSize="10"
                                                                                   Foreground="#86909C"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsPlainText}" />
                                                                        <Button Classes="ghost" Content="×"
                                                                                Width="18" Height="18"
                                                                                Padding="0" FontSize="13"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).RemoveTopicChipCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{Binding TopicStatusText}"
                                                               IsVisible="{Binding HasTopicStatus}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{Binding TopicStatusColorHex}" />
                                                    <TextBlock Text="拉取中…" Classes="hint"
                                                               IsVisible="{Binding IsTopicBusy}" />

                                                    <!-- 候选：选中即写进该账号的结构化话题 -->
                                                    <ItemsControl ItemsSource="{Binding TopicSuggestions}"
                                                                  IsVisible="{Binding HasTopicSuggestions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TopicPickViewModel">
                                                                <Border Background="White" BorderBrush="#EDEFF3"
                                                                        BorderThickness="1" CornerRadius="7"
                                                                        Padding="8,3" Margin="0,0,6,4">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding ToolTipText}" />
                                                                        <TextBlock Text="{Binding MetricText}"
                                                                                   Classes="hint" FontSize="10.5"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding HasMetric}" />
                                                                        <TextBlock Text="已添加" FontSize="10.5"
                                                                                   Foreground="{StaticResource BrandActive}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsSelected}" />
                                                                        <Button Classes="chip-retry" Content="添加"
                                                                                IsVisible="{Binding !IsSelected}"
                                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickTopicSuggestionCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 官方活动（2.6.9）：只有抖音 / 快手 / 小红书 / B站 有活动接口 ——
                         每平台一行、合并到公共区（不再散落在右侧平台卡里）；
                         选择 / 清除对该平台所有账号一起生效；选中自动带活动关联话题。 -->
                    <Border Classes="section-card" IsVisible="{Binding HasActivityRows}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sec-title" Text="官方活动" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="关联官方活动可在活动页获得额外曝光；活动不影响发布，只是多一份曝光" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ActivityRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlatformActivityRowViewModel">
                                        <Border Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8"
                                                Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <Border Classes="pf-badge" Background="{Binding BrandHex}">
                                                        <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                   FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PlatformName}" FontSize="12.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Classes="hint" Text="{Binding AccountScopeText}"
                                                                   IsVisible="{Binding HasAccountScope}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                            Content="{Binding ActivityPanelButtonText}"
                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleActivityPanelCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>

                                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                                           Text="还没有选择活动 —— 点「选择活动」拉取平台官方活动；活动不影响发布，只是多一份曝光"
                                                           IsVisible="{Binding ShowActivityEmptyHint}" />

                                                <ItemsControl ItemsSource="{Binding ActivityChips}"
                                                              IsVisible="{Binding HasActivityChips}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ActivityChipViewModel">
                                                            <Border Background="{StaticResource BrandSoft}"
                                                                    CornerRadius="7" Padding="8,3"
                                                                    Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource BrandActive}"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding ToolTipText}" />
                                                                    <Border Background="#FFF3E8"
                                                                            CornerRadius="4" Padding="4,0"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding HasReward}">
                                                                        <TextBlock Text="{Binding RewardText}"
                                                                                   FontSize="10"
                                                                                   Foreground="#B45F06" />
                                                                    </Border>
                                                                    <TextBlock Text="已结束" FontSize="10"
                                                                               Foreground="#CB2634"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsEnded}" />
                                                                    <TextBlock Text="{Binding DeadlineText}"
                                                                               Classes="hint" FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasDeadline}" />
                                                                    <TextBlock Text="{Binding TopicCountText}"
                                                                               Classes="hint" FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasTopics}" />
                                                                    <Button Classes="ghost" Content="×"
                                                                            Width="18" Height="18"
                                                                            Padding="0" FontSize="13"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ClearActivityCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- 活动候选面板（就地展开） -->
                                                <StackPanel Spacing="6"
                                                            IsVisible="{Binding IsActivityPanelOpen}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Text="活动来自平台官方接口；选中后自动带上活动关联话题，对该平台所有账号生效" />
                                                        <Button Grid.Column="1" Classes="sec"
                                                                Content="获取活动列表"
                                                                Height="32" FontSize="12"
                                                                IsEnabled="{Binding !IsActivityBusy}"
                                                                Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).FetchActivitiesCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding ActivityStatusText}"
                                                               IsVisible="{Binding HasActivityStatus}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{Binding ActivityStatusColorHex}" />
                                                    <TextBlock Text="拉取中…" Classes="hint"
                                                               IsVisible="{Binding IsActivityBusy}" />

                                                    <ScrollViewer MaxHeight="260"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  IsVisible="{Binding HasActivityOptions}">
                                                        <ItemsControl ItemsSource="{Binding ActivityOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ActivityCardViewModel">
                                                                    <Border Background="White" BorderBrush="#EDEFF3"
                                                                            BorderThickness="1" CornerRadius="7"
                                                                            Padding="8,6" Margin="0,0,0,6"
                                                                            Opacity="{Binding CardOpacity}">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                                                              ColumnSpacing="10">
                                                                            <!-- 封面（远程加载；失败/未加载 → 首字占位） -->
                                                                            <Border Width="56" Height="56"
                                                                                    CornerRadius="6"
                                                                                    ClipToBounds="True"
                                                                                    Background="#EEF1F5"
                                                                                    VerticalAlignment="Center">
                                                                                <Grid>
                                                                                    <Image Source="{Binding Cover}"
                                                                                           Stretch="UniformToFill"
                                                                                           IsVisible="{Binding HasCover}" />
                                                                                    <TextBlock Text="{Binding Initial}"
                                                                                               FontSize="20"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="#A9B4C4"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding !HasCover}" />
                                                                                </Grid>
                                                                            </Border>

                                                                            <StackPanel Grid.Column="1" Spacing="3"
                                                                                        VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="6">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               FontSize="12.5"
                                                                                               FontWeight="SemiBold"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"
                                                                                               ToolTip.Tip="{Binding ToolTipText}" />
                                                                                    <Border Background="#E8F3FF"
                                                                                            CornerRadius="4" Padding="4,0"
                                                                                            VerticalAlignment="Center"
                                                                                            IsVisible="{Binding HasCustomTag}">
                                                                                        <TextBlock Text="{Binding CustomTagText}"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#1D5FA8" />
                                                                                    </Border>
                                                                                    <Border Background="#FFF3E8"
                                                                                            CornerRadius="4" Padding="4,0"
                                                                                            VerticalAlignment="Center"
                                                                                            IsVisible="{Binding HasReward}">
                                                                                        <TextBlock Text="{Binding RewardText}"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#B45F06" />
                                                                                    </Border>
                                                                                    <Border Background="#FDECEE"
                                                                                            CornerRadius="4" Padding="4,0"
                                                                                            VerticalAlignment="Center"
                                                                                            IsVisible="{Binding IsEnded}">
                                                                                        <TextBlock Text="已结束"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#CB2634" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal"
                                                                                            Spacing="10">
                                                                                    <TextBlock Text="{Binding DeadlineText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding HasDeadline}" />
                                                                                    <TextBlock Text="{Binding MetricText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding HasMetric}" />
                                                                                    <TextBlock Text="{Binding TopicCountText}"
                                                                                               Classes="hint" FontSize="11"
                                                                                               VerticalAlignment="Center"
                                                                                               IsVisible="{Binding HasTopics}" />
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <Button Grid.Column="2"
                                                                                    Classes="chip-retry"
                                                                                    Content="选择"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding ShowSelectButton}"
                                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickActivityCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <TextBlock Grid.Column="2" Text="已选择"
                                                                                       FontSize="11"
                                                                                       Foreground="{StaticResource BrandActive}"
                                                                                       VerticalAlignment="Center"
                                                                                       IsVisible="{Binding IsSelected}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 位置：联邦解析 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="sec-title" Text="位置" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="一次输入 · 平台并行解析；不做实体对齐，逐平台显示实际命中的是哪个 POI" />
                                <Button Grid.Column="2" Classes="ghost" Content="清除位置"
                                        Command="{Binding ClearLocationCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding LocationQuery}"
                                         Watermark="搜索位置（如：外滩）" />
                                <Button Grid.Column="1" Classes="sec" Content="搜索" Height="32"
                                        FontSize="12" Command="{Binding ResolveLocationCommand}" />
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding ShowPoiResults}">
                                <ItemsControl ItemsSource="{Binding PoiRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:PoiResolutionRow">
                                            <StackPanel Margin="0,0,0,4">
                                                <Border Classes="resolve-row">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Classes="pf-badge"
                                                                Background="{Binding BrandHex}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <Border Width="6" Height="6" CornerRadius="3"
                                                                    Background="{Binding DotHex}"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PrimaryText}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NotFoundText}"
                                                                       Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsNotFound}" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                       Foreground="{Binding StatusColorHex}"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding Found}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    Spacing="6" VerticalAlignment="Center">
                                                            <!-- 小红书冷启动预热可达几十秒：告诉用户在跑，不是在卡住 -->
                                                            <TextBlock Text="检索中…" Classes="hint"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding IsBusy}" />
                                                            <Button Classes="chip-retry" Content="换"
                                                                    IsVisible="{Binding ShowSwap}"
                                                                    IsEnabled="{Binding !IsBusy}"
                                                                    ToolTip.Tip="展开候选；回填的结果还没拉过候选时，点一下现拉"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ToggleCandidatesCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Classes="chip-retry" Content="重搜"
                                                                    IsVisible="{Binding ShowRetry}"
                                                                    Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).ResolveLocationCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 候选（就地展开）：「用这个」立刻换掉该平台**所有账号**的位置 -->
                                                <Border IsVisible="{Binding IsExpanded}" Margin="2,2,0,6"
                                                        Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                    <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Candidates}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="svc:ResolutionCandidate">
                                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                                      ColumnSpacing="10" Margin="0,3">
                                                                    <TextBlock Text="{Binding Primary}" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Secondary}"
                                                                               Classes="hint"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="当前"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource BrandActive}"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsCurrent}" />
                                                                    <Button Grid.Column="2" Classes="chip-retry"
                                                                            Content="用这个"
                                                                            IsVisible="{Binding !IsCurrent}"
                                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).PickPoiCandidateCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 翻页：只有支持分页的平台才出现（抖音/小红书话题、视频号位置都不支持） -->
                                                    <Button Classes="chip-retry" Content="加载更多"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            IsVisible="{Binding CanLoadMore}"
                                                            IsEnabled="{Binding !IsLoadingMore}"
                                                            Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).LoadMoreCandidatesCommand}"
                                                            CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 合集：选一个逻辑合集，各平台映射取自合集页已同步数据 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Classes="sec-title" Text="合集" />
                                <TextBlock TextWrapping="Wrap" Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="四家都支持合集；映射取自合集页已同步的数据，不再逐个平台选一次" />
                                <Button Grid.Column="2" Classes="ghost" Content="不挂合集"
                                        Command="{Binding PickCollectionCommand}" />
                            </Grid>

                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding CollectionOptions}"
                                      SelectedItem="{Binding SelectedCollectionOption}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CollectionOptionViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SyncText}"
                                                       Classes="hint" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 3.2：文章合集不用于视频发布（头条文章合集 mapping 是另一套 ID） -->
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="{Binding HiddenArticleCollectionText}"
                                       IsVisible="{Binding HasHiddenArticleCollections}" />

                            <ItemsControl ItemsSource="{Binding CollectionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CollectionMappingRow">
                                        <Border Classes="resolve-row" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                <Border Classes="pf-badge" Background="{Binding BrandHex}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="9"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlatformName}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusColorHex}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 内容声明：6 个语义 · 按平台能力映射 -->
                    <Border Classes="section-card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="sec-title" Text="内容声明" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="hint"
                                           VerticalAlignment="Center"
                                           Text="单选 · 勾一次自动映射到各平台" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DeclarationOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeclarationOptionViewModel">
                                        <ToggleButton Classes="radio-row" Padding="6,4"
                                                      Margin="0,0,14,6"
                                                      IsChecked="{Binding IsSelected}"
                                                      Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).SelectDeclarationCommand}"
                                                      CommandParameter="{Binding Kind}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="radio">
                                                    <Border Classes="radio-core" Width="8" Height="8"
                                                            CornerRadius="4" Background="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="hint" Text="{Binding DeclarationMatrixText}"
                                       TextWrapping="Wrap" />

                            <!-- 二级区：只有「转载」「自行拍摄」出现；其余只给一句说明 -->
                            <TextBlock Classes="hint" Text="{Binding DeclarationSecondaryHint}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowSecondaryHintOnly}" />

                            <StackPanel Spacing="10" IsVisible="{Binding ShowDeclarationSecondary}">

                                <!-- 抖音：来源（抖音作品 / 站外）+ 选站内作品 -->
                                <Border Classes="field-row" IsVisible="{Binding ShowDouyinRepostSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="抖音 · 转载来源" />
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                            <ToggleButton Classes="radio-row" Padding="4,4"
                                                          IsChecked="{Binding DouyinRepostFromInside}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="radio">
                                                        <Border Classes="radio-core" Width="8" Height="8"
                                                                CornerRadius="4" Background="White"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="抖音作品" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Classes="radio-row" Padding="4,4"
                                                          IsChecked="{Binding !DouyinRepostFromInside}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Classes="radio">
                                                        <Border Classes="radio-core" Width="8" Height="8"
                                                                CornerRadius="4" Background="White"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="站外" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Button Grid.Column="2" Classes="sec" Content="选择我的作品…"
                                                    Height="28" FontSize="12"
                                                    HorizontalAlignment="Left"
                                                    IsVisible="{Binding ShowDouyinRepostItemPicker}"
                                                    Command="{Binding PickDouyinRepostItemCommand}" />
                                        </Grid>

                                        <!-- 已选作品 + 清除 -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                              IsVisible="{Binding ShowDouyinRepostItemPicker}">
                                            <TextBlock Text="{Binding DouyinRepostPickedText}" Classes="hint"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Classes="chip-retry" Content="清除已选"
                                                    IsVisible="{Binding HasDouyinRepostItem}"
                                                    Command="{Binding ClearDouyinRepostItemCommand}" />
                                        </Grid>

                                        <!-- 作品列表（原地展开）：选中即写 from_item_id；老版是独立弹窗，语义等价 -->
                                        <Border IsVisible="{Binding ShowDouyinRepostPicker}"
                                                Background="#FAFAFB" BorderBrush="#EDEFF3"
                                                BorderThickness="1" CornerRadius="8" Padding="10,6">
                                            <StackPanel>
                                                <TextBlock Classes="hint" Text="正在读取作品列表…"
                                                           Margin="0,2"
                                                           IsVisible="{Binding IsLoadingRepostItems}" />
                                                <ItemsControl ItemsSource="{Binding DouyinRepostItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DouyinRepostItemRow">
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                                  ColumnSpacing="10" Margin="0,3">
                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding DurationText}"
                                                                           Classes="hint" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding CreatedText}"
                                                                           Classes="hint" VerticalAlignment="Center" />
                                                                <Button Grid.Column="3" Classes="chip-retry"
                                                                        Content="选择"
                                                                        Command="{Binding $parent[UserControl].((vm:PublishViewModel)DataContext).SelectDouyinRepostItemCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Classes="chip-retry" Content="加载更多"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        IsVisible="{Binding RepostItemsHasMore}"
                                                        IsEnabled="{Binding !IsLoadingRepostItems}"
                                                        Command="{Binding LoadMoreDouyinRepostCommand}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 快手：来源平台 + 地区（省市区文本）+ 时间（毫秒） -->
                                <Border Classes="field-row" IsVisible="{Binding ShowKuaishouRepostSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="快手 · 转载来源 / 地区 / 时间" />
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                            <ComboBox SelectedIndex="{Binding KuaishouRepostPlatformIndex}"
                                                      Width="120">
                                                <ComboBoxItem Content="快手" />
                                                <ComboBoxItem Content="其他平台" />
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Width="180"
                                                     Text="{Binding KuaishouRepostLocation}"
                                                     Watermark="省市区（文本）" />
                                            <DatePicker Grid.Column="2" HorizontalAlignment="Left"
                                                        Theme="{StaticResource AppDatePickerTheme}"
                                                        SelectedDate="{Binding RepostDate}" />
                                            <TextBlock TextWrapping="Wrap" Grid.Column="3" Classes="hint"
                                                       VerticalAlignment="Center"
                                                       Text="快手要的是省市区**文本**与毫秒时间戳" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 小红书：转载填来源；自行拍摄填拍摄地点 + 时间 -->
                                <Border Classes="field-row" IsVisible="{Binding ShowXhsSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="小红书" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                              IsVisible="{Binding IsRepost}">
                                            <TextBlock Text="来源" FontSize="12"
                                                       VerticalAlignment="Center" Width="52" />
                                            <TextBox Grid.Column="1" Text="{Binding RepostSourceText}"
                                                     Watermark="如：YouTube" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                              IsVisible="{Binding IsSelfShot}">
                                            <TextBox Text="{Binding XhsShootPoiQuery}"
                                                     Watermark="拍摄地点（独立于「位置」的第二个地点）" />
                                            <Button Grid.Column="1" Classes="sec" Content="搜索地点"
                                                    Height="32" FontSize="12"
                                                    Command="{Binding SearchXhsShootPoiCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10"
                                              IsVisible="{Binding IsSelfShot}">
                                            <TextBlock Text="拍摄时间" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <DatePicker Grid.Column="1" HorizontalAlignment="Left"
                                                        Theme="{StaticResource AppDatePickerTheme}"
                                                        SelectedDate="{Binding ShootDate}" />
                                            <TextBlock Grid.Column="2" Classes="hint"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding XhsShootPoiText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 视频号：转载来源（选填）；自行拍摄填时间 + 国/省/市 -->
                                <Border Classes="field-row" IsVisible="{Binding ShowWechatSecondary}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="lbl" Text="视频号" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                              IsVisible="{Binding IsRepost}">
                                            <TextBlock Text="来源" FontSize="12"
                                                       VerticalAlignment="Center" Width="52" />
                                            <TextBox Grid.Column="1" Text="{Binding RepostSourceText}"
                                                     Watermark="选填" />
                                        </Grid>
                                        <StackPanel Spacing="8" IsVisible="{Binding IsSelfShot}">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="拍摄时间" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <DatePicker Grid.Column="1" HorizontalAlignment="Left"
                                                            Theme="{StaticResource AppDatePickerTheme}"
                                                            SelectedDate="{Binding ShootDate}" />
                                                <TextBlock TextWrapping="Wrap" Grid.Column="2" Classes="hint"
                                                           VerticalAlignment="Center"
                                                           Text="视频号协议要 shootInfo（时间戳字符串 + 国省市整数码）" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                                                <TextBox Width="90" Text="{Binding ShootCountryCode}"
                                                         Watermark="国家码" />
                                                <TextBox Grid.Column="1" Width="90"
                                                         Text="{Binding ShootProvinceCode}"
                                                         Watermark="省码" />
                                                <TextBox Grid.Column="2" Width="90"
                                                         Text="{Binding ShootCityCode}"
                                                         Watermark="市码" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="hint" Margin="0,0,0,10"
                               Text="这里的「话题」是跨平台纯文本：一次输入、各平台并行解析；上面「官方活动」每平台一行，选中后自动带上平台话题 ID 与活动关联话题。位置同理，提交时会分别问 N 个平台（联邦解析器）"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- ─── 右栏：平台卡 ─── -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="sec-title" Text="发布到" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hint" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding TargetOnCount, StringFormat='已选 {0} 个账号'}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="0,0,6,0">
                        <TextBlock Text="没有可发布的目标 —— 回工作台勾选账号"
                                   Classes="hint" IsVisible="{Binding NoTargetSelected}" />

                        <ItemsControl ItemsSource="{Binding TargetRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetRowViewModel">
                                    <Border Classes="target-card" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                <ToggleButton Classes="check-row" Width="18" Height="18"
                                                              Padding="0" IsChecked="{Binding IsOn}"
                                                              VerticalAlignment="Center"
                                                              Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).ToggleTargetCommand}"
                                                              CommandParameter="{Binding}">
                                                    <Border Classes="tick" Width="15" Height="15">
                                                        <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                            <Path Classes="tick-check"
                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                  Fill="White" Stretch="Uniform" />
                                                        </Viewbox>
                                                    </Border>
                                                </ToggleButton>

                                                <Border Grid.Column="1" Classes="pf-badge"
                                                        Background="{Binding BrandHex}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="9"
                                                               FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PlatformName}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                               Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="{StaticResource BrandSoft}"
                                                            CornerRadius="5" Padding="4,1"
                                                            IsVisible="{Binding IsPrimary}">
                                                        <TextBlock Text="主" FontSize="9.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource BrandActive}" />
                                                    </Border>
                                                    <Border Width="6" Height="6" CornerRadius="3"
                                                            Background="#FA8C16"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsLoggedIn}"
                                                            ToolTip.Tip="登录已过期" />
                                                </StackPanel>

                                                <ToggleButton Grid.Column="3" Classes="chev"
                                                              Width="22" Height="22" Padding="0"
                                                              IsChecked="{Binding IsExpanded}">
                                                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                        <Path Classes="chev-icon"
                                                              Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                              Fill="{StaticResource TextSecondary}"
                                                              Stretch="Uniform" />
                                                    </Viewbox>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- 摘要行：可见性 · 合集 · 位置（覆盖过预设的左侧有品牌紫竖条） -->
                                            <Border BorderThickness="2,0,0,0"
                                                    BorderBrush="Transparent"
                                                    Padding="8,0,0,0">
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <TextBlock Classes="hint" Text="{Binding VisibilityNote}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasVisibilityNote}" />

                                            <!-- 展开：长尾开关 -->
                                            <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}">
                                                <TextBlock Classes="lbl" Text="更多设置" />

                                                <ToggleButton Classes="check-row" Padding="2,3"
                                                              IsVisible="{Binding IsKuaishou}"
                                                              IsChecked="{Binding ShowInNearby}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="tick" Width="14" Height="14">
                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center">
                                                                <Path Classes="tick-check"
                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                      Fill="White" Stretch="Uniform" />
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="同城可见" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton Classes="check-row" Padding="2,3"
                                                              IsVisible="{Binding IsKuaishou}"
                                                              IsChecked="{Binding AllowSameFrame}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="tick" Width="14" Height="14">
                                                            <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center">
                                                                <Path Classes="tick-check"
                                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                      Fill="White" Stretch="Uniform" />
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Text="允许同框" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>


                                                <!-- 抖音长尾（阶段 2.1）：与「更多设置」同层，展开才看到 -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsDouyin}">
                                                    <TextBlock Classes="lbl" Text="抖音" />

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="热点词（与声明正交）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding HotspotSentence}"
                                                                 Watermark="留空 = 不参与热点" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="背景音乐 ID" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding MusicIdText}"
                                                                 Watermark="抖音音乐 ID；留空 = 不选音乐" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="章节" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ChaptersText}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 VerticalContentAlignment="Top" Padding="10,6"
                                                                 MinHeight="64" MaxHeight="140"
                                                                 Watermark="每行：mm:ss 标题，例如 0:00 开箱 / 1:30 实拍" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="时间点 + 标题；按时间升序下发（抖音长视频章节）" />
                                                    </StackPanel>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding SyncToToutiao}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="同步到今日头条 / 西瓜" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="自定义封面裁剪" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Classes="hint" Text="宽"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Width="90" Text="{Binding CoverCropWidthText}"
                                                                     Watermark="px" />
                                                            <TextBlock Classes="hint" Text="高"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Width="90" Text="{Binding CoverCropHeightText}"
                                                                     Watermark="px" />
                                                        </StackPanel>
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="留空 = 自动按封面图实际像素下发（抓包 1051×788 = 裁剪结果尺寸）；没有自定义封面时不下发" />
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="10"
                                                          IsVisible="{Binding HasCollection}">
                                                        <TextBlock Classes="lbl" Text="合集排序"
                                                                   VerticalAlignment="Center" Width="52" />
                                                        <TextBox Grid.Column="1"
                                                                 Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding CollectionOrderText}"
                                                                 Watermark="0" />
                                                        <TextBlock Grid.Column="2" Classes="hint"
                                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                                   Text="0 = 按发布时间顺序" />
                                                    </Grid>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="高级（原始 JSON 透传）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding MentionsJson}"
                                                                 Watermark="@ 用户 JSON 数组，例如 []" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding InteractionStickersJson}"
                                                                 Watermark="互动贴纸 JSON 数组，例如 []" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 快手长尾（阶段 2.2）：抓包全量字段，展开才看到 -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsKuaishou}">
                                                    <TextBlock Classes="lbl" Text="快手" />

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding NotifyFollowers}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="发布后通知粉丝" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="封面文字" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding KuaishouCoverTitleText}"
                                                                 Watermark="显示在封面上的文字；留空 = 不加" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="章节（原始 JSON 数组）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding KuaishouChaptersJson}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 VerticalContentAlignment="Top" Padding="10,6"
                                                                 MinHeight="52" MaxHeight="120"
                                                                 Watermark="留空 = 不传章节" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="抓包中 chapters 恒为空数组，元素结构尚未确认 —— 先按原始 JSON 原样透传" />
                                                    </StackPanel>

                                                    <TextBlock Classes="lbl" Text="创作辅助" />

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding RiseQuality}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="画质增强" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding UseAiCaption}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="AI 字幕" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding UseAiCaptionCover}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="AI 字幕封面" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding UseAiCover}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="AI 封面" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding UseIdealTime}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="智能发布时间" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding DisallowRecreation}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="禁止二创" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="PK 封面" />
                                                        <Grid ColumnDefinitions="Auto,*,Auto,80" ColumnSpacing="8">
                                                            <TextBlock Classes="hint" Text="Key"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding PkCoverKeyText}"
                                                                     Watermark="pkCoverKey" />
                                                            <TextBlock Grid.Column="2" Classes="hint" Text="帧(秒)"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="3"
                                                                     Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding PkCoverTimeStampText}"
                                                                     Watermark="留空" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,80,Auto,*" ColumnSpacing="8">
                                                            <TextBlock Classes="hint" Text="类型"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding PkCoverTypeText}"
                                                                     Watermark="1" />
                                                            <TextBlock Grid.Column="2" Classes="hint" Text="尺寸"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="3"
                                                                     Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding PkCoverSizeText}"
                                                                     Watermark="平台原样字符串" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="个人主页封面 Key" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ProfileCoverKeyText}"
                                                                 Watermark="profileCoverKey；留空 = 不改" />
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="lbl" Text="专属领域" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding DomainText}"
                                                                     Watermark="domain" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Classes="lbl" Text="二级领域" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding SecondDomainText}"
                                                                     Watermark="secondDomain" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="lbl" Text="关联短剧 ID" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding KuaishouMovieIdText}"
                                                                     Watermark="movieId；留空 = 不关联" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Classes="lbl" Text="项目 ID" />
                                                            <TextBox Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding KuaishouProjectIdText}"
                                                                     Watermark="projectId" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="共创（高级 · 原始 JSON 数组）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding CoPublishUsersJson}"
                                                                 Watermark="coPublishUser 数组；留空 = 不共创" />
                                                        <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="10">
                                                            <TextBlock Classes="hint" Text="共创角色"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Theme="{StaticResource AppInputTheme}"
                                                                     Text="{Binding CoPublishRoleText}"
                                                                     Watermark="0" />
                                                            <TextBlock Grid.Column="2" Classes="hint"
                                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                                       Text="coPublishUser 元素结构待抓包确认" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 小红书长尾（阶段 2.3）：抓包全量字段，展开才看到 -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsXhs}">
                                                    <TextBlock Classes="lbl" Text="小红书" />

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="章节" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ChaptersText}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                                 VerticalContentAlignment="Top" Padding="10,6"
                                                                 MinHeight="64" MaxHeight="140"
                                                                 Watermark="每行：mm:ss 标题，例如 0:00 开场 / 1:30 实拍" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="视频需 ≥15 秒且至少 3 段；与抖音共用同一份章节" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="视频摘要" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsSummaryText}"
                                                                 Watermark="video_info.summary；留空 = 不传" />
                                                    </StackPanel>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding AllowComment}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="允许评论" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding ChapterSyncText}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Classes="tick" Width="14" Height="14">
                                                                <Viewbox Width="10" Height="10" Stretch="Uniform"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center">
                                                                    <Path Classes="tick-check"
                                                                          Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                                          Fill="White" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Text="章节文字同步" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="速览合集 ID" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsSketchCollectionIdText}"
                                                                 Watermark="noteSketchCollectionBind.id；留空 = 不绑定" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="订单绑定（原始 JSON 对象）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsOrderBindJson}"
                                                                 Watermark="noteOrderBind，例如 {}" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="带货商品信息（原始 JSON 对象）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsGoodsInfoJson}"
                                                                 Watermark="goods_info，例如 {}" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="商品结构未抓到，按原始 JSON 透传；格式写错会在上传前报错" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="高级（原始 JSON 透传）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsAtsJson}"
                                                                 Watermark="@ 用户 JSON 数组，例如 []" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsBizRelationsJson}"
                                                                 Watermark="业务关系 JSON 数组，例如 []" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding XhsPkCoverBizRelationsJson}"
                                                                 Watermark="PK 封面业务关联 JSON 数组，例如 []" />
                                                    </StackPanel>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="允许下载映射 noteCopyBind.copyable（用上方全局开关）；原创与内容声明见声明区" />
                                                </StackPanel>

                                                <!-- 视频号长尾（阶段 2.4）：短标题 / 扩展链接 / 卡片样式 -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsWechatVideo}">
                                                    <TextBlock Classes="lbl" Text="视频号" />

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="短标题" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding WechatShortTitleText}"
                                                                 Watermark="留空 = 用标题（截取前 20 字）" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="不足 6 字不下发（页面实测 5 字报「标题至少6个字」）；此时这段文字会自动并入正文首行" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="扩展链接" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding WechatExternalLinkText}"
                                                                 Watermark="https://…；留空 = 不挂链接卡片" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding WechatExtReadingTitleText}"
                                                                 Watermark="链接卡片标题（选填；页面输入链接后自动解析）" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="媒体卡片样式" />
                                                        <ComboBox SelectedIndex="{Binding WechatCardShowStyleIndex}"
                                                                  Width="150" HorizontalAlignment="Left">
                                                            <ComboBoxItem Content="默认" />
                                                            <ComboBoxItem Content="平铺（1）" />
                                                            <ComboBoxItem Content="居中（2）" />
                                                        </ComboBox>
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="抓包横版视频恒为「居中」；竖版页面可能不下发" />
                                                    </StackPanel>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 未选位置时整个 location 字段不下发；内容标注跟随上方「内容声明」（tagKey 运行时按账号现取）" />
                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 封面：选了封面图就先图片直传、没选就自动抽首帧；发布后要换封面需到创作中心「修改封面」手动操作（保存接口待抓包）" />
                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 视频号没有标题字段；可见性只有公开 / 仅自己（发布后设置），当前恒公开" />
                                                </StackPanel>

                                                <!-- B站（阶段 4.6）：分区只读展示（params.txt 可覆盖）；
                                                     标签 / 动态 / 水印 / 字幕 / 互动 / 预约 / AI 封面 / 空间隐藏 /
                                                     互动视频 / 杜比 / 无损音乐全部建模；原创/可见性走全局卡。 -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsBilibili}">
                                                    <TextBlock Classes="lbl" Text="B站" />

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="标签（1~10 个，逗号分隔）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding BilibiliTagsText}"
                                                                 Watermark="家居, 室内设计, 家装" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="B站投稿至少要 1 个标签；标签 ≠ 话题 —— 话题要用带平台 ID 的结构化话题（全局话题卡「获取平台推荐」，或 params.txt 写「话题ID」）" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="分区" />
                                                        <TextBlock Text="{Binding BilibiliPartitionText}" FontSize="12" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="默认 21 / 1015 = 家装房产；需要别的分区，在 params.txt 写「B站分区」/「B站二级分区」（v1 不做分区树下拉）" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="动态文案（选填）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding BilibiliDynamicText}"
                                                                 Watermark="发布后同步到动态" />
                                                    </StackPanel>

                                                    <StackPanel Spacing="6">
                                                        <TextBlock Classes="lbl" Text="投稿选项" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliWatermark}">
                                                                <TextBlock Text="水印" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliAllowComment}">
                                                                <TextBlock Text="允许评论" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliAllowDanmaku}">
                                                                <TextBlock Text="允许弹幕" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliUpSelectionReply}">
                                                                <TextBlock Text="精选评论" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliNoReprint}">
                                                                <TextBlock Text="禁止转载" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliActReserve}">
                                                                <TextBlock Text="预约" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliInteractive}">
                                                                <TextBlock Text="互动视频" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliDolby}">
                                                                <TextBlock Text="杜比音效" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                            <ToggleButton Classes="check-row" Padding="2,3" Margin="0,0,8,4"
                                                                          IsChecked="{Binding BilibiliLosslessMusic}">
                                                                <TextBlock Text="无损音乐" FontSize="12" VerticalAlignment="Center" />
                                                            </ToggleButton>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                                          ColumnSpacing="8">
                                                        <TextBlock Text="预约标题" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding BilibiliActReserveTitleText}"
                                                                 Watermark="选填（开启预约时填写）" />
                                                        <TextBlock Grid.Column="2" Text="字幕语言" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="3" Width="80"
                                                                 Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding BilibiliSubtitleLanText}"
                                                                 Watermark="zh-CN" />
                                                        <TextBlock Grid.Column="4" Text="AI封面" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="5" Width="56"
                                                                 Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding BilibiliAiCoverText}"
                                                                 Watermark="0" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="空间隐藏" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Width="56"
                                                                 Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding BilibiliSpaceHiddenText}"
                                                                 Watermark="2" />
                                                        <TextBlock Grid.Column="2" Classes="hint"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Text="抓包默认 2；留空按 2 发送" />
                                                    </Grid>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 定时发布窗口：距当前 5 分钟 ~ 15 天（日期时间在左侧公共区设置）" />
                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 封面：选了封面图就先上传；没选就自动抽首帧再裁 16:9 / 4:3 两张" />
                                                </StackPanel>

                                                <!-- 头条（阶段 5.6）：赞赏 + 长尾；原创/合集/可见性走全局卡 -->
                                                <StackPanel Spacing="8" IsVisible="{Binding IsToutiao}">
                                                    <TextBlock Classes="lbl" Text="头条" />

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="标签（逗号分隔）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoTagsText}"
                                                                 Watermark="家居, 装修" />
                                                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                                                   Text="下发为 Label 数组；与 B站标签同源（按账号存）" />
                                                    </StackPanel>

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="扩展链接" FontSize="12"
                                                                   VerticalAlignment="Center" Width="52" />
                                                        <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoExternalLinkText}"
                                                                 Watermark="选填（ExternalLink）" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="封面标题" FontSize="12"
                                                                   VerticalAlignment="Center" Width="52" />
                                                        <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoCoverTitleText}"
                                                                 Watermark="选填（CoverTitles，单个）" />
                                                    </Grid>

                                                    <ToggleButton Classes="check-row" Padding="2,3"
                                                                  IsChecked="{Binding ToutiaoPraise}">
                                                        <TextBlock Text="开启赞赏" FontSize="12"
                                                                   VerticalAlignment="Center" />
                                                    </ToggleButton>

                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="模板名" FontSize="12"
                                                                   VerticalAlignment="Center" Width="52" />
                                                        <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoTemplateText}"
                                                                 Watermark="选填（TemplateName）" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="滤镜名" FontSize="12"
                                                                   VerticalAlignment="Center" Width="52" />
                                                        <TextBox Grid.Column="1" Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoFilterText}"
                                                                 Watermark="选填（FilterName）" />
                                                    </Grid>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="商品（原始 JSON 数组）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoCommodityJson}"
                                                                 Watermark='[{"…":"…"}]；留空 = []' />
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="懂车帝视频结构（原始 JSON 对象）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoCompassJson}"
                                                                 Watermark='留空 = {"CompassVideoId":"",…}' />
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="lbl" Text="长尾属性 / 埋点（原始 JSON 对象）" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoAttrsJson}"
                                                                 Watermark="AttrsValueMap，留空 = {}" />
                                                        <TextBox Theme="{StaticResource AppInputTheme}"
                                                                 Text="{Binding ToutiaoEtDataJson}"
                                                                 Watermark="etData，留空 = {}" />
                                                    </StackPanel>

                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 横版 / 竖版按视频宽高自动判定；竖版没有简介、定时与视频合集，合集只在横版生效" />
                                                    <TextBlock Classes="hint" TextWrapping="Wrap"
                                                               Text="· 封面必填：没选就自动抽首帧；作品声明提交字段名未确认，v1 不会发送" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Stretch">
                    <Button Classes="ghost" Content="全部选中" HorizontalAlignment="Left" />
                    <Button Classes="ghost" Content="全部取消" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图三：发布预设 ═══
        ════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowPresets}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,0,6,0">
                <!-- 空态：预设是按账号存的，没账号就一行都没有 —— 得说清楚为什么是白页 -->
                <Border Background="#F7F8FA" CornerRadius="12" Padding="20,16"
                        IsVisible="{Binding !PresetRows.Count}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="还没有可配置的账号" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="发布预设是「每个平台账号一套默认值」。先去「平台账号」页登录至少一个账号，回来这里就能配置；配好之后，导入的条目会自动套用，不必每条都填位置 / 合集 / 话题 / 声明 / 可见性。" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding PresetRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetRowViewModel">
                            <Border Classes="mock-card" Padding="16,14" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Classes="pf-badge" Width="20" Height="20"
                                            Background="{Binding BrandHex}">
                                        <TextBlock Text="{Binding Initial}" FontSize="10"
                                                   FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding PlatformName}" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SummaryText}" Classes="hint"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="sec" Content="编辑"
                                            Height="30" FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).EditPresetCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="字段总数没变，但编辑负担从「50 × 20」变成「配置一次 + 3 × 20」—— 同一账号总是挂同一个合集、同一个位置、同一组话题。" />
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 视图四：账号排序 ═══
        ════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowOrder}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="0" Margin="0,0,6,0">
                <!-- 空态：顺序是按账号排的，没账号就没得排 -->
                <Border Background="#F7F8FA" CornerRadius="12" Padding="20,16"
                        IsVisible="{Binding !HasAccounts}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="还没有可排序的账号" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="先去「平台账号」页登录至少一个账号，回来这里就能排；排好之后，工作台的「发布到」、账号坞标签条、平台账号页都会按这个顺序显示。" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding OrderRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountOrderRowViewModel">
                            <StackPanel>
                                <!-- 组头：只画在**每组首行**上方（扁平列表 + 首行带组头，
                                     不用嵌套 ItemsControl —— 嵌套会让 $parent[ItemsControl]
                                     命中内层，下面所有命令绑定都会错位） -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                      Margin="0,12,0,8" IsVisible="{Binding IsGroupFirst}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4"
                                                Background="{Binding BrandHex}" />
                                        <TextBlock Text="{Binding PlatformName}" FontSize="13.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="icon-btn" IsEnabled="{Binding !IsFirstGroup}"
                                                ToolTip.Tip="整组上移（带上该平台的全部账号）"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveGroupUpCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,18.41L12,13.83L16.59,18.41L18,17L12,11L6,17L7.41,18.41M7.41,12.41L12,7.83L16.59,12.41L18,11L12,5L6,11L7.41,12.41Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                        <Button Classes="icon-btn" IsEnabled="{Binding !IsLastGroup}"
                                                ToolTip.Tip="整组下移（带上该平台的全部账号）"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveGroupDownCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,5.59L12,10.17L16.59,5.59L18,7L12,13L6,7L7.41,5.59M7.41,11.59L12,16.17L16.59,11.59L18,13L12,19L6,13L7.41,11.59Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Classes="mock-card" Padding="12,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                          ColumnSpacing="10">
                                        <Border Classes="pf-badge" Width="18" Height="18"
                                                Background="{Binding BrandHex}">
                                            <TextBlock Text="{Binding Initial}" FontSize="9"
                                                       FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Classes="pill"
                                                    Background="{StaticResource BrandSoft}"
                                                    IsVisible="{Binding ShowPrimary}">
                                                <TextBlock Classes="pill-text" Text="主号"
                                                           Foreground="{StaticResource BrandActive}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="icon-btn"
                                                IsEnabled="{Binding !IsGroupFirst}"
                                                ToolTip.Tip="同平台内上移"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveAccountUpCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                        <Button Grid.Column="4" Classes="icon-btn"
                                                IsEnabled="{Binding !IsLastInGroup}"
                                                ToolTip.Tip="同平台内下移"
                                                Command="{Binding $parent[ItemsControl].((vm:PublishViewModel)DataContext).MoveAccountDownCommand}"
                                                CommandParameter="{Binding}">
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" Margin="0,4,0,10" TextWrapping="Wrap"
                           IsVisible="{Binding HasAccounts}"
                           Text="顺序只是显示偏好，改它不会动到任何已配置的内容（合集 / 位置 / 话题 / 可见性都按账号记，与次序无关）。新登录的账号会自动落进所属平台那一组，不会把分组打散。" />
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════════════════
        ═══ 常驻底栏（提交后不跳页；编辑器态显示保存） ═══
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" BorderBrush="{StaticResource LineBorder}" BorderThickness="0,1,0,0"
                Padding="0,12,0,0" Margin="0,14,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{Binding FooterText}" FontSize="12.5" FontWeight="SemiBold"
                               IsVisible="{Binding ShowWorkbench}" />
                    <TextBlock Text="{Binding StatusText}" Classes="hint"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding SubmitProgress}" Maximum="100" Height="4"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding SubmitMessage}" FontSize="12"
                               Foreground="{StaticResource BrandActive}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="sec" Content="恢复账号默认" Height="34" FontSize="12"
                            IsVisible="{Binding ShowEditor}"
                            Command="{Binding ResetToAccountDefaultsCommand}" />
                    <Button Classes="sec" Content="保存" Height="34" FontSize="12"
                            IsVisible="{Binding ShowEditor}"
                            Command="{Binding SaveEditorCommand}" />
                    <Button Classes="cta" Content="提交到队列" Height="38" Padding="24,0"
                            IsVisible="{Binding ShowWorkbench}"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding SubmitCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
