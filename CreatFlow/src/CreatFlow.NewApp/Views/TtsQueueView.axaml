<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="CreatFlow.NewApp.Views.TtsQueueView"
             x:DataType="vm:TtsQueueViewModel">

    <!-- 配音队列页：配音页「批量配音」提交的任务在这里本机并行合成（不依赖服务端）；
         关掉再开续跑、合成中标已中断可重试、队列可暂停/继续（暂停态进存档）、勾选批量删除。 -->

    <UserControl.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24,20" />
        </Style>
        <Style Selector="TextBlock.sec">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="White">
        <!-- 立柱宽度要定死：Center 时列宽 = 内容自然宽；Stretch + MaxWidth 由布局钳成 min(920, 可视宽-80) -->
        <StackPanel Margin="40,32,40,40" MaxWidth="920"
                    HorizontalAlignment="Stretch" Spacing="18">

            <!-- ═══ 页头 ═══ -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{Binding HeaderIcon, Converter={StaticResource IconPath}}"
                              Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="配音队列" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding HeaderHint}"
                               FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>

            <!-- ═══ 队列控制 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="sec" Text="队列" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="{Binding PauseButtonText}" Height="28" FontSize="12"
                                    IsVisible="{Binding HasTasks}"
                                    ToolTip.Tip="暂停：正在合成的跑完就停，不再领取新任务；暂停态会记住（关掉重开不自动跑）"
                                    Command="{Binding TogglePauseCommand}" />
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="删除选中" Height="28" FontSize="12"
                                    IsVisible="{Binding HasTasks}"
                                    ToolTip.Tip="勾选任务后批量删除（排队中的先取消再删；正在合成的删不了）"
                                    Command="{Binding DeleteSelectedCommand}" />
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="清空已完成" Height="28" FontSize="12"
                                    IsVisible="{Binding HasTasks}"
                                    Command="{Binding ClearFinishedCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid IsVisible="{Binding HasStatusNote}">
                        <Border Background="{StaticResource BgError}" CornerRadius="10"
                                Padding="12,9" IsVisible="{Binding IsStatusError}">
                            <TextBlock Text="{Binding StatusNote}" FontSize="12"
                                       Foreground="{StaticResource ColorError}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{StaticResource BgSuccess}" CornerRadius="10"
                                Padding="12,9" IsVisible="{Binding !IsStatusError}">
                            <TextBlock Text="{Binding StatusNote}" FontSize="12"
                                       Foreground="{StaticResource ColorSuccess}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ 任务列表 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <CheckBox IsChecked="{Binding AllSelected, Mode=TwoWay}" FontSize="12"
                              Content="全选" IsVisible="{Binding HasTasks}" />

                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="队列为空 —— 到「配音」页添加配音条目后点「开始批量合成」"
                               IsVisible="{Binding IsEmpty}" />

                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TtsTask">
                                <Border BorderBrush="{StaticResource LineBorder}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                <Border Background="{StaticResource BgSubtle}"
                                                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondary}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="hint" Text="{Binding VoiceSummary}" />
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" MaxWidth="560"
                                                       HorizontalAlignment="Left"
                                                       IsVisible="{Binding HasMessage}" />
                                            <ProgressBar IsIndeterminate="True" Height="3"
                                                         IsVisible="{Binding IsRunning}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="取消"
                                                    Height="28" FontSize="12" IsVisible="{Binding CanCancel}"
                                                    Command="{Binding $parent[ItemsControl].((vm:TtsQueueViewModel)DataContext).CancelTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="重试"
                                                    Height="28" FontSize="12" IsVisible="{Binding CanRetry}"
                                                    Command="{Binding $parent[ItemsControl].((vm:TtsQueueViewModel)DataContext).RetryTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="移除"
                                                    Height="28" FontSize="12" IsVisible="{Binding CanRemove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:TtsQueueViewModel)DataContext).RemoveTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="播放"
                                                    Height="28" FontSize="12" IsVisible="{Binding HasOutput}"
                                                    Command="{Binding $parent[ItemsControl].((vm:TtsQueueViewModel)DataContext).PlayTaskCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="打开文件夹"
                                                    Height="28" FontSize="12" IsVisible="{Binding HasOutput}"
                                                    Command="{Binding $parent[ItemsControl].((vm:TtsQueueViewModel)DataContext).OpenTaskFolderCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
