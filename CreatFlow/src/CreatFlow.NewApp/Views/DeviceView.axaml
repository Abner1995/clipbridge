<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="CreatFlow.NewApp.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">

    <!-- 无 Design.DataContext：DeviceViewModel 为 DI 注入 + INavigationAware 进入刷新 -->

    <ScrollViewer Background="White">
        <StackPanel Margin="40,32,40,40" Spacing="18">

            <!-- ═══ 页头：图标 + 标题 + 刷新 ═══ -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                    <!-- Viewbox 才能把墨迹居中（Avalonia Path 在 Stretch 下是左上对齐，见 App.axaml ⚠️）；
                         图标框 20 而非 21：42-20 为偶数，四边整数留白 -->
                    <Viewbox Width="20" Height="20" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{Binding HeaderIcon, Converter={StaticResource IconPath}}"
                              Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="设备管理" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="管理已登录本账号的设备，可踢出不常用的设备"
                               FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="flat-icon" Cursor="Hand"
                        VerticalAlignment="Center"
                        Command="{Binding LoadDevicesCommand}"
                        ToolTip.Tip="刷新列表">
                    <Viewbox Width="19" Height="19" Stretch="Uniform">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Stretch="Uniform" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- 加载中 -->
            <ProgressBar IsIndeterminate="True" Height="4"
                         IsVisible="{Binding IsLoading}" />

            <!-- ═══ 错误 / 成功提示 ═══ -->
            <Border Background="{StaticResource BgError}" CornerRadius="10"
                    Padding="14,10" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding Error}" FontSize="13"
                           Foreground="{StaticResource ColorError}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource BgSuccess}" CornerRadius="10"
                    Padding="14,10" IsVisible="{Binding HasSuccess}">
                <TextBlock Text="{Binding Success}" FontSize="13"
                           Foreground="{StaticResource ColorSuccess}" TextWrapping="Wrap" />
            </Border>

            <!-- ═══ 设备列表 ═══ -->
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                        <Border Background="#FAFBFC"
                                BorderBrush="{StaticResource LineBorder}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="18,14" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="5">
                                    <!-- 名称 + 徽章 -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DeviceName}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource BrandSoft}"
                                                CornerRadius="6" Padding="7,2"
                                                IsVisible="{Binding IsCurrentDevice}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="当前设备" FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrandActive}" />
                                        </Border>
                                        <Border Background="{StaticResource BgError}"
                                                CornerRadius="6" Padding="7,2"
                                                IsVisible="{Binding IsKicked}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="已踢出" FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource ColorError}" />
                                        </Border>
                                    </StackPanel>
                                    <!-- 系统信息 -->
                                    <TextBlock Text="{Binding InfoText}" FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- 最近登录 -->
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextPlaceholder}">
                                            <Run Text="最近登录  " /><Run Text="{Binding LastLoginText}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextPlaceholder}"
                                                   IsVisible="{Binding IsKicked}">
                                            <Run Text="登录次数/状态异常可联系管理员" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 踢出 -->
                                <Button Grid.Column="1" Theme="{StaticResource DangerButtonTheme}"
                                        Content="踢出"
                                        Command="{Binding $parent[ItemsControl].((vm:DeviceViewModel)DataContext).KickDeviceCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding CanKick}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ 空态 ═══ -->
            <Border Background="{StaticResource BgSubtle}" CornerRadius="12"
                    Padding="40,34" IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="暂无登录设备" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="登录一次本客户端后，设备会出现在这里"
                               FontSize="12" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
