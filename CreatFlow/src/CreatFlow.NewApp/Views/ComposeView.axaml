<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="using:Material.Icons"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             xmlns:services="using:CreatFlow.NewApp.Services"
             xmlns:video="using:CreatFlow.Media.Video"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="CreatFlow.NewApp.Views.ComposeView"
             x:DataType="vm:ComposeViewModel">

    <!-- 合成视频页：素材（图/视频混排）→ 配音（Kokoro + 试听）→ 合成 → 落发布单元。
         配音控件来自被砍的独立配音页（2026-10-10 决策：用户群无「只要 mp3」场景，控件内联到本页）。 -->

    <UserControl.Resources>
        <!-- 自绘单选行外壳（发布页 / AI 设置页同款；不套模板 Semi 的 :checked 会画蓝色勾选框） -->
        <ControlTemplate x:Key="RowTemplate" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <!-- 素底按钮模板（分组组条用；与 PublishView.PlainButtonTemplate 同款） -->
        <ControlTemplate x:Key="PlainButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                <ContentPresenter Name="PlainButtonContent"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
        </ControlTemplate>

        <!-- 滑块（语速/BGM 音量）用 App 级 AppSliderTheme（App.axaml）：
             2026-10-10 配音页第二次用到 → 上提单源；两条坑（Track 逐项 TemplateBinding、
             两侧 RepeatButton 显式 Stretch）见那里的注释。 -->
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24,20" />
        </Style>
        <Style Selector="TextBlock.sec">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ─── 自动发布账号芯片（与 PublishView.axaml 的 ToggleButton.chip 同款，改一处要同步另一处）─── -->
        <Style Selector="ToggleButton.chip">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked)">
            <Setter Property="Background" Value="#F7F8FA" />
        </Style>
        <Style Selector="ToggleButton.chip:checked">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
        </Style>
        <Style Selector="ToggleButton.chip:pointerover">
            <Setter Property="Background" Value="#EFF1F4" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="ToggleButton.chip:checked TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) Path.chip-check">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ToggleButton.chip:not(:checked) Border.chip-dot">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- ─── 分组组条（2026-10-14：点一格 = 只勾选该组账号；与 PublishView 同款，改一处同步另一处） ─── -->
        <Style Selector="Button.group-chip">
            <Setter Property="Template" Value="{StaticResource PlainButtonTemplate}" />
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.group-chip:pointerover">
            <Setter Property="Background" Value="#EFF1F4" />
        </Style>
        <Style Selector="Button.group-chip.active">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="Foreground" Value="{StaticResource BrandActive}" />
        </Style>
        <Style Selector="Button.group-chip.active:pointerover">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
        </Style>
        <Style Selector="Button.group-chip:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- 自绘单选圈（发布页 / AI 设置页同款） -->
        <Style Selector="ToggleButton.radio-row">
            <Setter Property="Template" Value="{StaticResource RowTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <!-- 不钉住 Foreground，选中项文字会被 Semi 刷成白色而看不见 -->
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.radio-row:checked">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="ToggleButton.radio-row:pointerover">
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Border.radio">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.radio-row:not(:checked) Border.radio">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9CDD4" />
        </Style>
        <Style Selector="ToggleButton.radio-row:checked Border.radio">
            <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
        </Style>
        <Style Selector="ToggleButton.radio-row:not(:checked) Border.radio-core">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- 素材行小图标按钮（透明底，悬停由 Semi 默认态给） -->
        <Style Selector="Button.row-act">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="White">
        <!-- 立柱宽度要定死：Center 时列宽 = 内容自然宽（文案框/素材行一变整列就变宽）；
             Stretch + MaxWidth 由布局钳成 min(920, 可视宽-80) 并在 MaxWidth 处居中（2026-10-10 修） -->
        <StackPanel Margin="40,32,40,40" MaxWidth="920"
                    HorizontalAlignment="Stretch" Spacing="18">

            <!-- ═══ 页头 ═══ -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{Binding HeaderIcon, Converter={StaticResource IconPath}}"
                              Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="合成视频" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="图片轮播 + 配音 + 字幕 → 竖屏短视频；产物直接落成发布单元，发布页可直接导入"
                               FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>

            <!-- ═══ 素材 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="sec" Text="素材" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ItemsSummary}"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Grid.Column="2" Theme="{StaticResource SecondaryButtonTheme}"
                                Content="添加素材" Height="30" FontSize="12.5"
                                ToolTip.Tip="图片 / 视频可多选，顺序即播放顺序"
                                Command="{Binding PickMediaCommand}" />
                    </Grid>

                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="视频素材建议使用无字幕版本（硬字幕无法剥离，截取后时间轴会错位）" />

                    <CheckBox Content="AI 分镜（一句 = 一个素材：逐镜配音，图片镜随句长伸缩、视频完整展示）"
                              IsChecked="{Binding UseShots}" FontSize="12.5"
                              Foreground="{StaticResource TextSecondary}" />

                    <TextBlock Classes="hint" Text="还没有素材 —— 点右上角「添加素材」"
                               IsVisible="{Binding !HasItems}" />

                    <ListBox ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}"
                             MaxHeight="220" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="video:ComposeMediaItem">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                                    <Border Background="{StaticResource BgSubtle}" CornerRadius="4"
                                            Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindText}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Classes="row-act" ToolTip.Tip="上移"
                                            Command="{Binding $parent[ItemsControl].((vm:ComposeViewModel)DataContext).MoveItemUpCommand}"
                                            CommandParameter="{Binding}">
                                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ArrowUpward}, Converter={StaticResource IconPath}}"
                                                  Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="3" Classes="row-act" ToolTip.Tip="下移"
                                            Command="{Binding $parent[ItemsControl].((vm:ComposeViewModel)DataContext).MoveItemDownCommand}"
                                            CommandParameter="{Binding}">
                                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ArrowDownward}, Converter={StaticResource IconPath}}"
                                                  Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="4" Classes="row-act" ToolTip.Tip="移除"
                                            Command="{Binding $parent[ItemsControl].((vm:ComposeViewModel)DataContext).RemoveItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Viewbox Width="13" Height="13" Stretch="Uniform">
                                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Close}, Converter={StaticResource IconPath}}"
                                                  Fill="{StaticResource ColorError}" Stretch="Uniform" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ═══ 配音 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sec" Text="配音" />

                    <!-- 配音来源 -->
                    <ItemsControl ItemsSource="{Binding AudioSources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComposeChoice">
                                <ToggleButton Classes="radio-row" Padding="6,4" Margin="0,0,18,4"
                                              IsChecked="{Binding IsSelected}"
                                              Command="{Binding $parent[ItemsControl].((vm:ComposeViewModel)DataContext).SelectSourceCommand}"
                                              CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Classes="radio">
                                            <Border Classes="radio-core" Width="8" Height="8"
                                                    CornerRadius="4" Background="White"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" />
                                            <TextBlock Classes="hint" Text="{Binding Note}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 文案 + 角色库（2026-10-11 批次 4）：角色下拉 + AI 优化 + 最终文案预览。
                         角色下拉走 SelectedIndex 代理（列表会重建，SelectedItem 推送有已知坑） -->
                    <StackPanel Spacing="6" IsVisible="{Binding UseTextAudio}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Classes="lbl" Text="文案（开了「AI 分镜」时一行一句，句数 = 素材数）"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2" HorizontalAlignment="Left" MinWidth="180"
                                      ItemsSource="{Binding Roles}"
                                      SelectedIndex="{Binding SelectedRoleIndex}"
                                      ToolTip.Tip="角色库：台词模板会套在你的文案上；到「管理角色」里添加/编辑">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:ComposeRole">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <Button Theme="{StaticResource SecondaryButtonTheme}"
                                        Content="{Binding OptimizeButtonText}" Height="30" FontSize="12.5"
                                        ToolTip.Tip="按所选角色的「人设提示词」改写文案：结果先预览、点「应用」才替换上面的文案；优化中再点 = 取消"
                                        Command="{Binding OptimizeTextCommand}" />
                                <Button Theme="{StaticResource SecondaryButtonTheme}" Content="管理角色"
                                        Height="30" FontSize="12.5"
                                        ToolTip.Tip="到「AI 设置 → 角色库」添加 / 编辑角色"
                                        Command="{Binding GoRoleLibraryCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBox Text="{Binding Text}" Theme="{StaticResource AppInputTheme}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="96" MaxHeight="170" Padding="10,6"
                                 VerticalContentAlignment="Top" FontSize="13"
                                 Watermark="输入要配音的文案…" />

                        <!-- 优化结果（原文未改动；点「应用」才替换上面的文案） -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasOptimizeResult}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10"
                                  IsVisible="{Binding !IsOptimizing}">
                                <TextBlock Classes="lbl" Text="{Binding OptimizeResultTitle}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Theme="{StaticResource CtaButtonTheme}" Content="应用"
                                        Height="30" FontSize="12.5"
                                        Command="{Binding ApplyOptimizeResultCommand}" />
                                <Button Grid.Column="3" Theme="{StaticResource SecondaryButtonTheme}" Content="放弃"
                                        Height="30" FontSize="12.5"
                                        Command="{Binding DiscardOptimizeResultCommand}" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsOptimizing}" />
                            <TextBox Text="{Binding OptimizeResult}" Theme="{StaticResource AppInputTheme}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" MaxHeight="140" Padding="10,6"
                                     VerticalContentAlignment="Top" FontSize="13"
                                     IsVisible="{Binding !IsOptimizing}" />
                        </StackPanel>

                        <Grid IsVisible="{Binding HasOptimizeMessage}">
                            <Border Background="{StaticResource BgError}" CornerRadius="10" Padding="12,9"
                                    IsVisible="{Binding IsOptimizeError}">
                                <TextBlock Text="{Binding OptimizeMessage}" FontSize="12"
                                           Foreground="{StaticResource ColorError}" TextWrapping="Wrap" />
                            </Border>
                            <Border Background="{StaticResource BgSuccess}" CornerRadius="10" Padding="12,9"
                                    IsVisible="{Binding !IsOptimizeError}">
                                <TextBlock Text="{Binding OptimizeMessage}" FontSize="12"
                                           Foreground="{StaticResource ColorSuccess}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <!-- 最终文案（配音 + 字幕的真实文本；套模板后） -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasRoleWrap}">
                            <TextBlock Classes="lbl" Text="最终文案（配音 + 字幕）" />
                            <TextBox Text="{Binding FinalText}" Theme="{StaticResource AppInputTheme}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" MaxHeight="120" Padding="10,6"
                                     VerticalContentAlignment="Top" FontSize="13" />
                            <TextBlock Classes="hint" Text="{Binding FinalTextHint}" TextWrapping="Wrap" />
                            <CheckBox Content="查看 AI 优化提示词" FontSize="12"
                                      IsVisible="{Binding CanShowPromptPreview}"
                                      IsChecked="{Binding ShowPromptPreview}" />
                            <TextBox IsVisible="{Binding ShowPromptPreview}" Text="{Binding PromptPreviewText}"
                                     Theme="{StaticResource AppInputTheme}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" MaxHeight="140" Padding="10,6"
                                     VerticalContentAlignment="Top" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 本地音频 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UseLocalAudio}">
                        <TextBox Text="{Binding LocalAudioPath}" Theme="{StaticResource AppInputTheme}"
                                 IsReadOnly="True" FontSize="12.5" Height="34"
                                 Watermark="选择本地音频文件（mp3 / wav / m4a）" />
                        <Button Theme="{StaticResource SecondaryButtonTheme}" Content="选择…"
                                Height="34" Command="{Binding PickLocalAudioCommand}" />
                    </StackPanel>

                    <!-- 引擎 -->
                    <StackPanel Spacing="6" IsVisible="{Binding UseTextAudio}">
                        <TextBlock Classes="lbl" Text="配音引擎" />
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComposeEngineOption">
                                    <ToggleButton Classes="radio-row" Padding="6,4" Margin="0,0,18,4"
                                                  IsChecked="{Binding IsSelected}"
                                                  Command="{Binding $parent[ItemsControl].((vm:ComposeViewModel)DataContext).SelectEngineCommand}"
                                                  CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="radio">
                                                <Border Classes="radio-core" Width="8" Height="8"
                                                        CornerRadius="4" Background="White"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" />
                                                <TextBlock Classes="hint" Text="{Binding Note}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 音色 / 语速 / 试听（音调控件随 Edge 下架移除：Kokoro 不支持音调） -->
                    <StackPanel Spacing="10" IsVisible="{Binding UseTextAudio}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Classes="lbl" Text="音色" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="260"
                                      ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:TtsVoiceOption">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12.5" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Classes="lbl" Text="语速" />
                            <Slider Grid.Column="1" Theme="{StaticResource AppSliderTheme}"
                                    Minimum="0.5" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding Speed}" />
                            <TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat='{}{0:0.00}x'}"
                                       FontSize="12" Width="44" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="{Binding PreviewButtonText}" Height="30" FontSize="12.5"
                                    ToolTip.Tip="用当前引擎/音色/语速试听文案第一句"
                                    Command="{Binding PreviewCommand}" />
                            <TextBlock Text="{Binding PreviewHint}" Classes="hint"
                                       VerticalAlignment="Center" IsVisible="{Binding HasPreviewHint}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 画面与声音 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sec" Text="画面与声音" />

                    <StackPanel Spacing="6">
                        <TextBlock Classes="lbl" Text="画幅" />
                        <ItemsControl ItemsSource="{Binding Aspects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComposeChoice">
                                    <ToggleButton Classes="radio-row" Padding="6,4" Margin="0,0,18,4"
                                                  IsChecked="{Binding IsSelected}"
                                                  Command="{Binding $parent[ItemsControl].((vm:ComposeViewModel)DataContext).SelectAspectCommand}"
                                                  CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="radio">
                                                <Border Classes="radio-core" Width="8" Height="8"
                                                        CornerRadius="4" Background="White"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" />
                                                <TextBlock Classes="hint" Text="{Binding Note}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="lbl" Text="画面叠加标题（可选）" />
                        <TextBox Text="{Binding OverlayTitle}" Theme="{StaticResource AppInputTheme}"
                                 Height="34" FontSize="13"
                                 Watermark="如：城东精品三居 · 精装交付（视频前 3 秒大字显示）" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="lbl" Text="背景音乐（可选，自动循环 + 尾部淡出）" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="选择…"
                                    Command="{Binding PickBgmCommand}" />
                            <Button Theme="{StaticResource DangerButtonTheme}" Content="清除"
                                    IsVisible="{Binding HasBgm}" Command="{Binding ClearBgmCommand}" />
                            <TextBlock Text="{Binding BgmPath}" Classes="hint"
                                       VerticalAlignment="Center" MaxWidth="380"
                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding HasBgm}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasBgm}">
                            <TextBlock Classes="lbl" Text="BGM 音量" />
                            <Slider Grid.Column="1" Theme="{StaticResource AppSliderTheme}"
                                    Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding BgmVolume}" />
                            <TextBlock Grid.Column="2" Text="{Binding BgmVolume, StringFormat='{}{0:0.00}'}"
                                       FontSize="12" Width="44" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="视频水印在「账号设置」页配置（默认开启，封面不带水印）。" />
                </StackPanel>
            </Border>

            <!-- ═══ 输出与发布 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sec" Text="输出与发布" />

                    <StackPanel Spacing="6">
                        <TextBlock Classes="lbl" Text="发布标题" />
                        <TextBox Text="{Binding PublishTitle}" Theme="{StaticResource AppInputTheme}"
                                 Height="34" FontSize="13"
                                 Watermark="如：大华岚翠 89 平三居（同时作为发布单元文件夹名）" />
                        <TextBlock Classes="hint" TextWrapping="Wrap"
                                   Text="产物落成发布单元：输出目录 / 标题 /（mp4 + params.txt + cover.jpg），发布页「导入文件夹」可直接识别" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="lbl" Text="输出目录" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding OutputDirectory}" Theme="{StaticResource AppInputTheme}"
                                     IsReadOnly="True" FontSize="12.5" Height="34" />
                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="选择…"
                                    Height="34" Command="{Binding PickOutputFolderCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <CheckBox Content="定时发布（写入发布单元的「发布时间」；不勾 = 立即发布）"
                                  IsChecked="{Binding IsScheduled}" FontSize="12.5"
                                  Foreground="{StaticResource TextSecondary}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsScheduled}">
                            <DatePicker Theme="{StaticResource AppDatePickerTheme}"
                                        SelectedDate="{Binding ScheduledDate}" />
                            <TimePicker Theme="{StaticResource AppTimePickerTheme}"
                                        SelectedTime="{Binding ScheduledTime}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 合成完成后自动发布（2026-10-11 用户拍板）：账号芯片与发布页同款、共享「上次勾选」 -->
                    <StackPanel Spacing="8">
                        <CheckBox Content="合成完成后自动发布（提交进「上传队列」；标题与定时用本页，其余参数跟随发布单元 / 账号预设）"
                                  IsChecked="{Binding AutoPublish}" FontSize="12.5"
                                  Foreground="{StaticResource TextSecondary}" />

                        <TextBlock TextWrapping="Wrap"
                                   Text="还没有绑定任何平台账号 —— 到「平台账号」页登录一个，再回来开自动发布"
                                   FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                   IsVisible="{Binding !HasTargetChips}" />

                        <!-- 分组组条（2026-10-14）：点一格 = 只勾选该格账号（替换式，芯片仍全部可见、
                             可再手动微调）；「全部」是第 0 格哨兵。没有分组时整条不出现。 -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding HasGroupChoices}">
                            <TextBlock Text="分组" FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding GroupChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountGroupChoiceViewModel">
                                        <Button Classes="group-chip" Margin="0,0,6,4"
                                                Classes.active="{Binding IsActive}"
                                                IsEnabled="{Binding !IsEmpty}"
                                                Content="{Binding Text}"
                                                Command="{Binding $parent[UserControl].((vm:ComposeViewModel)DataContext).ApplyTargetGroupCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TargetChips}" IsVisible="{Binding HasTargetChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountChipViewModel">
                                    <ToggleButton Classes="chip" IsChecked="{Binding IsOn}"
                                                  IsEnabled="{Binding CanPublish}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Classes="chip-dot" Width="8" Height="8"
                                                    CornerRadius="4"
                                                    Background="{Binding BrandHex}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PlatformName}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AccountLabel}" FontSize="11"
                                                       Foreground="{StaticResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#F2F3F5" CornerRadius="4" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowUnsupported}">
                                                <TextBlock Text="未接入" FontSize="9.5"
                                                           Foreground="#86909C" />
                                            </Border>
                                            <Border Width="6" Height="6" CornerRadius="3"
                                                    Background="#FA8C16" VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowExpired}"
                                                    ToolTip.Tip="登录已过期，需重新登录" />
                                            <Viewbox Width="11" Height="11" Stretch="Uniform"
                                                     VerticalAlignment="Center">
                                                <Path Classes="chip-check"
                                                      Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                                                      Fill="{StaticResource BrandPrimary}"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                       Text="{Binding AutoPublishSummary}"
                                       Foreground="{StaticResource TextSecondary}"
                                       IsVisible="{Binding !IsAutoPublishSummaryError}" />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                       Text="{Binding AutoPublishSummary}"
                                       Foreground="{StaticResource ColorError}"
                                       IsVisible="{Binding IsAutoPublishSummaryError}" />
                        </Grid>
                    </StackPanel>

                    <Grid IsVisible="{Binding HasStatus}">
                        <Border Background="{StaticResource BgError}" CornerRadius="10"
                                Padding="12,9" IsVisible="{Binding IsStatusError}">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource ColorError}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{StaticResource BgSuccess}" CornerRadius="10"
                                Padding="12,9" IsVisible="{Binding !IsStatusError}">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{StaticResource ColorSuccess}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Theme="{StaticResource CtaButtonTheme}" Content="开始合成"
                                FontSize="14" Height="38" Padding="28,0"
                                Command="{Binding ComposeCommand}" />
                        <Button Theme="{StaticResource SecondaryButtonTheme}" Content="查看合成队列"
                                Height="38"
                                ToolTip.Tip="到「合成队列」看排队 / 进度 / 结果（关掉本页合成也会继续跑）"
                                Command="{Binding GoQueueCommand}" />
                        <Button Theme="{StaticResource SecondaryButtonTheme}" Content="清空参数"
                                Height="38" HorizontalAlignment="Right"
                                ToolTip.Tip="清空文案 / 素材 / BGM / 标题等本次参数（保留画幅与输出目录）"
                                Command="{Binding ClearAllCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
