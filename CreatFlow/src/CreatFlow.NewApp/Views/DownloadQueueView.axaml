<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="CreatFlow.NewApp.Views.DownloadQueueView"
             x:DataType="vm:DownloadQueueViewModel">

    <!-- 视频下载页：粘贴链接 → 批量解析预览 → 勾选入队 → 本机并发下载。
         路径模板实时预览；关掉重开续跑；失败按错误分类自动重试 / 重新解析。 -->

    <UserControl.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="24,20" />
        </Style>
        <Style Selector="TextBlock.sec">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="White">
        <StackPanel Margin="40,32,40,40" MaxWidth="920"
                    HorizontalAlignment="Stretch" Spacing="18">

            <!-- ═══ 页头 ═══ -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{Binding HeaderIcon, Converter={StaticResource IconPath}}"
                              Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="视频下载" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding HeaderHint}"
                               FontSize="12" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>

            <!-- ═══ 输入 / 路径 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="sec" Text="批量下载" />
                    <!-- 输入框必须显式套 AppInputTheme：不套 = 走 Semi 默认主题，
                         文字会变浅灰（2026-10-21 用户实测「文本框里的字不对」）；
                         多行框还要 Top 对齐，否则占位/正文在 110 高的框里垂直居中 -->
                    <TextBox Text="{Binding InputText, Mode=TwoWay}"
                             Theme="{StaticResource AppInputTheme}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="110" Padding="10,8"
                             VerticalContentAlignment="Top" FontSize="12"
                             Watermark="每行一个链接，或直接粘贴抖音 / 快手 / 小红书分享文案…" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding RootDirectory, Mode=TwoWay}"
                                 Theme="{StaticResource AppInputTheme}"
                                 FontSize="12" Watermark="下载目录（绝对路径）" />
                        <Button Grid.Column="1" Theme="{StaticResource SecondaryButtonTheme}"
                                Content="选择文件夹" Height="30" FontSize="12"
                                Command="{Binding BrowseFolderCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,220" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding PathTemplate, Mode=TwoWay}"
                                 Theme="{StaticResource AppInputTheme}"
                                 FontSize="12"
                                 Watermark="路径模板：{platform}\{author}\{title} [{id}].{ext}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Strategies}"
                                  SelectedIndex="{Binding StrategyIndex, Mode=TwoWay}"
                                  FontSize="12" HorizontalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Classes="hint" Text="{Binding PathPreview}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Classes="cta" Content="解析链接"
                                Height="32" FontSize="12" Command="{Binding ParseCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                ToolTip.Tip="只解析、不下载：先看标题 / 作者 / 大小，勾选后再入队" />
                        <Button Grid.Column="1" Theme="{StaticResource SecondaryButtonTheme}"
                                Content="开始下载" Height="32" FontSize="12"
                                Command="{Binding StartCommand}" />
                        <Button Grid.Column="2" Theme="{StaticResource SecondaryButtonTheme}"
                                Content="{Binding PauseButtonText}" Height="32" FontSize="12"
                                Command="{Binding TogglePauseCommand}" IsVisible="{Binding HasTasks}" />
                        <TextBlock Grid.Column="3" Text="{Binding SummaryText}" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid IsVisible="{Binding HasStatusNote}">
                        <Border Background="{StaticResource BgError}" CornerRadius="10"
                                Padding="12,9" IsVisible="{Binding IsStatusError}">
                            <TextBlock Text="{Binding StatusNote}" FontSize="12"
                                       Foreground="{StaticResource ColorError}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{StaticResource BgSuccess}" CornerRadius="10"
                                Padding="12,9" IsVisible="{Binding !IsStatusError}">
                            <TextBlock Text="{Binding StatusNote}" FontSize="12"
                                       Foreground="{StaticResource ColorSuccess}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ 任务列表 ═══ -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <CheckBox Content="全选" IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                  FontSize="12" IsVisible="{Binding HasTasks}" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryText}" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="重试失败" Height="28" FontSize="12"
                                    IsVisible="{Binding HasTasks}"
                                    Command="{Binding RetryFailedCommand}" />
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="删除选中" Height="28" FontSize="12"
                                    IsVisible="{Binding HasTasks}"
                                    Command="{Binding RemoveSelectedCommand}" />
                            <Button Theme="{StaticResource SecondaryButtonTheme}"
                                    Content="清空已完成" Height="28" FontSize="12"
                                    IsVisible="{Binding HasTasks}"
                                    Command="{Binding ClearFinishedCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="列表为空 —— 把链接粘贴到上面的输入框，点「解析链接」先预览"
                               IsVisible="{Binding IsEmpty}" />

                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadTaskRow">
                                <Border BorderBrush="{StaticResource LineBorder}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Top" Margin="0,2,0,0" />

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                                <Border Background="{StaticResource BgSubtle}"
                                                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondary}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Classes="hint" Text="{Binding Subtitle}" />

                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" MaxWidth="560"
                                                       HorizontalAlignment="Left"
                                                       IsVisible="{Binding HasMessage}" />

                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent}" Height="4"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         IsVisible="{Binding IsRunning}" />
                                            <TextBlock Classes="hint" Text="{Binding ProgressText}"
                                                       IsVisible="{Binding IsRunning}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="取消"
                                                    Height="28" FontSize="12" IsVisible="{Binding CanCancel}"
                                                    Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).CancelCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="重试"
                                                    Height="28" FontSize="12" IsVisible="{Binding CanRetry}"
                                                    Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).RetryCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="移除"
                                                    Height="28" FontSize="12" IsVisible="{Binding CanRemove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).RemoveCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="播放"
                                                    Height="28" FontSize="12" IsVisible="{Binding HasOutput}"
                                                    Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).PlayFileCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Theme="{StaticResource SecondaryButtonTheme}" Content="打开位置"
                                                    Height="28" FontSize="12" IsVisible="{Binding HasOutput}"
                                                    Command="{Binding $parent[ItemsControl].((vm:DownloadQueueViewModel)DataContext).OpenFolderCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
