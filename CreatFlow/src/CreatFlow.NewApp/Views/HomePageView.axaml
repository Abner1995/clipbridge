<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ap="using:Avalonia.Controls.Primitives"
             xmlns:vm="using:CreatFlow.NewApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="CreatFlow.NewApp.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">

    <!-- 无 Design.DataContext：HomePageViewModel 为 DI 注入构造
    页面内徽章/入口卡为该页复用样式（触发规则：第二次跨页使用再提取） -->
    <UserControl.Resources>
        <!-- 入口卡外壳（页面私有：本页四张可点卡共用一份；六张卡的图标/文案直接写在卡片里，
             固定六张不值当上 ItemsControl —— 且 DataTemplate 内取不到页面资源，见仓库既有规矩） -->
        <ControlTemplate x:Key="EntryCardTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="{TemplateBinding Padding}"
                    BoxShadow="0 1 2 0 #0D000000, 0 4 12 0 #08000000">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center" />
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#F2F3F5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.badge-text">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#4E5969" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ═══ 入口卡：可点（悬停/按下/禁用由伪类免费拿到） ═══ -->
        <Style Selector="Button.entry">
            <Setter Property="Template" Value="{StaticResource EntryCardTemplate}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EDEFF3" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.entry:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource BrandSoftBorder}" />
        </Style>
        <Style Selector="Button.entry:pressed">
            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}" />
        </Style>
        <!-- 过期会员：与侧栏灰显语义一致（Navigate 本身不拦，卡片自己拦） -->
        <Style Selector="Button.entry:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- 主入口（发布视频）：品牌淡底，悬停加深一档 -->
        <Style Selector="Button.entry.hero">
            <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandSoftBorder}" />
            <Setter Property="Padding" Value="24,20" />
        </Style>
        <Style Selector="Button.entry.hero:pointerover">
            <Setter Property="Background" Value="#ECE7FD" />
        </Style>

        <!-- ═══ 未完工功能的灰卡：不可点、无悬停反应 ═══ -->
        <Style Selector="Border.placeholder-card">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="TextBlock.entry-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.entry-hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="White">
        <StackPanel Margin="40,32,40,40" MaxWidth="880"
                    HorizontalAlignment="Center" Spacing="20">

            <!-- ═══ 时段问候 + 日期 ═══ -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding GreetingText}"
                           FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DateText}"
                           FontSize="13" Foreground="{StaticResource TextMuted}" />
            </StackPanel>

            <!-- ═══ 主入口：发布视频（整卡可点 → 发布页） ═══ -->
            <Button Classes="entry hero"
                    Command="{Binding GoCommand}" CommandParameter="publish"
                    IsEnabled="{Binding !IsExpired}"
                    ToolTip.Tip="去发布页：导入文件夹 / 添加视频 / 提交 4 平台">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="发布视频" FontSize="20" FontWeight="Bold" />
                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="文件夹批量导入：一个文件夹 = 一条视频（文件夹名即标题），params.txt 填参数、cover.jpg 当封面，一次最多 10 条、一键提交 4 平台" />
                    </StackPanel>
                    <!-- 上传箭头（矢量，非 emoji） -->
                    <Border Grid.Column="1" Width="56" Height="56" CornerRadius="28"
                            Background="White" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Viewbox Width="26" Height="26" Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20H19V18H5V20Z"
                                  Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                        </Viewbox>
                    </Border>
                </Grid>
            </Button>

            <!-- ═══ 发布之后：队列 / 撤回 / 档案（三张真入口） ═══ -->
            <StackPanel Spacing="10">
                <TextBlock Classes="row-title" Text="发布之后" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Button Classes="entry"
                            Command="{Binding GoCommand}" CommandParameter="queue"
                            IsEnabled="{Binding !IsExpired}"
                            ToolTip.Tip="上传队列：进度 / 失败重试 / 撤回未发出的">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                                <Viewbox Width="17" Height="17" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M11 20H6.5Q4.22 20 2.61 18.43 1 16.85 1 14.58 1 12.63 2.17 11.1 3.35 9.57 5.25 9.15 5.88 6.85 7.75 5.43 9.63 4 12 4 14.93 4 16.96 6.04 19 8.07 19 11 20.73 11.2 21.86 12.5 23 13.78 23 15.5 23 17.38 21.69 18.69 20.38 20 18.5 20H13V12.85L14.6 14.4L16 13L12 9L8 13L9.4 14.4L11 12.85Z"
                                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="entry-title" Text="上传队列" />
                                <TextBlock Classes="entry-hint"
                                           Text="发布进度与失败重试，提交后在这里跟踪" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Classes="entry"
                            Command="{Binding GoCommand}" CommandParameter="tasks"
                            IsEnabled="{Binding !IsExpired}"
                            ToolTip.Tip="异步任务：批量撤回（把已发布的视频 / 合集从平台上删掉）">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                                <Viewbox Width="17" Height="17" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M19,3H14.82C14.25,1.44 12.53,0.64 11,1.2C10.14,1.5 9.5,2.16 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M17,11H7V9H17V11M15,15H7V13H15V15Z"
                                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="entry-title" Text="异步任务" />
                                <TextBlock Classes="entry-hint"
                                           Text="批量撤回：把视频 / 合集从平台上删掉" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2" Classes="entry"
                            Command="{Binding GoCommand}" CommandParameter="video"
                            IsEnabled="{Binding !IsExpired}"
                            ToolTip.Tip="视频管理：已发布作品档案，可逐平台删除">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                                <Viewbox Width="17" Height="17" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M22 8V13.81C21.12 13.3 20.1 13 19 13C15.69 13 13 15.69 13 19C13 19.34 13.04 19.67 13.09 20H4C2.9 20 2 19.11 2 18V6C2 4.89 2.89 4 4 4H10L12 6H20C21.1 6 22 6.89 22 8M17 22L22 19L17 16V22Z"
                                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="entry-title" Text="视频管理" />
                                <TextBlock Classes="entry-hint"
                                           Text="已发布作品档案，可逐平台删除" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ═══ 创作：配音 / 合成视频 / AI 设置（都已上线，可点）。
                 配音页 2026-10-10 按用户决策恢复（生成 mp3）；合成队列无首页卡，走侧栏 + 徽章。 ═══ -->
            <StackPanel Spacing="10">
                <TextBlock Classes="row-title" Text="创作" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Button Classes="entry"
                            Command="{Binding GoCommand}" CommandParameter="tts"
                            IsEnabled="{Binding !IsExpired}"
                            ToolTip.Tip="配音：文字转语音，生成 mp3 文件（Kokoro 本地离线）">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                                <Viewbox Width="17" Height="17" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="entry-title" Text="配音" />
                                <TextBlock Classes="entry-hint" Text="文字转语音 · 生成 mp3" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="1" Classes="entry"
                            Command="{Binding GoCommand}" CommandParameter="compose"
                            IsEnabled="{Binding !IsExpired}"
                            ToolTip.Tip="合成视频：图片轮播 + 配音字幕 → 发布单元（发布页可直接导入）">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                                <Viewbox Width="17" Height="17" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M15,8V16H5V8H15M16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5V7A1,1 0 0,0 16,6Z"
                                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="entry-title" Text="合成视频" />
                                <TextBlock Classes="entry-hint" Text="图片轮播 + 配音字幕 → 发布单元" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2" Classes="entry"
                            Command="{Binding GoCommand}" CommandParameter="ai"
                            IsEnabled="{Binding !IsExpired}"
                            ToolTip.Tip="AI 设置：本地引擎（零 key 开箱）/ DeepSeek / Qwen 与模型管理">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                                <Viewbox Width="17" Height="17" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M19,1L17.74,3.75L15,5L17.74,6.26L19,9L20.25,6.26L23,5L20.25,3.75M9,4L6.5,9.5L1,12L6.5,14.5L9,20L11.5,14.5L17,12L11.5,9.5M19,15L17.74,17.74L15,19L17.74,20.25L19,23L20.25,20.25L23,19L20.25,17.74"
                                          Fill="{StaticResource BrandPrimary}" Stretch="Uniform" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="entry-title" Text="AI 设置" />
                                <TextBlock Classes="entry-hint" Text="内置本地引擎，零配置开箱" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ═══ 平台账号概览（6 平台；绑定数为服务端会话统计 —— 进页/坞内同步后刷新） ═══ -->
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="平台账号" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding OverviewNote}"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Platforms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ap:UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <!-- 平台小块色值随平台品牌、写实（窗口级资源经元素挂载链仍可达，
                             但此处色值本就按平台不同，无需令牌） -->
                        <DataTemplate x:DataType="vm:PlatformTile">
                            <Border Background="#F7F8FA" BorderBrush="#E4E6E8"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="14,12" Margin="0,0,12,8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{Binding ColorHex}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" FontSize="12"
                                                   FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CountText}" FontSize="11"
                                                   Foreground="#86909C" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══ 会员卡（单机版没有会员体系 → 隐藏） ═══ -->
            <Border Background="{StaticResource BrandSoft}"
                    BorderBrush="{StaticResource BrandSoftBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="20,14"
                    IsVisible="{Binding ShowMembership}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="会员有效期" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding DaysLeftText}" FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrandActive}" />
                            <TextBlock Text="{Binding ExpireDateText}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
