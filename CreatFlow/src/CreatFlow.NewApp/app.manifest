<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows 专用清单：勿删 —— 缺 supportedOS 时 Win32 原生宿主（NativeWebView/WebView2 登录窗）
       无法创建子窗口（InvalidOperationException: Unable to create child window for native control host）。
       自老 App app.manifest 拷贝（双存期同需）。 -->
  <assemblyIdentity version="1.0.0.0" name="CreatFlow.NewApp.Desktop"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10（WebView2 原生宿主要求声明受支持的 OS 列表） -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
